@model CinemaSystem.Models.Entities.Cinema

@{
    ViewData["Title"] = "Delete Cinema";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<main class="flex-1 p-8 flex justify-center items-start">
    
    <div class="w-full max-w-3xl mt-8">
        
        <nav class="flex text-sm text-on-surface-variant mb-6 gap-2 font-label items-center uppercase tracking-wider font-bold">
            <a asp-action="Index" class="hover:text-primary transition-colors">Cinemas</a>
            <span class="material-symbols-outlined text-[16px]">chevron_right</span>
            <span class="text-error font-semibold">Delete Location</span>
        </nav>

        <div class="bg-[#f97386]/10 border border-[#f97386]/30 p-6 rounded-2xl mb-8 flex items-start gap-4 shadow-sm">
            <div class="bg-[#f97386]/20 p-2 rounded-full text-[#a8364b] flex-shrink-0">
                <span class="material-symbols-outlined text-3xl">warning</span>
            </div>
            <div>
                <h2 class="text-xl font-extrabold text-[#a8364b] font-headline mb-1">Confirm Permanent Deletion</h2>
                <p class="text-[#a8364b]/80 text-sm font-medium leading-relaxed">
                    You are about to permanently delete the cinema location <strong>"@Model.Name"</strong> from the database. This action may cascade and delete associated cinema halls and showtimes. This cannot be undone.
                </p>
            </div>
        </div>

        <div class="bg-white rounded-3xl shadow-lg border border-outline-variant/20 p-8 flex flex-col md:flex-row gap-8 items-center md:items-start relative overflow-hidden">
            
            <div class="absolute -right-16 -top-16 opacity-5 pointer-events-none">
                <span class="material-symbols-outlined text-[250px]">business</span>
            </div>

            <div class="w-32 h-32 rounded-xl overflow-hidden shadow-md flex-shrink-0 bg-surface-container border border-outline-variant/30 z-10 flex items-center justify-center">
                @if (!string.IsNullOrEmpty(Model.Logo))
                {
                    <img src="@Model.Logo" class="w-full h-full object-cover" alt="@Model.Name" />
                }
                else
                {
                    <span class="material-symbols-outlined text-5xl text-outline-variant opacity-50">storefront</span>
                }
            </div>

            <div class="flex-1 w-full z-10">
                <div class="flex gap-2 mb-3">
                    <span class="px-2.5 py-1 bg-emerald-50 text-emerald-700 text-[10px] font-bold rounded uppercase tracking-widest border border-emerald-100 flex items-center gap-1">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Active Site
                    </span>
                </div>
                
                <h3 class="text-3xl font-extrabold text-on-surface font-headline mb-2">@Model.Name</h3>
                <p class="text-sm text-on-surface-variant mb-6 line-clamp-2">@Model.Description</p>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-y-4 gap-x-8">
                    <div>
                        <p class="text-[10px] uppercase tracking-widest text-outline font-bold mb-1">City / Region</p>
                        <p class="text-sm font-semibold text-on-surface-variant flex items-center gap-1.5">
                            <span class="material-symbols-outlined text-[16px]">location_city</span>
                            @(string.IsNullOrEmpty(Model.City) ? "N/A" : Model.City)
                        </p>
                    </div>
                    <div>
                        <p class="text-[10px] uppercase tracking-widest text-outline font-bold mb-1">Full Address</p>
                        <p class="text-sm font-semibold text-on-surface-variant flex items-start gap-1.5">
                            <span class="material-symbols-outlined text-[16px] mt-0.5">map</span>
                            @(string.IsNullOrEmpty(Model.Address) ? "N/A" : Model.Address)
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <form method="post" class="mt-8 flex items-center justify-end gap-4 border-t border-outline-variant/30 pt-6">
            <input asp-for="Id" hidden />
            
            <a asp-action="Index" class="px-8 py-3 rounded-xl font-bold text-on-surface-variant hover:bg-surface-container-high transition-colors font-label">
                Cancel & Keep Location
            </a>
            
            <button type="submit" class="px-10 py-3 rounded-xl bg-[#a8364b] hover:bg-[#8b2b3d] text-white font-bold shadow-lg shadow-[#a8364b]/20 active:scale-95 transition-all font-label flex items-center gap-2">
                <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">delete_forever</span>
                Yes, Delete Location
            </button>
        </form>

    </div>
</main>