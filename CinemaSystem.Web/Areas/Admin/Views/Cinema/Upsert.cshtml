@model CinemaSystem.Models.ViewModels.CinemaVM

@{
    ViewData["Title"] = Model.Id != 0 ? "Update Cinema" : "Add New Cinema";
    Layout = null; // Izolăm de layout-ul public
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"] - CineAdmin</title>
    
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#665788",
                        "primary-container": "#d8c6ff",
                        "primary-fixed": "#eaddff",
                        "secondary": "#645b71",
                        "tertiary": "#7d516e",
                        "surface": "#fdf8fd",
                        "surface-container-low": "#f7f2f9",
                        "surface-container": "#f1ecf4",
                        "on-surface": "#343139",
                        "on-surface-variant": "#615e67",
                        "outline": "#7d7982",
                        "outline-variant": "#b5b0ba",
                        "error": "#a8364b"
                    },
                    fontFamily: {
                        "headline": ["Manrope", "sans-serif"],
                        "body": ["Inter", "sans-serif"],
                        "label": ["Inter", "sans-serif"]
                    }
                }
            }
        }
    </script>
    <style>
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; vertical-align: middle; }
        .file-upload-wrapper input[type="file"] {
            position: absolute; top: 0; right: 0; bottom: 0; left: 0;
            width: 100%; height: 100%; opacity: 0; cursor: pointer; z-index: 10;
        }
    </style>
</head>
<body class="bg-surface text-on-surface antialiased font-body flex min-h-screen">

    <aside class="fixed left-0 top-0 h-full flex flex-col pt-4 pb-8 bg-[#7f6fa2] text-white font-headline w-64 border-r border-white/10 shadow-lg z-50">
        <div class="px-6 mb-8">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-[#976987] rounded-lg flex items-center justify-center">
                    <span class="material-symbols-outlined text-white" data-icon="theater_comedy">theater_comedy</span>
                </div>
                <div>
                    <h1 class="text-lg font-black text-white leading-tight">Cinema Suite</h1>
                    <p class="text-xs text-white/80 uppercase tracking-widest mt-1">System Management</p>
                </div>
            </div>
        </div>
        <nav class="flex-1 space-y-1">
            <a asp-controller="Dashboard" asp-action="Index" class="flex items-center px-4 py-3 text-white/70 hover:text-white mx-2 hover:bg-white/10 rounded-lg transition-all">
                <span class="material-symbols-outlined mr-3">dashboard</span> <span class="text-sm font-medium">Dashboard</span>
            </a>
            <a asp-controller="Cinema" asp-action="Index" class="flex items-center px-4 py-3 bg-[#976987] text-white font-semibold rounded-lg mx-2 shadow-md transition-all">
                <span class="material-symbols-outlined mr-3">theater_comedy</span> <span class="text-sm font-medium">Cinemas</span>
            </a>
            <a asp-controller="Movie" asp-action="Index" class="flex items-center px-4 py-3 text-white/70 hover:text-white mx-2 hover:bg-white/10 rounded-lg transition-all">
                <span class="material-symbols-outlined mr-3">movie</span> <span class="text-sm font-medium">Movies</span>
            </a>
            <a href="#" class="flex items-center px-4 py-3 text-white/70 hover:text-white mx-2 hover:bg-white/10 rounded-lg transition-all">
                <span class="material-symbols-outlined mr-3">schedule</span> <span class="text-sm font-medium">Showtimes</span>
            </a>
            <a asp-controller="Equipment" asp-action="Index" class="flex items-center px-4 py-3 text-white/70 hover:text-white mx-2 hover:bg-white/10 rounded-lg transition-all">
                <span class="material-symbols-outlined mr-3">settings_input_component</span> <span class="text-sm font-medium">Equipment</span>
            </a>
        </nav>
        <div class="mt-auto px-2">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="flex items-center px-4 py-3 text-white/70 hover:text-white hover:bg-white/10 rounded-lg transition-all">
                <span class="material-symbols-outlined mr-3">public</span> <span class="text-sm font-medium">Public Site</span>
            </a>
        </div>
    </aside>

    <div class="flex-1 ml-64 flex flex-col">
        <header class="flex justify-between items-center px-8 h-16 w-full sticky top-0 z-40 bg-[#7f6fa2] text-white border-b border-white/10 shadow-sm">
            <span class="text-xl font-bold tracking-tight font-headline">CinemaAdmin</span>
            <div class="flex items-center gap-4">
                <div class="relative hidden md:block">
                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-white/50 text-sm">search</span>
                    <input class="bg-white/10 border-none rounded-full pl-10 pr-4 py-1.5 text-sm placeholder-white/50 focus:ring-2 focus:ring-white/50 w-64 outline-none" placeholder="Search system..." type="text"/>
                </div>
                <div class="h-6 w-px bg-white/20 mx-2"></div>
                <div class="w-8 h-8 rounded-full border border-white/20 bg-white/20 flex items-center justify-center text-white font-bold text-xs">AD</div>
            </div>
        </header>

        <main class="p-8 max-w-[1600px] mx-auto w-full pb-20">
            
            <form method="post" enctype="multipart/form-data">
                <input asp-for="Id" hidden />
                <input asp-for="Logo" hidden />

                <div class="mb-8 flex justify-between items-end">
                    <div>
                        <nav class="flex text-sm text-on-surface-variant mb-2 gap-2 items-center font-label">
                            <a asp-action="Index" class="hover:text-primary transition-colors">Cinemas</a>
                            <span class="material-symbols-outlined text-xs">chevron_right</span>
                            <span class="text-primary font-medium">@(Model.Id != 0 ? "Update" : "Add New") Cinema</span>
                        </nav>
                        <h2 class="text-3xl font-extrabold text-on-surface tracking-tight font-headline">Manage Location</h2>
                    </div>
                    <div class="flex gap-3">
                        <a asp-action="Index" class="px-6 py-2.5 rounded-lg border border-outline-variant text-on-surface hover:bg-surface-container transition-colors font-medium font-label">Cancel</a>
                        <button type="submit" class="px-8 py-2.5 rounded-lg bg-primary text-white hover:bg-[#5a4b7b] shadow-md transition-all font-semibold font-label flex items-center gap-2">
                            <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">save</span>
                            Save Cinema
                        </button>
                    </div>
                </div>

                <div class="grid grid-cols-12 gap-8">
                    
                    <div class="col-span-12 lg:col-span-8 space-y-8">
                        
                        <section class="bg-white rounded-xl p-8 shadow-sm border border-outline-variant/20">
                            <div class="flex items-center gap-2 mb-6 text-primary">
                                <span class="material-symbols-outlined text-2xl">info</span>
                                <h3 class="text-xl font-bold font-headline">General Information</h3>
                            </div>
                            
                            <div class="grid grid-cols-2 gap-6">
                                <div class="col-span-2">
                                    <label asp-for="Name" class="block text-sm font-bold text-on-surface-variant mb-1.5 uppercase tracking-widest text-[10px]">Cinema Name <span class="text-error">*</span></label>
                                    <input asp-for="Name" class="w-full rounded-xl border border-outline-variant/50 bg-surface-container-lowest px-4 py-3 focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all outline-none" placeholder="e.g. Grand Plaza Multiplex" />
                                    <span asp-validation-for="Name" class="text-error text-xs mt-1 block"></span>
                                </div>
                                
                                <div class="col-span-2">
                                    <label asp-for="Description" class="block text-sm font-bold text-on-surface-variant mb-1.5 uppercase tracking-widest text-[10px]">Description</label>
                                    <textarea asp-for="Description" class="w-full rounded-xl border border-outline-variant/50 bg-surface-container-lowest px-4 py-3 focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all outline-none" placeholder="Brief history or unique selling points..." rows="4"></textarea>
                                    <span asp-validation-for="Description" class="text-error text-xs mt-1 block"></span>
                                </div>
                            </div>
                        </section>

                        <section class="bg-white rounded-xl p-8 shadow-sm border border-outline-variant/20">
                            <div class="flex items-center gap-2 mb-6 text-primary">
                                <span class="material-symbols-outlined text-2xl">location_on</span>
                                <h3 class="text-xl font-bold font-headline">Location Details</h3>
                            </div>
                            
                            <div class="grid grid-cols-2 gap-6">
                                <div class="col-span-2 md:col-span-1">
                                    <label asp-for="City" class="block text-sm font-bold text-on-surface-variant mb-1.5 uppercase tracking-widest text-[10px]">City / Region <span class="text-error">*</span></label>
                                    <div class="relative">
                                        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline-variant">location_city</span>
                                        <input asp-for="City" class="w-full rounded-xl border border-outline-variant/50 bg-surface-container-lowest pl-10 pr-4 py-3 focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all outline-none" placeholder="e.g. Los Angeles" />
                                    </div>
                                    <span asp-validation-for="City" class="text-error text-xs mt-1 block"></span>
                                </div>

                                <div class="col-span-2">
                                    <label asp-for="Address" class="block text-sm font-bold text-on-surface-variant mb-1.5 uppercase tracking-widest text-[10px]">Full Address <span class="text-error">*</span></label>
                                    <div class="relative">
                                        <span class="material-symbols-outlined absolute left-3 top-4 text-outline-variant">map</span>
                                        <textarea asp-for="Address" class="w-full rounded-xl border border-outline-variant/50 bg-surface-container-lowest pl-10 pr-4 py-3 focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all outline-none" placeholder="Enter the complete street address..." rows="2"></textarea>
                                    </div>
                                    <span asp-validation-for="Address" class="text-error text-xs mt-1 block"></span>
                                </div>
                            </div>
                        </section>

                    </div>

                    <div class="col-span-12 lg:col-span-4 space-y-8">
                        
                        <section class="bg-white rounded-xl p-8 shadow-sm border border-outline-variant/20 sticky top-24">
                            <div class="flex items-center gap-2 mb-6 text-primary">
                                <span class="material-symbols-outlined text-2xl">photo_camera</span>
                                <h3 class="text-xl font-bold font-headline">Media & Branding</h3>
                            </div>
                            
                            <div>
                                <label class="block text-sm font-bold text-on-surface-variant mb-3 uppercase tracking-widest text-[10px]">Cinema Logo / Exterior</label>
                                
                                <div class="relative group aspect-[4/3] rounded-2xl overflow-hidden bg-surface-container-low border-2 border-dashed border-outline-variant/50 flex flex-col items-center justify-center transition-all hover:bg-surface-container hover:border-primary file-upload-wrapper shadow-inner">
                                    <input type="file" name="file" accept=".jpg,.jpeg,.png,.webp" />
                                    
                                    @if (!string.IsNullOrEmpty(Model.Logo))
                                    {
                                        <img src="@Model.Logo" class="absolute inset-0 w-full h-full object-cover z-0" alt="Cinema Logo" />
                                        <div class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 transition-opacity z-10 flex flex-col items-center justify-center text-white">
                                            <span class="material-symbols-outlined text-4xl mb-2">cloud_upload</span>
                                            <span class="text-sm font-bold">Change Image</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="relative z-10 flex flex-col items-center text-outline-variant group-hover:text-primary transition-colors">
                                            <span class="material-symbols-outlined text-5xl mb-2 opacity-50">storefront</span>
                                            <span class="text-sm font-bold">Upload Image</span>
                                            <span class="text-[10px] uppercase tracking-widest mt-1 opacity-70">JPG, PNG, WEBP</span>
                                        </div>
                                    }
                                </div>
                            </div>
                            
                            <div class="mt-6 bg-[#f3f3f3] p-4 rounded-xl border border-outline-variant/20 flex gap-3">
                                <span class="material-symbols-outlined text-primary">lightbulb</span>
                                <p class="text-xs text-on-surface-variant leading-relaxed">
                                    A high-quality image helps customers recognize your cinema branch on the public booking site. Recommended ratio: 4:3.
                                </p>
                            </div>
                        </section>

                    </div>
                </div>
            </form>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

</body>
</html>