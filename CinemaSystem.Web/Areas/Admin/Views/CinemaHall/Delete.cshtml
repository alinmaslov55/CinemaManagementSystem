@model CinemaSystem.Models.Entities.CinemaHall

@{
    ViewData["Title"] = "Delete Cinema Hall";
    // OBJECTIVE FIX: Izolăm complet de layout-ul public
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"] - CineAdmin</title>
    
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    
    <script id="tailwind-config">
        tailwind.config = {
        darkMode: "class",
        theme: {
        extend: {
        colors: {
        "primary": "#665788",
        "primary-container": "#d8c6ff",
        "primary-fixed": "#eaddff",
        "secondary": "#645b71",
        "tertiary": "#7d516e",
        "surface": "#fdf8fd",
        "surface-container-low": "#f7f2f9",
        "surface-container": "#f1ecf4",
        "on-surface": "#343139",
        "on-surface-variant": "#615e67",
        "outline": "#7d7982",
        "outline-variant": "#b5b0ba",
        "error": "#a8364b",
        "error-container": "#f97386"
        },
        fontFamily: {
        "headline": ["Manrope", "sans-serif"],
        "body": ["Inter", "sans-serif"],
        "label": ["Inter", "sans-serif"]
        }
        }
        }
        }
    </script>
    <style>
        .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        vertical-align: middle;
        }
    </style>
</head>
<body class="bg-surface text-on-surface antialiased font-body flex min-h-screen">

    <aside class="fixed left-0 top-0 h-full flex flex-col pt-4 pb-8 bg-[#8675A9] text-white font-headline w-64 border-r border-white/10 shadow-lg z-50">
        <div class="px-6 mb-8">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-[#976987] rounded-lg flex items-center justify-center">
                    <span class="material-symbols-outlined text-white" data-icon="theater_comedy">theater_comedy</span>
                </div>
                <div>
                    <h1 class="text-2xl font-black text-white leading-tight">CineAdmin</h1>
                    <p class="text-xs text-white/80 uppercase tracking-widest mt-1">Management Portal</p>
                </div>
            </div>
        </div>
        <nav class="flex-1 space-y-1">
            <a asp-controller="Dashboard" asp-action="Index" class="flex items-center px-4 py-3 text-white/70 hover:text-white mx-2 hover:bg-white/10 rounded-lg transition-all">
                <span class="material-symbols-outlined mr-3">dashboard</span> <span class="text-sm font-medium">Dashboard</span>
            </a>
            
            <a asp-controller="Cinema" asp-action="Index" class="flex items-center px-4 py-3 bg-[#976987] text-white font-semibold rounded-lg mx-2 shadow-md transition-all">
                <span class="material-symbols-outlined mr-3">theater_comedy</span> <span class="text-sm font-medium">Cinemas</span>
            </a>
            
            <a asp-controller="Movie" asp-action="Index" class="flex items-center px-4 py-3 text-white/70 hover:text-white mx-2 hover:bg-white/10 rounded-lg transition-all">
                <span class="material-symbols-outlined mr-3">movie</span> <span class="text-sm font-medium">Movies</span>
            </a>
            <a href="#" class="flex items-center px-4 py-3 text-white/70 hover:text-white mx-2 hover:bg-white/10 rounded-lg transition-all">
                <span class="material-symbols-outlined mr-3">schedule</span> <span class="text-sm font-medium">Showtimes</span>
            </a>
            <a asp-controller="Equipment" asp-action="Index" class="flex items-center px-4 py-3 text-white/70 hover:text-white mx-2 hover:bg-white/10 rounded-lg transition-all">
                <span class="material-symbols-outlined mr-3">settings_input_component</span> <span class="text-sm font-medium">Equipment</span>
            </a>
        </nav>
        <div class="mt-auto px-2">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="flex items-center px-4 py-3 text-white/70 hover:text-white hover:bg-white/10 rounded-lg transition-all">
                <span class="material-symbols-outlined mr-3">public</span> <span class="text-sm font-medium">Public Site</span>
            </a>
        </div>
    </aside>

    <div class="flex-1 ml-64 flex flex-col">
        <header class="flex justify-between items-center px-8 h-16 w-full sticky top-0 z-40 bg-[#8675A9] text-white border-b border-white/10 shadow-sm">
            <span class="text-xl font-bold tracking-tight font-headline">Hall Management</span>
            <div class="flex items-center gap-4">
                <div class="relative opacity-50 pointer-events-none hidden md:block">
                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-white/50 text-sm">search</span>
                    <input class="bg-white/10 border-none rounded-full pl-10 pr-4 py-1.5 text-sm text-white w-64" disabled type="text" />
                </div>
                <div class="h-6 w-px bg-white/20 mx-2"></div>
                <div class="w-8 h-8 rounded-full border border-white/20 bg-white/20 flex items-center justify-center text-white font-bold text-xs">AD</div>
            </div>
        </header>

        <main class="flex-1 p-8 flex justify-center items-start">
            
            <div class="w-full max-w-3xl mt-8">
                
                <nav class="flex text-sm text-on-surface-variant mb-6 gap-2 font-label items-center uppercase tracking-wider font-bold">
                    <a asp-controller="Cinema" asp-action="Index" class="hover:text-primary transition-colors">Cinemas</a>
                    <span class="material-symbols-outlined text-[16px]">chevron_right</span>
                    <a asp-action="Index" class="hover:text-primary transition-colors">Halls</a>
                    <span class="material-symbols-outlined text-[16px]">chevron_right</span>
                    <span class="text-error font-semibold">Delete Record</span>
                </nav>

                <div class="bg-[#f97386]/10 border border-[#f97386]/30 p-6 rounded-2xl mb-8 flex items-start gap-4 shadow-sm">
                    <div class="bg-[#f97386]/20 p-2 rounded-full text-[#a8364b] flex-shrink-0">
                        <span class="material-symbols-outlined text-3xl">warning</span>
                    </div>
                    <div>
                        <h2 class="text-xl font-extrabold text-[#a8364b] font-headline mb-1">Confirm Permanent Deletion</h2>
                        <p class="text-[#a8364b]/80 text-sm font-medium leading-relaxed">
                            You are about to permanently delete <strong>"@Model.Name"</strong> from the database. This action will cascade and instantly destroy the interactive seat layout, seating configurations, and all upcoming showtimes associated with this hall. This cannot be undone.
                        </p>
                    </div>
                </div>

                <div class="bg-white rounded-3xl shadow-lg border border-outline-variant/20 p-8 flex flex-col md:flex-row gap-8 items-center md:items-start relative overflow-hidden">
                    
                    <div class="absolute -right-16 -top-16 opacity-5 pointer-events-none">
                        <span class="material-symbols-outlined text-[250px]">meeting_room</span>
                    </div>

                    <div class="w-32 h-32 rounded-xl overflow-hidden shadow-md flex-shrink-0 bg-surface-container border border-outline-variant/30 z-10 flex items-center justify-center text-primary">
                        <span class="material-symbols-outlined text-5xl opacity-80">videocam</span>
                    </div>

                    <div class="flex-1 w-full z-10">
                        <div class="flex gap-2 mb-3">
                            <span class="px-2.5 py-1 bg-surface-container-high text-on-surface-variant text-[10px] font-extrabold rounded uppercase tracking-widest border border-outline-variant/30">
                                @Model.HallType
                            </span>
                            <span class="px-2.5 py-1 bg-error/10 text-error text-[10px] font-extrabold rounded uppercase tracking-widest border border-error/20 flex items-center gap-1">
                                <span class="w-1.5 h-1.5 rounded-full bg-error"></span> Pending Deletion
                            </span>
                        </div>
                        
                        <h3 class="text-3xl font-extrabold text-on-surface font-headline mb-1">@Model.Name</h3>
                        <p class="text-sm font-bold text-on-surface-variant flex items-center gap-1.5 mb-6">
                            <span class="material-symbols-outlined text-[16px]">location_on</span>
                            @(Model.Cinema?.Name ?? "Unknown Location")
                        </p>
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-y-4 gap-x-8">
                            <div>
                                <p class="text-[10px] uppercase tracking-widest text-outline font-bold mb-1">Seating Capacity</p>
                                <p class="text-sm font-semibold text-on-surface-variant flex items-center gap-1.5">
                                    <span class="material-symbols-outlined text-[16px]">event_seat</span>
                                    @Model.TotalSeats Seats Configured
                                </p>
                            </div>
                            <div>
                                <p class="text-[10px] uppercase tracking-widest text-outline font-bold mb-1">Layout Data</p>
                                <p class="text-sm font-semibold text-on-surface-variant flex items-center gap-1.5">
                                    <span class="material-symbols-outlined text-[16px]">data_object</span>
                                    Interactive Grid Active
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <form method="post" class="mt-8 flex items-center justify-end gap-4 border-t border-outline-variant/30 pt-6">
                    <input asp-for="Id" hidden />
                    
                    <a asp-action="Index" class="px-8 py-3 rounded-xl font-bold text-on-surface-variant hover:bg-surface-container-high transition-colors font-label">
                        Cancel & Keep Hall
                    </a>
                    
                    <button type="submit" class="px-10 py-3 rounded-xl bg-[#a8364b] hover:bg-[#8b2b3d] text-white font-bold shadow-lg shadow-[#a8364b]/20 active:scale-95 transition-all font-label flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">delete_forever</span>
                        Yes, Delete Hall
                    </button>
                </form>

            </div>
        </main>
    </div>

</body>
</html>
