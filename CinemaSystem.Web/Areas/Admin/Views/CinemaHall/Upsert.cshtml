@model CinemaSystem.Models.ViewModels.CinemaHallVM
@using CinemaSystem.Models.Data.Enums

@{
    ViewData["Title"] = Model.CinemaHall.Id != 0 ? "Configure Hall" : "Add New Hall";
    // ATENȚIE: Legăm pagina de layout-ul central de Admin
    Layout = "~/Views/Shared/_AdminLayout.cshtml"; 
}

<style>
    /* Seat Styling for JS Generation (Specific doar acestei pagini) */
    .seat-standard { background-color: #6c757d; color: white; }
    .seat-premium { background-color: #198754; color: white; }
    .seat-vip { background-color: #ffc107; color: black; }
    .seat-handicap { background-color: #0dcaf0; color: black; }
    
    .preview-scroll::-webkit-scrollbar { width: 6px; height: 6px; }
    .preview-scroll::-webkit-scrollbar-track { background: transparent; }
    .preview-scroll::-webkit-scrollbar-thumb { background: #cbc4cf; border-radius: 10px; }
</style>

<main class="p-8 max-w-[1600px] mx-auto w-full">
    
    <form method="post" id="hallForm" class="flex flex-col h-full">
        
        <input asp-for="CinemaHall.Id" hidden />
        <input asp-for="CinemaHall.TotalSeats" id="totalSeatsHidden" hidden />
        <input type="hidden" asp-for="SeatLayoutData" id="layoutDataHidden" />

        <div class="mb-6 flex justify-between items-end">
            <div>
                <nav class="flex text-xs text-on-surface-variant mb-2 gap-2 font-label items-center uppercase tracking-wider font-bold">
                    <a asp-controller="Cinema" asp-action="Index" class="hover:text-primary transition-colors">Cinemas</a>
                    <span class="material-symbols-outlined text-[16px]">chevron_right</span>
                    <a asp-action="Index" class="hover:text-primary transition-colors">Halls</a>
                    <span class="material-symbols-outlined text-[16px]">chevron_right</span>
                    <span class="text-primary">Configure</span>
                </nav>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            
            <section class="lg:col-span-5 space-y-6">
                
                <div class="bg-surface-container-lowest p-8 rounded-2xl shadow-sm border border-outline-variant/30">
                    <div class="flex items-center gap-4 mb-8">
                        <div class="p-3 bg-primary-fixed rounded-xl text-primary">
                            <span class="material-symbols-outlined text-2xl">settings_overscan</span>
                        </div>
                        <h2 class="text-2xl font-headline font-extrabold text-on-surface">Configure Cinema Hall</h2>
                    </div>
                    
                    <div class="space-y-6">
                        <div>
                            <label asp-for="CinemaHall.Name" class="block text-xs font-label font-bold text-outline mb-1.5 uppercase tracking-widest">Hall Name <span class="text-error">*</span></label>
                            <input asp-for="CinemaHall.Name" class="w-full bg-surface-container border border-outline-variant/30 rounded-xl px-4 py-3 focus:ring-2 focus:ring-primary focus:bg-white transition-all outline-none text-sm font-semibold" placeholder="e.g. Hall 1, IMAX Theatre" />
                            <span asp-validation-for="CinemaHall.Name" class="text-error text-xs mt-1 block"></span>
                        </div>
                        
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label asp-for="CinemaHall.CinemaId" class="block text-xs font-label font-bold text-outline mb-1.5 uppercase tracking-widest">Cinema Location <span class="text-error">*</span></label>
                                <select asp-for="CinemaHall.CinemaId" asp-items="@Model.CinemaList" class="w-full bg-surface-container border border-outline-variant/30 rounded-xl px-4 py-3 focus:ring-2 focus:ring-primary focus:bg-white transition-all outline-none text-sm font-semibold cursor-pointer appearance-none">
    <option disabled selected value="">-- Select --</option>
</select>
                                <span asp-validation-for="CinemaHall.CinemaId" class="text-error text-xs mt-1 block"></span>
                            </div>
                            <div>
                                <label asp-for="CinemaHall.HallType" class="block text-xs font-label font-bold text-outline mb-1.5 uppercase tracking-widest">Hall Type <span class="text-error">*</span></label>
                                <select asp-for="CinemaHall.HallType" asp-items="Html.GetEnumSelectList<HallType>()" class="w-full bg-surface-container border border-outline-variant/30 rounded-xl px-4 py-3 focus:ring-2 focus:ring-primary focus:bg-white transition-all outline-none text-sm font-semibold cursor-pointer appearance-none">
                                </select>
                                <span asp-validation-for="CinemaHall.HallType" class="text-error text-xs mt-1 block"></span>
                            </div>
                        </div>

                        <div class="pt-6 border-t border-outline-variant/20 mt-6">
                            <h3 class="text-xs font-bold text-primary mb-4 flex items-center gap-2 uppercase tracking-widest">
                                <span class="material-symbols-outlined text-sm">grid_view</span> Grid Dimensions
                            </h3>
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label asp-for="Rows" class="block text-[10px] font-label font-bold text-outline mb-1.5 uppercase tracking-widest">Total Rows (A-Z)</label>
                                    <input asp-for="Rows" type="number" id="rowsInput" class="w-full bg-surface-container border border-outline-variant/30 rounded-xl px-4 py-3 focus:ring-2 focus:ring-primary focus:bg-white text-center font-bold font-headline outline-none" min="1" max="26" />
                                </div>
                                <div>
                                    <label asp-for="Cols" class="block text-[10px] font-label font-bold text-outline mb-1.5 uppercase tracking-widest">Columns per Row</label>
                                    <input asp-for="Cols" type="number" id="colsInput" class="w-full bg-surface-container border border-outline-variant/30 rounded-xl px-4 py-3 focus:ring-2 focus:ring-primary focus:bg-white text-center font-bold font-headline outline-none" min="1" max="30" />
                                </div>
                            </div>
                        </div>

                        <div class="pt-6 border-t border-outline-variant/20 mt-6">
                            <label class="block text-xs font-label font-bold text-outline mb-4 uppercase tracking-widest">Seating Legend</label>
                            <div class="grid grid-cols-2 gap-3">
                                <div class="flex items-center gap-3 p-3 rounded-xl bg-surface-container-low border border-outline-variant/20">
                                    <div class="w-4 h-4 rounded bg-[#6c757d] shadow-sm"></div>
                                    <span class="text-xs font-bold text-on-surface">Standard</span>
                                </div>
                                <div class="flex items-center gap-3 p-3 rounded-xl bg-surface-container-low border border-outline-variant/20">
                                    <div class="w-4 h-4 rounded bg-[#198754] shadow-sm"></div>
                                    <span class="text-xs font-bold text-on-surface">Premium</span>
                                </div>
                                <div class="flex items-center gap-3 p-3 rounded-xl bg-surface-container-low border border-outline-variant/20">
                                    <div class="w-4 h-4 rounded bg-[#ffc107] shadow-sm"></div>
                                    <span class="text-xs font-bold text-on-surface">VIP</span>
                                </div>
                                <div class="flex items-center gap-3 p-3 rounded-xl bg-surface-container-low border border-outline-variant/20">
                                    <div class="w-4 h-4 rounded bg-[#0dcaf0] shadow-sm"></div>
                                    <span class="text-xs font-bold text-on-surface">Handicap</span>
                                </div>
                            </div>
                            
                            <button type="button" onclick="clearLayout()" class="w-full mt-6 flex items-center justify-center gap-2 py-3 text-sm font-bold text-[#a8364b] hover:bg-[#f97386]/10 rounded-xl transition-colors border border-dashed border-[#a8364b]/30">
                                <span class="material-symbols-outlined text-lg">layers_clear</span>
                                Clear All Customizations
                            </button>
                        </div>
                    </div>
                </div>

                <div class="flex items-center gap-4">
                    <button type="submit" class="flex-1 bg-primary text-white font-bold py-4 rounded-xl shadow-lg shadow-primary/30 hover:bg-[#5a4b7b] transition-all flex items-center justify-center gap-2 uppercase tracking-widest text-xs">
                        <span class="material-symbols-outlined text-lg">save</span>
                        Save Hall & Layout
                    </button>
                    <a asp-action="Index" class="px-8 py-4 bg-white border border-outline-variant/30 text-on-surface font-bold rounded-xl hover:bg-surface-container transition-all uppercase tracking-widest text-xs text-center">
                        Back
                    </a>
                </div>
            </section>

            <section class="lg:col-span-7 h-full">
                <div class="bg-surface-container-lowest rounded-2xl shadow-sm border border-outline-variant/30 overflow-hidden flex flex-col h-full min-h-[700px]">
                    
                    <div class="p-6 border-b border-outline-variant/20 flex justify-between items-center bg-white">
                        <div>
                            <h2 class="text-xl font-headline font-bold text-on-surface">Interactive Seat Editor</h2>
                            <p class="text-xs text-on-surface-variant font-medium mt-1">Click individual seats to cycle through seating types</p>
                        </div>
                        <div class="px-4 py-2 bg-primary/10 text-primary rounded-lg text-xs font-bold flex items-center gap-2">
                            <span class="material-symbols-outlined text-sm">visibility</span> Live Preview
                        </div>
                    </div>
                    
                    <div class="flex-1 p-8 bg-[#111827] relative flex flex-col items-center overflow-auto preview-scroll">
                        <div class="w-4/5 mb-16 relative">
                            <div class="h-2 w-full bg-slate-700 rounded-full shadow-[0_15px_30px_rgba(255,255,255,0.1)]"></div>
                            <div class="absolute top-4 left-1/2 -translate-x-1/2 text-[10px] font-black text-slate-500 tracking-[0.4em] uppercase">SCREEN</div>
                            <div class="mt-2 h-20 w-full bg-gradient-to-b from-slate-700/20 to-transparent blur-xl"></div>
                        </div>
                        
                        <div class="grid gap-2 w-fit mx-auto select-none" id="seatingContainer"></div>
                        
                        <div class="h-10 shrink-0"></div>
                    </div>
                    
                    <div class="p-5 bg-surface-container-low border-t border-outline-variant/30 flex items-center justify-between text-xs font-medium text-on-surface-variant">
                        <div class="flex gap-6">
                            <span class="uppercase tracking-widest font-bold">Total Seats: <span class="text-primary text-sm" id="liveTotalSeats">0</span></span>
                        </div>
                        <div class="flex items-center gap-1.5 opacity-70">
                            <span class="material-symbols-outlined text-sm">mouse</span>
                            <span>Left click to cycle types</span>
                        </div>
                    </div>

                </div>
            </section>

        </div>
    </form>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const rowsInput = document.getElementById('rowsInput');
        const colsInput = document.getElementById('colsInput');
        const container = document.getElementById('seatingContainer');
        const hiddenTotal = document.getElementById('totalSeatsHidden');
        const layoutHidden = document.getElementById('layoutDataHidden');
        const liveTotalLabel = document.getElementById('liveTotalSeats');

        let seatMap = [];

        function clearLayout() {
            if (confirm("Are you sure you want to reset all seats to 'Standard'? This cannot be undone.")) {
                layoutHidden.value = "";
                renderGrid();
            }
        }

        function renderGrid() {
            const r = parseInt(rowsInput.value) || 0;
            const c = parseInt(colsInput.value) || 0;
            const total = r * c;
            
            hiddenTotal.value = total;
            liveTotalLabel.innerText = total;

            let existingData = [];
            try {
                if (layoutHidden.value) {
                    existingData = JSON.parse(layoutHidden.value);
                }
            } catch (e) {
                console.warn("Starting with fresh layout data.");
            }

            container.innerHTML = '';
            container.style.gridTemplateColumns = `repeat(${c}, 1fr)`;

            seatMap = [];

            for (let i = 0; i < total; i++) {
                const currentRow = String.fromCharCode(65 + Math.floor(i / c));
                const currentCol = (i % c) + 1;

                const savedSeat = existingData.find(s =>
                    (s.Row === currentRow || s.row === currentRow) &&
                    (s.Col === currentCol || s.col === currentCol)
                );

                let sType = 1; // Standard
                let sAcc = false;

                if (savedSeat) {
                    let rawType = savedSeat.Type !== undefined ? savedSeat.Type : savedSeat.type;
                    if (rawType === 2 || rawType === "Premium") sType = 2;
                    else if (rawType === 3 || rawType === "VIP") sType = 3;
                    else if (rawType === 4 || rawType === "Handicap") sType = 4;
                    sAcc = savedSeat.IsAcc !== undefined ? savedSeat.IsAcc : (savedSeat.isAcc || false);
                }

                const seatData = { Row: currentRow, Col: currentCol, Type: sType, IsAcc: sAcc };
                seatMap.push(seatData);

                const seat = document.createElement('div');
                // Clasele de Tailwind pentru a arăta ca un scaun curbat sus (rounded-t-lg)
                seat.className = "w-8 h-8 rounded-t-lg flex items-center justify-center text-[9px] font-bold transition-all cursor-pointer hover:ring-2 hover:ring-white/50 hover:-translate-y-0.5";
                seat.innerText = `${currentRow}${currentCol}`;

                setSeatStyle(seat, seatData);

                seat.onclick = () => {
                    if (seatData.Type === 1 && !seatData.IsAcc) seatData.Type = 2;
                    else if (seatData.Type === 2) seatData.Type = 3;
                    else if (seatData.Type === 3) { seatData.Type = 4; seatData.IsAcc = true; }
                    else { seatData.Type = 1; seatData.IsAcc = false; }

                    setSeatStyle(seat, seatData);
                    updateLayoutData();
                };

                container.appendChild(seat);
            }
            updateLayoutData();
        }

        function setSeatStyle(element, data) {
            element.classList.remove('seat-standard', 'seat-premium', 'seat-vip', 'seat-handicap');
            switch(data.Type) {
                case 1: element.classList.add('seat-standard'); break;
                case 2: element.classList.add('seat-premium'); break;
                case 3: element.classList.add('seat-vip'); break;
                case 4: element.classList.add('seat-handicap'); break;
            }
        }

        function updateLayoutData() {
            layoutHidden.value = JSON.stringify(seatMap);
        }

        rowsInput.addEventListener('input', renderGrid);
        colsInput.addEventListener('input', renderGrid);

        window.onload = renderGrid;
    </script>
}