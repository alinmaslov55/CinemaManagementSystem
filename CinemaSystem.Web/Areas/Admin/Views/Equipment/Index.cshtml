@using Microsoft.Extensions.Localization
@using CinemaSystem.Utility
@model List<CinemaSystem.Models.Entities.Equipment>
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["Equipment_IndexTitle"];
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var totalAssets = Model.Count;
    var operationalAssets = Model.Count(e => e.Status.ToString() == "Operational");
    var maintenanceAssets = totalAssets - operationalAssets;
    var operationalPercentage = totalAssets > 0 ? (operationalAssets * 100.0 / totalAssets) : 0;
}

<main class="p-8 max-w-[1600px] mx-auto w-full pb-12">

    <div class="flex justify-between items-end mb-8">
        <div>
            <h1 class="text-4xl font-extrabold text-primary font-headline tracking-tight">@Localizer["Equipment_IndexTitle"]</h1>
            <p class="text-on-surface-variant font-body mt-1">@Localizer["Equipment_IndexSubtitle"]</p>
        </div>
        <div class="flex space-x-3">
            <button id="exportReportBtn" class="hidden md:flex items-center space-x-2 px-5 py-2.5 bg-white text-primary border border-outline-variant/30 rounded-xl font-headline font-bold text-sm hover:bg-surface-container transition-all shadow-sm">
                <span class="material-symbols-outlined text-sm">file_download</span>
                <span>@Localizer["Equipment_ExportReportBtn"]</span>
            </button>
            <a asp-controller="Equipment" asp-action="Upsert" class="flex items-center space-x-2 px-5 py-2.5 bg-primary text-white rounded-xl font-headline font-bold text-sm shadow-lg shadow-primary/20 hover:bg-[#5a4b7b] hover:-translate-y-0.5 transition-all">
                <span class="material-symbols-outlined text-sm">add</span>
                <span>@Localizer["Equipment_RegisterAssetBtn"]</span>
            </a>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-outline-variant/30 flex flex-col justify-between">
            <div class="flex items-center justify-between mb-4">
                <div class="p-2 bg-primary-fixed text-primary rounded-lg">
                    <span class="material-symbols-outlined">inventory_2</span>
                </div>
                <span class="text-[10px] font-bold text-outline uppercase tracking-widest">@Localizer["Equipment_GlobalAssets"]</span>
            </div>
            <div>
                <span class="text-3xl font-black font-headline text-on-surface">@totalAssets</span>
                <div class="flex items-center mt-1 text-on-surface-variant text-xs font-medium">
                    <span>@Localizer["Equipment_RegisteredInFleet"]</span>
                </div>
            </div>
        </div>

        <div class="bg-white p-6 rounded-2xl shadow-sm border border-outline-variant/30 flex flex-col justify-between">
            <div class="flex items-center justify-between mb-4">
                <div class="p-2 bg-emerald-100 text-emerald-700 rounded-lg">
                    <span class="material-symbols-outlined">check_circle</span>
                </div>
                <span class="text-[10px] font-bold text-outline uppercase tracking-widest">@Localizer["Equipment_OperationalStatus"]</span>
            </div>
            <div>
                <span class="text-3xl font-black font-headline text-on-surface">@operationalPercentage.ToString("0.0")%</span>
                <p class="text-on-surface-variant text-xs mt-1 font-medium">@operationalAssets @Localizer["Equipment_ActiveUnits"]</p>
            </div>
        </div>

        <div class="bg-white p-6 rounded-2xl shadow-sm border border-outline-variant/30 flex flex-col justify-between">
            <div class="flex items-center justify-between mb-4">
                <div class="p-2 bg-amber-100 text-amber-700 rounded-lg">
                    <span class="material-symbols-outlined">build</span>
                </div>
                <span class="text-[10px] font-bold text-outline uppercase tracking-widest">@Localizer["Equipment_MaintenanceStatus"]</span>
            </div>
            <div>
                <span class="text-3xl font-black font-headline text-on-surface">@maintenanceAssets</span>
                <div class="flex items-center mt-1 text-amber-600 text-xs font-bold">
                    <span class="material-symbols-outlined text-xs mr-1">warning</span>
                    <span>@Localizer["Equipment_RequireAttention"]</span>
                </div>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-t-3xl shadow-sm border border-outline-variant/30 overflow-hidden">
        <div class="p-6 bg-surface-container-lowest border-b border-outline-variant/20 flex flex-wrap items-center gap-4">
            <div class="flex items-center space-x-2 bg-surface-container-low px-4 py-2 rounded-xl border border-outline-variant/20">
                <span class="material-symbols-outlined text-outline text-lg">category</span>
                <span class="text-sm font-headline font-semibold text-on-surface">@Localizer["Equipment_AllTypes"]</span>
            </div>
            <div class="flex items-center space-x-2 bg-surface-container-low px-4 py-2 rounded-xl border border-outline-variant/20">
                <span class="material-symbols-outlined text-outline text-lg">verified</span>
                <span class="text-sm font-headline font-semibold text-on-surface">@Localizer["Equipment_AllStatuses"]</span>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table id="equipmentTable" class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-surface-container-low/30">
                        <th class="px-6 py-5 text-[10px] font-black tracking-widest uppercase text-outline font-label">@Localizer["Equipment_TableAssetSN"]</th>
                        <th class="px-6 py-5 text-[10px] font-black tracking-widest uppercase text-outline font-label">@Localizer["Equipment_TableCategory"]</th>
                        <th class="px-6 py-5 text-[10px] font-black tracking-widest uppercase text-outline font-label">@Localizer["Equipment_TableLocation"]</th>
                        <th class="px-6 py-5 text-[10px] font-black tracking-widest uppercase text-outline font-label">@Localizer["Equipment_TableStatus"]</th>
                        <th class="px-6 py-5 text-[10px] font-black tracking-widest uppercase text-outline font-label">@Localizer["Equipment_TableNextMaintenance"]</th>
                        <th class="px-6 py-5 text-[10px] font-black tracking-widest uppercase text-outline font-label text-right no-export">@Localizer["Equipment_TableActions"]</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-outline-variant/10">

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="px-6 py-12 text-center text-on-surface-variant">
                                <span class="material-symbols-outlined text-4xl mb-2 opacity-50">inventory_2</span>
                                <p class="font-medium">@Localizer["Equipment_NoAssets"]</p>
                            </td>
                        </tr>
                    }

                    @foreach (var obj in Model.OrderBy(u => u.CinemaHall?.Name))
                    {
                        string typeStr = obj.Type.ToString().ToLower();
                        string icon = "developer_board";
                        if (typeStr.Contains("visual") || typeStr.Contains("projector") || typeStr.Contains("screen")) icon = "videocam";
                        else if (typeStr.Contains("audio") || typeStr.Contains("sound") || typeStr.Contains("speaker")) icon = "volume_up";
                        else if (typeStr.Contains("seat") || typeStr.Contains("chair")) icon = "chair";
                        else if (typeStr.Contains("hvac") || typeStr.Contains("ac")) icon = "ac_unit";

                        <tr class="group hover:bg-primary-fixed/5 transition-colors">
                            <td class="px-6 py-5">
                                <div class="flex items-center space-x-4">
                                    <div class="w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center text-primary shadow-sm border border-outline-variant/20 group-hover:scale-105 transition-transform">
                                        <span class="material-symbols-outlined">@icon</span>
                                    </div>
                                    <div>
                                        <p class="font-headline font-bold text-on-surface text-sm asset-name-cell">@obj.Name</p>
                                        <p class="text-[11px] text-outline font-mono mt-0.5 asset-sn-cell">SN: @(obj.SerialNumber ?? "N/A")</p>
                                    </div>
                                </div>
                            </td>

                            <td class="px-6 py-5">
                                <span class="px-3 py-1.5 bg-surface-container border border-outline-variant/30 text-on-surface-variant text-[10px] font-extrabold rounded-md uppercase tracking-widest category-cell">
                                    @obj.Type.ToString()
                                </span>
                            </td>

                            <td class="px-6 py-5">
                                <p class="text-sm font-bold font-headline text-on-surface location-cell">@(obj.CinemaHall?.Name ?? Localizer["Equipment_Unassigned"].Value)</p>
                                <p class="text-[10px] text-outline font-bold uppercase tracking-widest mt-0.5">@Localizer["Equipment_InstalledLabel"]</p>
                            </td>

                            <td class="px-6 py-5">
                                @if (obj.Status.ToString() == "Operational")
                                {
                                    <div class="flex items-center space-x-2 text-emerald-600 status-cell" data-status="Operational">
                                        <span class="w-2 h-2 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.5)]"></span>
                                        <span class="text-xs font-bold uppercase tracking-wider">@Localizer["Equipment_OperationalStatus"]</span>
                                    </div>
                                }
                                else if (obj.Status.ToString() == "NeedsMaintenance")
                                {
                                    <div class="flex items-center space-x-2 text-amber-600 status-cell" data-status="Needs Maintenance">
                                        <span class="w-2 h-2 rounded-full bg-amber-500 shadow-[0_0_8px_rgba(245,158,11,0.5)] animate-pulse"></span>
                                        <span class="text-xs font-bold uppercase tracking-wider">@Localizer["Equipment_MaintenanceStatus"]</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="flex items-center space-x-2 text-error status-cell" data-status="@obj.Status.ToString()">
                                        <span class="w-2 h-2 rounded-full bg-error shadow-[0_0_8px_rgba(186,26,26,0.5)]"></span>
                                        <span class="text-xs font-bold uppercase tracking-wider">@obj.Status.ToString()</span>
                                    </div>
                                }
                            </td>

                            <td class="px-6 py-5 text-sm text-on-surface-variant font-medium next-maint-cell">
                                @(obj.NextMaintenanceDate.HasValue ? obj.NextMaintenanceDate.Value.ToString("MMM dd, yyyy") : Localizer["Equipment_Unscheduled"].Value)
                            </td>

                            <td class="px-6 py-5 text-right no-export">
                                <div class="flex items-center justify-end space-x-2 opacity-70 group-hover:opacity-100 transition-opacity">
                                    <a asp-controller="Equipment" asp-action="Upsert" asp-route-id="@obj.Id" class="p-2 text-outline hover:text-primary hover:bg-primary-fixed/50 rounded-lg transition-colors border border-transparent hover:border-primary/20" title="Edit">
                                        <span class="material-symbols-outlined text-lg">edit_square</span>
                                    </a>
                                    <button onClick="Delete('/Admin/Equipment/DeleteAjax/@obj.Id')" class="p-2 text-outline hover:text-error hover:bg-error/10 rounded-lg transition-colors border border-transparent hover:border-error/20" title="Delete">
                                        <span class="material-symbols-outlined text-lg">delete</span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="px-6 py-4 bg-surface-container-low/30 border-t border-outline-variant/20 rounded-b-3xl">
            <p class="text-xs text-outline font-medium">@Localizer["Equipment_ShowingFleetOf"] <span class="font-bold text-on-surface">@totalAssets</span> @Localizer["Equipment_AssetsCountLabel"]</p>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        const titleText = '@Localizer["Equipment_JS_ConfirmDeleteTitle"]';
        const bodyText = '@Localizer["Equipment_JS_ConfirmDeleteText"]';
        const confirmBtn = '@Localizer["Equipment_JS_ConfirmDeleteBtn"]';
        const errorText = '@Localizer["Equipment_JS_Error"]';
        const networkErrorText = '@Localizer["Equipment_JS_NetworkError"]';

        function Delete(url) {
            Swal.fire({
                title: titleText,
                text: bodyText,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#a8364b',
                cancelButtonColor: '#615e67',
                confirmButtonText: confirmBtn,
                background: '#ffffff',
                customClass: {
                    title: 'font-headline font-bold text-[#1a1c1c]',
                    popup: 'rounded-2xl shadow-2xl border border-[#cbc4cf]/30'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch(url, {
                        method: 'DELETE'
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            location.reload();
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: errorText,
                                text: data.message,
                                confirmButtonColor: '#665788'
                            });
                        }
                    })
                    .catch(error => {
                        Swal.fire('Network Error', networkErrorText, 'error');
                    });
                }
            });
        }

        document.getElementById('exportReportBtn').addEventListener('click', function () {

            let csvContent = "Asset Name,Serial Number,Category,Location,Status,Next Maintenance\n";

            let rows = document.querySelectorAll("#equipmentTable tbody tr.group");

            rows.forEach(function (row) {
                let name = row.querySelector('.asset-name-cell').innerText.trim();
                let snRaw = row.querySelector('.asset-sn-cell').innerText.trim();
                let sn = snRaw.replace('SN: ', '');
                let category = row.querySelector('.category-cell').innerText.trim();
                let location = row.querySelector('.location-cell').innerText.trim();

                let statusCell = row.querySelector('.status-cell');
                let status = statusCell ? statusCell.getAttribute('data-status') : "Unknown";

                let nextMaint = row.querySelector('.next-maint-cell').innerText.trim();

                let rowData = `"${name}","${sn}","${category}","${location}","${status}","${nextMaint}"`;
                csvContent += rowData + "\n";
            });

            let blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            let url = URL.createObjectURL(blob);
            let link = document.createElement("a");

            let d = new Date();
            let dateString = d.getFullYear() + "-" + ("0"+(d.getMonth()+1)).slice(-2) + "-" + ("0" + d.getDate()).slice(-2);

            link.setAttribute("href", url);
            link.setAttribute("download", "Equipment_Report_" + dateString + ".csv");
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);

            toastr.success('Report downloaded successfully!', 'Export Complete');
        });
    </script>
}