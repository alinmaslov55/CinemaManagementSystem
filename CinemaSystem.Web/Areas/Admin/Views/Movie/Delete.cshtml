@model CinemaSystem.Models.Entities.Movie
@using CinemaSystem.Models.Data.Enums

@{
    ViewData["Title"] = "Archive Movie";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<main class="flex-1 p-8 flex justify-center items-start">
    <div class="w-full max-w-3xl mt-8">

        <nav class="flex text-sm text-on-surface-variant mb-6 gap-2 font-label items-center uppercase tracking-wider font-bold">
            <a asp-action="Index" class="hover:text-primary transition-colors">Movie Management</a>
            <span class="material-symbols-outlined text-[16px]">chevron_right</span>
            <span class="text-amber-600 font-semibold">Archive Record</span>
        </nav>

        <div class="bg-amber-50 border border-amber-200 p-6 rounded-2xl mb-8 flex items-start gap-4 shadow-sm">
            <div class="bg-amber-100 p-2 rounded-full text-amber-700 flex-shrink-0">
                <span class="material-symbols-outlined text-3xl">archive</span>
            </div>
            <div>
                <h2 class="text-xl font-extrabold text-amber-800 font-headline mb-1">Archive Movie Catalog</h2>
                <p class="text-amber-800/80 text-sm font-medium leading-relaxed">
                    You are about to archive the movie <strong>"@Model.Title"</strong>. This will hide the movie and its upcoming showtimes from the public catalog. <strong>Historical data, revenue, and past tickets will remain safely stored for reporting.</strong>
                </p>
            </div>
        </div>

        <div class="bg-white rounded-3xl shadow-lg border border-outline-variant/20 p-8 flex flex-col md:flex-row gap-8 items-center md:items-start relative overflow-hidden">

            <div class="absolute -right-20 -top-20 opacity-5 pointer-events-none">
                <span class="material-symbols-outlined text-[300px]">inventory_2</span>
            </div>

            <div class="w-40 h-60 rounded-xl overflow-hidden shadow-md flex-shrink-0 bg-surface-container border border-outline-variant/30 z-10">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" class="w-full h-full object-cover grayscale opacity-80" alt="@Model.Title" />
                }
                else
                {
                    <div class="w-full h-full flex flex-col items-center justify-center text-outline">
                        <span class="material-symbols-outlined text-4xl mb-2">hide_image</span>
                    </div>
                }
            </div>

            <div class="flex-1 w-full z-10">
                <div class="flex gap-2 mb-3">
                    <span class="px-2.5 py-1 bg-surface-container text-on-surface-variant text-[10px] font-bold rounded uppercase tracking-widest border border-outline-variant/30">
                        @Model.MovieCategory
                    </span>
                    <span class="px-2.5 py-1 bg-surface-container text-on-surface-variant text-[10px] font-bold rounded uppercase tracking-widest border border-outline-variant/30">
                        @Model.AgeRating
                    </span>
                </div>

                <h3 class="text-3xl font-extrabold text-on-surface font-headline mb-4">@Model.Title</h3>

                <div class="grid grid-cols-2 gap-y-4 gap-x-8 mt-6">
                    <div>
                        <p class="text-[10px] uppercase tracking-widest text-outline font-bold mb-1">Duration</p>
                        <p class="text-sm font-semibold text-on-surface-variant flex items-center gap-1.5">
                            <span class="material-symbols-outlined text-[16px]">schedule</span>
                            @Model.DurationInMinutes Minutes
                        </p>
                    </div>
                    <div>
                        <p class="text-[10px] uppercase tracking-widest text-outline font-bold mb-1">Ticket Price</p>
                        <p class="text-sm font-semibold text-on-surface-variant flex items-center gap-1.5">
                            <span class="material-symbols-outlined text-[16px]">payments</span>
                            $@Model.Price.ToString("F2")
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <form method="post" asp-action="Delete" class="mt-8 flex items-center justify-end gap-4 border-t border-outline-variant/30 pt-6">
            <input asp-for="Id" hidden />

            <a asp-action="Index" class="px-8 py-3 rounded-xl font-bold text-on-surface-variant hover:bg-surface-container-high transition-colors font-label">
                Cancel
            </a>

            <button type="submit" class="px-10 py-3 rounded-xl bg-amber-600 hover:bg-amber-700 text-white font-bold shadow-lg shadow-amber-600/20 active:scale-95 transition-all font-label flex items-center gap-2">
                <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">archive</span>
                Confirm Archive
            </button>
        </form>

    </div>
</main>