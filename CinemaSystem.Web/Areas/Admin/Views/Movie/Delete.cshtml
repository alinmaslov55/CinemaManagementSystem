@model CinemaSystem.Models.Entities.Movie
@using CinemaSystem.Models.Data.Enums

@{
    ViewData["Title"] = "Delete Movie";
    // OBJECTIVE FIX: Izolăm de layout-ul public
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"] - CineAdmin</title>
    
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    
    <script id="tailwind-config">
        tailwind.config = {
        darkMode: "class",
        theme: {
        extend: {
        colors: {
        "primary": "#665788",
        "primary-container": "#d8c6ff",
        "primary-fixed": "#eaddff",
        "secondary": "#645b71",
        "tertiary": "#7d516e",
        "surface": "#fdf8fd",
        "surface-container-low": "#f7f2f9",
        "surface-container": "#f1ecf4",
        "on-surface": "#343139",
        "on-surface-variant": "#615e67",
        "outline": "#7d7982",
        "outline-variant": "#b5b0ba",
        "error": "#a8364b",
        "error-container": "#f97386"
        },
        fontFamily: {
        "headline": ["Manrope", "sans-serif"],
        "body": ["Inter", "sans-serif"],
        "label": ["Inter", "sans-serif"]
        }
        }
        }
        }
    </script>
    <style>
        .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        vertical-align: middle;
        }
    </style>
</head>
<body class="bg-surface text-on-surface antialiased font-body">

    <aside class="flex flex-col h-screen fixed left-0 z-[60] bg-[#8675A9] font-headline text-sm w-64 border-r border-white/10 shadow-xl">
        <div class="p-6">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-white/20 flex items-center justify-center">
                    <span class="material-symbols-outlined text-white" style="font-variation-settings: 'FILL' 1;">theater_comedy</span>
                </div>
                <div>
                    <h1 class="text-2xl font-black text-white leading-none">CineAdmin</h1>
                    <p class="text-white/60 text-[10px] uppercase tracking-wider mt-1">Management Portal</p>
                </div>
            </div>
        </div>
        <nav class="flex-1 mt-4 space-y-1 overflow-y-auto">
            <a asp-controller="Dashboard" asp-action="Index" class="text-white/60 hover:text-white mx-2 px-4 py-3 hover:bg-white/10 rounded-lg transition-all flex items-center gap-3">
                <span class="material-symbols-outlined">dashboard</span> Dashboard
            </a>
            <a href="#" class="text-white/60 hover:text-white mx-2 px-4 py-3 hover:bg-white/10 rounded-lg transition-all flex items-center gap-3">
                <span class="material-symbols-outlined">theater_comedy</span> Cinemas
            </a>
            
            <a asp-controller="Movie" asp-action="Index" class="bg-white/20 text-white font-semibold rounded-lg mx-2 px-4 py-3 flex items-center gap-3 transition-all">
                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">movie</span> Movies
            </a>
            
            <a href="#" class="text-white/60 hover:text-white mx-2 px-4 py-3 hover:bg-white/10 rounded-lg transition-all flex items-center gap-3">
                <span class="material-symbols-outlined">schedule</span> Showtimes
            </a>
            <a asp-controller="Equipment" asp-action="Index" class="text-white/60 hover:text-white mx-2 px-4 py-3 hover:bg-white/10 rounded-lg transition-all flex items-center gap-3">
                <span class="material-symbols-outlined">settings_input_component</span> Equipment
            </a>
        </nav>
        <div class="p-4 border-t border-white/10">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="text-white/60 hover:text-white mx-2 px-4 py-3 hover:bg-white/10 rounded-lg transition-all flex items-center gap-3">
                <span class="material-symbols-outlined">public</span> Public Site
            </a>
        </div>
    </aside>

    <header class="fixed top-0 w-full z-50 bg-[#8675A9] border-b border-white/10 shadow-sm flex justify-between items-center h-16 px-6 ml-64 pr-[288px]">
        <div class="flex items-center gap-4">
            <div class="relative opacity-50 pointer-events-none">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-white/50">search</span>
                <input class="bg-white/10 border-none rounded-full pl-10 pr-4 py-1.5 text-sm text-white w-64" disabled type="text" />
            </div>
        </div>
        <div class="flex items-center gap-4 pr-64">
            <button class="text-white/70 hover:bg-white/10 p-2 rounded-full transition-colors relative">
                <span class="material-symbols-outlined">notifications</span>
            </button>
            <div class="h-8 w-px bg-white/10 mx-2"></div>
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full border border-white/20 bg-white/20 flex items-center justify-center text-white font-bold text-xs">AD</div>
                <span class="text-white font-medium text-sm">Admin Terminal</span>
            </div>
        </div>
    </header>

    <main class="ml-64 pt-24 pb-12 px-8 min-h-screen bg-surface flex justify-center items-start">
        
        <div class="w-full max-w-3xl mt-8">
            
            <nav class="flex text-sm text-on-surface-variant mb-6 gap-2 font-label items-center">
                <a asp-action="Index" class="hover:text-primary transition-colors">Movie Management</a>
                <span class="material-symbols-outlined text-[16px]">chevron_right</span>
                <span class="text-error font-semibold">Delete Record</span>
            </nav>

            <div class="bg-[#f97386]/10 border border-[#f97386]/30 p-6 rounded-2xl mb-8 flex items-start gap-4 shadow-sm">
                <div class="bg-[#f97386]/20 p-2 rounded-full text-[#a8364b] flex-shrink-0">
                    <span class="material-symbols-outlined text-3xl">warning</span>
                </div>
                <div>
                    <h2 class="text-xl font-extrabold text-[#a8364b] font-headline mb-1">Confirm Permanent Deletion</h2>
                    <p class="text-[#a8364b]/80 text-sm font-medium leading-relaxed">
                        You are about to permanently delete the movie <strong>"@Model.Title"</strong> from the database. This action will also cascade and delete all associated showtimes, tickets, and revenue data. This cannot be undone.
                    </p>
                </div>
            </div>

            <div class="bg-white rounded-3xl shadow-lg border border-outline-variant/20 p-8 flex flex-col md:flex-row gap-8 items-center md:items-start relative overflow-hidden">
                
                <div class="absolute -right-20 -top-20 opacity-5 pointer-events-none">
                    <span class="material-symbols-outlined text-[300px]">movie</span>
                </div>

                <div class="w-40 h-60 rounded-xl overflow-hidden shadow-md flex-shrink-0 bg-surface-container border border-outline-variant/30 z-10">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" class="w-full h-full object-cover" alt="@Model.Title" />
                    }
                    else
                    {
                        <div class="w-full h-full flex flex-col items-center justify-center text-outline">
                            <span class="material-symbols-outlined text-4xl mb-2">hide_image</span>
                        </div>
                    }
                </div>

                <div class="flex-1 w-full z-10">
                    <div class="flex gap-2 mb-3">
                        <span class="px-2.5 py-1 bg-surface-container text-on-surface-variant text-[10px] font-bold rounded uppercase tracking-widest border border-outline-variant/30">
                            @Model.MovieCategory
                        </span>
                        <span class="px-2.5 py-1 bg-surface-container text-on-surface-variant text-[10px] font-bold rounded uppercase tracking-widest border border-outline-variant/30">
                            @Model.AgeRating
                        </span>
                    </div>
                    
                    <h3 class="text-3xl font-extrabold text-on-surface font-headline mb-4">@Model.Title</h3>
                    
                    <div class="grid grid-cols-2 gap-y-4 gap-x-8 mt-6">
                        <div>
                            <p class="text-[10px] uppercase tracking-widest text-outline font-bold mb-1">Duration</p>
                            <p class="text-sm font-semibold text-on-surface-variant flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-[16px]">schedule</span>
                                @Model.DurationInMinutes Minutes
                            </p>
                        </div>
                        <div>
                            <p class="text-[10px] uppercase tracking-widest text-outline font-bold mb-1">Ticket Price</p>
                            <p class="text-sm font-semibold text-on-surface-variant flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-[16px]">payments</span>
                                $@Model.Price.ToString("F2")
                            </p>
                        </div>
                        <div>
                            <p class="text-[10px] uppercase tracking-widest text-outline font-bold mb-1">Release Date</p>
                            <p class="text-sm font-semibold text-on-surface-variant flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-[16px]">calendar_month</span>
                                @Model.StartDate.ToString("MMM dd, yyyy")
                            </p>
                        </div>
                        <div>
                            <p class="text-[10px] uppercase tracking-widest text-outline font-bold mb-1">Status</p>
                            <p class="text-sm font-semibold flex items-center gap-1.5 @(Model.IsReleased ? "text-emerald-600" : "text-amber-600")">
                                <span class="material-symbols-outlined text-[16px]">@(Model.IsReleased ? "check_circle" : "pending")</span>
                                @(Model.IsReleased ? "Released" : "Upcoming")
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <form method="post" class="mt-8 flex items-center justify-end gap-4 border-t border-outline-variant/30 pt-6">
                <input asp-for="Id" hidden />
                
                <a asp-action="Index" class="px-8 py-3 rounded-xl font-bold text-on-surface-variant hover:bg-surface-container-high transition-colors font-label">
                    Cancel & Keep Movie
                </a>
                
                <button type="submit" class="px-10 py-3 rounded-xl bg-[#a8364b] hover:bg-[#8b2b3d] text-white font-bold shadow-lg shadow-[#a8364b]/20 active:scale-95 transition-all font-label flex items-center gap-2">
                    <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">delete_forever</span>
                    Yes, Delete Movie
                </button>
            </form>

        </div>
    </main>

</body>
</html>