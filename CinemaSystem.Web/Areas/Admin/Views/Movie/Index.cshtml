@using CinemaSystem.Models.Entities
@using CinemaSystem.Models.Data.Enums
@using Microsoft.Extensions.Localization
@using CinemaSystem.Utility
@model IEnumerable<Movie>
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["Movie_ManagementTitle"];
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<main class="pt-10 px-8 pb-12 max-w-[1600px] mx-auto min-h-screen">

    <div class="flex justify-between items-end mb-10">
        <div class="space-y-1">
            <h1 class="text-4xl font-extrabold font-headline tracking-tight text-on-surface">@Localizer["Movie_ManagementTitle"]</h1>
            <p class="text-on-surface-variant font-body">@Localizer["Movie_ManagementSubtitle"]</p>
        </div>
        <a asp-action="Upsert" class="bg-gradient-to-br from-primary to-primary-container text-white px-6 py-3 rounded-xl shadow-md hover:shadow-lg hover:-translate-y-0.5 transition-all flex items-center space-x-2 font-headline font-bold text-sm">
            <span class="material-symbols-outlined text-lg">add_circle</span>
            <span>@Localizer["Movie_AddNewBtn"]</span>
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 mb-8">

        <div class="md:col-span-8 bg-white p-6 rounded-2xl border border-outline-variant/20 shadow-sm flex flex-wrap items-center gap-4">
            <form method="get" asp-action="Index" class="flex flex-wrap items-end gap-4 w-full m-0">

                <div class="flex-1 min-w-[180px]">
                    <label class="block text-[10px] font-bold uppercase tracking-widest text-outline mb-1.5">@Localizer["Movie_FilterByGenre"]</label>
                    <select name="category" asp-items="Html.GetEnumSelectList<MovieCategory>()" class="w-full bg-surface border border-outline-variant/30 rounded-xl text-sm py-2.5 px-3 focus:ring-2 focus:ring-primary/30 outline-none">
                        <option value="">@Localizer["Movie_AllGenres"]</option>
                    </select>
                    @if (ViewBag.CurrentCategory != null)
                    {
                        <script>
                                                document.addEventListener("DOMContentLoaded", function() {
                                                    document.querySelector('select[name="category"]').value = "@((int)ViewBag.CurrentCategory)";
                                                });
                        </script>
                    }
                </div>

                <div class="flex-1 min-w-[180px]">
                    <label class="block text-[10px] font-bold uppercase tracking-widest text-outline mb-1.5">@Localizer["Movie_ReleaseStatus"]</label>
                    <select name="releaseStatus" class="w-full bg-surface border border-outline-variant/30 rounded-xl text-sm py-2.5 px-3 focus:ring-2 focus:ring-primary/30 outline-none">
                        <option value="All Movies" selected="@(ViewBag.CurrentReleaseStatus == "All Movies")">@Localizer["Movie_AllMovies"]</option>
                        <option value="Now Showing" selected="@(ViewBag.CurrentReleaseStatus == "Now Showing")">@Localizer["Movie_NowShowing"]</option>
                        <option value="Upcoming" selected="@(ViewBag.CurrentReleaseStatus == "Upcoming")">@Localizer["Movie_Upcoming"]</option>
                    </select>
                </div>

                <div class="flex gap-2">
                    <button type="submit" class="px-5 py-2.5 bg-primary text-white border border-primary rounded-xl hover:bg-primary/90 text-sm font-bold transition-colors">
                        @Localizer["Button_Filter"]
                    </button>
                    <a asp-action="Index" class="px-5 py-2.5 text-primary border border-outline-variant/30 rounded-xl hover:bg-primary-fixed/30 text-sm font-bold transition-colors flex items-center justify-center">
                        @Localizer["Button_Reset"]
                    </a>
                </div>

            </form>
        </div>

        <div class="md:col-span-4 grid grid-cols-2 gap-4">
            <div class="bg-primary/5 p-5 rounded-2xl flex flex-col justify-center border border-primary/10">
                <span class="text-primary font-black text-3xl font-headline">@Model.Count()</span>
                <span class="text-[10px] uppercase font-bold tracking-widest text-primary/70 mt-1">@Localizer["Movie_TotalFilms"]</span>
            </div>
            <div class="bg-emerald-50 p-5 rounded-2xl flex flex-col justify-center border border-emerald-100">
                <span class="text-emerald-700 font-black text-3xl font-headline">@Model.Count(m => m.IsReleased)</span>
                <span class="text-[10px] uppercase font-bold tracking-widest text-emerald-700/70 mt-1">@Localizer["Movie_ActiveShowing"]</span>
            </div>
        </div>

    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-outline-variant/20 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-surface-container-low/50">
                        <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-[0.2em] text-outline">@Localizer["Movie_FilmPoster"]</th>
                        <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-[0.2em] text-outline">@Localizer["Movie_TitleAndID"]</th>
                        <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-[0.2em] text-outline">@Localizer["Movie_Genre"]</th>
                        <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-[0.2em] text-outline">@Localizer["Movie_Price"]</th>
                        <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-[0.2em] text-outline">@Localizer["Movie_Status"]</th>
                        <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-[0.2em] text-outline text-right">@Localizer["Movie_Actions"]</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-outline-variant/10">
                    @foreach (var obj in Model)
                    {
                        <tr class="hover:bg-primary-fixed/10 transition-colors group">
                            <td class="px-6 py-4">
                                <div class="w-12 h-16 rounded-lg overflow-hidden bg-surface-container shadow-sm border border-outline-variant/20 group-hover:scale-105 transition-transform">
                                    <img alt="@obj.Title" class="w-full h-full object-cover"
                                         src="@(string.IsNullOrEmpty(obj.ImageUrl) ? "https://via.placeholder.com/100x150" : obj.ImageUrl)" />
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex flex-col">
                                    <span class="font-bold text-on-surface font-headline text-sm">@obj.Title</span>
                                    <span class="text-[11px] text-outline font-mono uppercase mt-0.5">#MV-@obj.Id.ToString("D3")</span>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <span class="px-2.5 py-1 bg-surface-container text-on-surface-variant text-[10px] font-bold rounded-md uppercase tracking-widest border border-outline-variant/30">
                                    @obj.MovieCategory
                                </span>
                            </td>
                            <td class="px-6 py-4">
                                <span class="text-sm font-bold text-primary">$@obj.Price.ToString("F2")</span>
                            </td>
                            <td class="px-6 py-4">
                                @if (obj.IsReleased)
                                {
                                    <div class="flex items-center gap-1.5">
                                        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                                        <span class="text-xs font-bold text-emerald-700 uppercase tracking-widest">@Localizer["Movie_Available"]</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="flex items-center gap-1.5">
                                        <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                                        <span class="text-xs font-bold text-amber-700 uppercase tracking-widest">@Localizer["Movie_UpcomingStatus"]</span>
                                    </div>
                                }
                            </td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex justify-end space-x-2">
                                    <a asp-action="Upsert" asp-route-id="@obj.Id" title="@Localizer["Movie_EditTitle"]"
                                       class="p-2 text-outline hover:text-primary hover:bg-primary/10 rounded-lg transition-all flex items-center justify-center">
                                        <span class="material-symbols-outlined text-xl">edit_square</span>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@obj.Id" title="@Localizer["Movie_DeleteTitle"]"
                                       class="p-2 text-outline hover:text-error hover:bg-error/10 rounded-lg transition-all flex items-center justify-center">
                                        <span class="material-symbols-outlined text-xl">delete</span>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="px-6 py-4 bg-surface-container-low/30 border-t border-outline-variant/20 flex justify-between items-center">
            <p class="text-xs text-on-surface-variant font-medium">@Localizer["Movie_TotalCatalog"] @Model.Count()</p>
        </div>
    </div>
</main>