@using CinemaSystem.Models.Entities
@model IEnumerable<Movie>

@{
    ViewData["Title"] = "Movie Management";
    // OBJECTIVE FIX: Izolăm și această pagină de layout-ul public
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"] - Admin Terminal</title>
    
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200;300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#645485",
                        "primary-container": "#7d6c9f",
                        "primary-fixed": "#eaddff",
                        "secondary": "#69577a",
                        "tertiary": "#795061",
                        "surface": "#f9f9f9",
                        "surface-container-lowest": "#ffffff",
                        "surface-container-low": "#f3f3f3",
                        "on-surface": "#1a1c1c",
                        "on-surface-variant": "#49454e",
                        "outline": "#7a757f",
                        "outline-variant": "#cbc4cf",
                        "error": "#ba1a1a"
                    },
                    fontFamily: {
                        "headline": ["Manrope", "sans-serif"],
                        "body": ["Inter", "sans-serif"]
                    }
                }
            }
        }
    </script>
    <style>
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
        ::-webkit-scrollbar { height: 6px; width: 6px; }
        ::-webkit-scrollbar-track { background: #f3f3f3; }
        ::-webkit-scrollbar-thumb { background: #cbc4cf; border-radius: 10px; }
    </style>
</head>
<body class="bg-surface text-on-surface antialiased font-body">

    <aside class="h-full w-64 fixed left-0 top-0 bg-surface-container-low flex flex-col p-4 z-40 border-r border-outline-variant/30">
        <div class="mb-10 px-2 flex items-center gap-3 mt-2">
            <div class="w-10 h-10 bg-gradient-to-br from-primary to-primary-container rounded-xl flex items-center justify-center text-white shadow-md">
                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">movie_filter</span>
            </div>
            <div>
                <h1 class="text-lg font-bold text-primary font-headline leading-tight">Cinema Director</h1>
                <p class="text-[10px] uppercase tracking-widest text-primary opacity-70 font-bold">Global Operations</p>
            </div>
        </div>
        <nav class="flex-1 space-y-2">
            <a asp-controller="Dashboard" asp-action="Index" class="flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:text-primary hover:bg-primary-fixed/30 transition-colors font-headline tracking-tight rounded-xl">
                <span class="material-symbols-outlined">dashboard</span> Dashboard
            </a>
            <a href="#" class="flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:text-primary hover:bg-primary-fixed/30 transition-colors font-headline tracking-tight rounded-xl">
                <span class="material-symbols-outlined">theater_comedy</span> Cinemas
            </a>
            
            <a asp-controller="Movie" asp-action="Index" class="flex items-center gap-3 px-4 py-3 text-primary font-bold bg-primary-fixed/50 rounded-xl transition-colors font-headline tracking-tight shadow-sm border border-primary/10">
                <span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1;">movie</span> Movies
            </a>
            
            <a href="#" class="flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:text-primary hover:bg-primary-fixed/30 transition-colors font-headline tracking-tight rounded-xl">
                <span class="material-symbols-outlined">calendar_month</span> Showtimes
            </a>
            <a asp-controller="Equipment" asp-action="Index" class="flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:text-primary hover:bg-primary-fixed/30 transition-colors font-headline tracking-tight rounded-xl">
                <span class="material-symbols-outlined">construction</span> Equipment
            </a>
            <a asp-area="" asp-controller="Home" asp-action="Index" class="flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:text-primary hover:bg-primary-fixed/30 transition-colors font-headline tracking-tight rounded-xl mt-4 border border-outline-variant/30">
                <span class="material-symbols-outlined">public</span> Public Site
            </a>
        </nav>
        <div class="mt-auto pt-6 border-t border-outline-variant/30">
            <div class="flex items-center gap-3 px-2">
                <div class="w-10 h-10 rounded-full bg-primary-fixed flex justify-center items-center text-primary font-bold shadow-sm border border-primary/20">
                    AD
                </div>
                <div class="overflow-hidden">
                    <p class="text-sm font-bold text-on-surface truncate">Admin Terminal</p>
                    <p class="text-xs text-on-surface-variant truncate">System Access</p>
                </div>
            </div>
        </div>
    </aside>

    <header class="fixed top-0 right-0 w-[calc(100%-16rem)] z-30 bg-white/80 backdrop-blur-md shadow-sm border-b border-outline-variant/20 flex justify-between items-center px-8 h-20">
        <div class="flex items-center flex-1 max-w-md">
            <div class="relative w-full">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-sm">search</span>
                <input class="w-full pl-10 pr-4 py-2.5 bg-surface border border-outline-variant/30 rounded-full text-sm focus:ring-2 focus:ring-primary/50 transition-all font-body outline-none" placeholder="Search movies, directors, or IDs..." type="text"/>
            </div>
        </div>
        <div class="flex items-center gap-4 text-primary">
            <span class="text-lg font-black font-headline uppercase tracking-widest hidden md:block mr-4 text-primary/80">Admin Terminal</span>
            <button class="w-10 h-10 flex items-center justify-center hover:bg-primary-fixed/50 rounded-full transition-all duration-300"><span class="material-symbols-outlined">notifications</span></button>
            <button class="w-10 h-10 flex items-center justify-center hover:bg-primary-fixed/50 rounded-full transition-all duration-300"><span class="material-symbols-outlined">settings</span></button>
        </div>
    </header>

    <main class="ml-64 pt-28 px-8 pb-12 max-w-[1600px] mx-auto min-h-screen">
        
        <div class="flex justify-between items-end mb-10">
            <div class="space-y-1">
                <h1 class="text-4xl font-extrabold font-headline tracking-tight text-on-surface">Movie Management</h1>
                <p class="text-on-surface-variant font-body">Catalog, curate, and deploy film schedules across global networks.</p>
            </div>
            <a asp-action="Upsert" class="bg-gradient-to-br from-primary to-primary-container text-white px-6 py-3 rounded-xl shadow-md hover:shadow-lg hover:-translate-y-0.5 transition-all flex items-center space-x-2 font-headline font-bold text-sm">
                <span class="material-symbols-outlined text-lg">add_circle</span>
                <span>Add New Movie</span>
            </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-6 mb-8">
            <div class="md:col-span-8 bg-white p-6 rounded-2xl border border-outline-variant/20 shadow-sm flex flex-wrap items-center gap-4">
                <div class="flex-1 min-w-[180px]">
                    <label class="block text-[10px] font-bold uppercase tracking-widest text-outline mb-1.5">Filter by Genre</label>
                    <select class="w-full bg-surface border border-outline-variant/30 rounded-xl text-sm py-2.5 px-3 focus:ring-2 focus:ring-primary/30 outline-none">
                        <option>All Genres</option>
                        <option>Sci-Fi & Fantasy</option>
                        <option>Action</option>
                        <option>Drama</option>
                        <option>Thriller</option>
                    </select>
                </div>
                <div class="flex-1 min-w-[180px]">
                    <label class="block text-[10px] font-bold uppercase tracking-widest text-outline mb-1.5">Release Status</label>
                    <select class="w-full bg-surface border border-outline-variant/30 rounded-xl text-sm py-2.5 px-3 focus:ring-2 focus:ring-primary/30 outline-none">
                        <option>All Movies</option>
                        <option>Now Showing</option>
                        <option>Upcoming</option>
                    </select>
                </div>
                <button class="mt-5 px-5 py-2.5 text-primary border border-outline-variant/30 rounded-xl hover:bg-primary-fixed/30 text-sm font-bold transition-colors">
                    Reset
                </button>
            </div>
            <div class="md:col-span-4 grid grid-cols-2 gap-4">
                <div class="bg-primary/5 p-5 rounded-2xl flex flex-col justify-center border border-primary/10">
                    <span class="text-primary font-black text-3xl font-headline">@Model.Count()</span>
                    <span class="text-[10px] uppercase font-bold tracking-widest text-primary/70 mt-1">Total Films</span>
                </div>
                <div class="bg-emerald-50 p-5 rounded-2xl flex flex-col justify-center border border-emerald-100">
                    <span class="text-emerald-700 font-black text-3xl font-headline">@Model.Count(m => m.IsReleased)</span>
                    <span class="text-[10px] uppercase font-bold tracking-widest text-emerald-700/70 mt-1">Active (Showing)</span>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-outline-variant/20 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-surface-container-low/50">
                            <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-[0.2em] text-outline">Film Poster</th>
                            <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-[0.2em] text-outline">Title & ID</th>
                            <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-[0.2em] text-outline">Genre</th>
                            <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-[0.2em] text-outline">Price</th>
                            <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-[0.2em] text-outline">Status</th>
                            <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-[0.2em] text-outline text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-outline-variant/10">
                        @foreach (var obj in Model)
                        {
                            <tr class="hover:bg-primary-fixed/10 transition-colors group">
                                <td class="px-6 py-4">
                                    <div class="w-12 h-16 rounded-lg overflow-hidden bg-surface-container shadow-sm border border-outline-variant/20 group-hover:scale-105 transition-transform">
                                        <img alt="@obj.Title" class="w-full h-full object-cover" 
                                             src="@(string.IsNullOrEmpty(obj.ImageUrl) ? "https://via.placeholder.com/100x150" : obj.ImageUrl)" />
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="flex flex-col">
                                        <span class="font-bold text-on-surface font-headline text-sm">@obj.Title</span>
                                        <span class="text-[11px] text-outline font-mono uppercase mt-0.5">#MV-@obj.Id.ToString("D3")</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="px-2.5 py-1 bg-surface-container text-on-surface-variant text-[10px] font-bold rounded-md uppercase tracking-widest border border-outline-variant/30">
                                        @obj.MovieCategory
                                    </span>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="text-sm font-bold text-primary">$@obj.Price.ToString("F2")</span>
                                </td>
                                <td class="px-6 py-4">
                                    @if (obj.IsReleased)
                                    {
                                        <div class="flex items-center gap-1.5">
                                            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                                            <span class="text-xs font-bold text-emerald-700 uppercase tracking-widest">Available</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="flex items-center gap-1.5">
                                            <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                                            <span class="text-xs font-bold text-amber-700 uppercase tracking-widest">Upcoming</span>
                                        </div>
                                    }
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <div class="flex justify-end space-x-2">
                                        <a asp-action="Upsert" asp-route-id="@obj.Id" title="Edit Movie"
                                           class="p-2 text-outline hover:text-primary hover:bg-primary/10 rounded-lg transition-all flex items-center justify-center">
                                            <span class="material-symbols-outlined text-xl">edit_square</span>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@obj.Id" title="Delete Movie"
                                           class="p-2 text-outline hover:text-error hover:bg-error/10 rounded-lg transition-all flex items-center justify-center">
                                            <span class="material-symbols-outlined text-xl">delete</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            <div class="px-6 py-4 bg-surface-container-low/30 border-t border-outline-variant/20 flex justify-between items-center">
                <p class="text-xs text-on-surface-variant font-medium">Total catalog: @Model.Count() records</p>
            </div>
        </div>
    </main>

</body>
</html>