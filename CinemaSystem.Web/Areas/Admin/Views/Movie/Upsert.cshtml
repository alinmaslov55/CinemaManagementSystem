@model CinemaSystem.Models.Entities.Movie
@using CinemaSystem.Models.Data.Enums

@{
    ViewData["Title"] = Model.Id != 0 ? "Update Movie" : "Add New Movie";
    // OBJECTIVE FIX: Izolăm de layout-ul public
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"] - CineAdmin</title>
    
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    
    <script id="tailwind-config">
        tailwind.config = {
        darkMode: "class",
        theme: {
        extend: {
        colors: {
        "primary": "#665788",
        "primary-container": "#d8c6ff",
        "primary-fixed": "#eaddff",
        "secondary": "#645b71",
        "tertiary": "#7d516e",
        "surface": "#fdf8fd",
        "surface-container-low": "#f7f2f9",
        "surface-container": "#f1ecf4",
        "on-surface": "#343139",
        "on-surface-variant": "#615e67",
        "outline": "#7d7982",
        "outline-variant": "#b5b0ba",
        "error": "#a8364b"
        },
        fontFamily: {
        "headline": ["Manrope", "sans-serif"],
        "body": ["Inter", "sans-serif"],
        "label": ["Inter", "sans-serif"]
        }
        }
        }
        }
    </script>
    <style>
        .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        vertical-align: middle;
        }
        /* CSS pentru ascunderea input-ului file peste imagine */
        .file-upload-wrapper input[type="file"] {
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        cursor: pointer;
        z-index: 10;
        }
    </style>
</head>
<body class="bg-surface text-on-surface antialiased font-body">

    <aside class="flex flex-col h-screen fixed left-0 z-[60] bg-[#8675A9] font-headline text-sm w-64 border-r border-white/10 shadow-xl">
        <div class="p-6">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-white/20 flex items-center justify-center">
                    <span class="material-symbols-outlined text-white" style="font-variation-settings: 'FILL' 1;">theater_comedy</span>
                </div>
                <div>
                    <h1 class="text-2xl font-black text-white leading-none">CineAdmin</h1>
                    <p class="text-white/60 text-[10px] uppercase tracking-wider mt-1">Management Portal</p>
                </div>
            </div>
        </div>
        <nav class="flex-1 mt-4 space-y-1 overflow-y-auto">
            <a asp-controller="Dashboard" asp-action="Index" class="text-white/60 hover:text-white mx-2 px-4 py-3 hover:bg-white/10 rounded-lg transition-all flex items-center gap-3">
                <span class="material-symbols-outlined">dashboard</span> Dashboard
            </a>
            <a href="#" class="text-white/60 hover:text-white mx-2 px-4 py-3 hover:bg-white/10 rounded-lg transition-all flex items-center gap-3">
                <span class="material-symbols-outlined">theater_comedy</span> Cinemas
            </a>
            
            <a asp-controller="Movie" asp-action="Index" class="bg-white/20 text-white font-semibold rounded-lg mx-2 px-4 py-3 flex items-center gap-3 transition-all">
                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">movie</span> Movies
            </a>
            
            <a href="#" class="text-white/60 hover:text-white mx-2 px-4 py-3 hover:bg-white/10 rounded-lg transition-all flex items-center gap-3">
                <span class="material-symbols-outlined">schedule</span> Showtimes
            </a>
            <a asp-controller="Equipment" asp-action="Index" class="text-white/60 hover:text-white mx-2 px-4 py-3 hover:bg-white/10 rounded-lg transition-all flex items-center gap-3">
                <span class="material-symbols-outlined">settings_input_component</span> Equipment
            </a>
        </nav>
        <div class="p-4 border-t border-white/10">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="text-white/60 hover:text-white mx-2 px-4 py-3 hover:bg-white/10 rounded-lg transition-all flex items-center gap-3">
                <span class="material-symbols-outlined">public</span> Public Site
            </a>
        </div>
    </aside>

    <header class="fixed top-0 w-full z-50 bg-[#8675A9] border-b border-white/10 shadow-sm flex justify-between items-center h-16 px-6 ml-64 pr-[288px]">
        <div class="flex items-center gap-4">
            <div class="relative">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-white/50">search</span>
                <input class="bg-white/10 border-none rounded-full pl-10 pr-4 py-1.5 text-sm text-white placeholder:text-white/50 focus:ring-2 focus:ring-white/20 w-64 outline-none" placeholder="Search movies..." type="text" />
            </div>
        </div>
        <div class="flex items-center gap-4 pr-64">
            <button class="text-white/70 hover:bg-white/10 p-2 rounded-full transition-colors relative">
                <span class="material-symbols-outlined">notifications</span>
            </button>
            <div class="h-8 w-px bg-white/10 mx-2"></div>
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full border border-white/20 bg-white/20 flex items-center justify-center text-white font-bold text-xs">AD</div>
                <span class="text-white font-medium text-sm">Admin Terminal</span>
            </div>
        </div>
    </header>

    <main class="ml-64 pt-24 pb-12 px-8 min-h-screen bg-surface max-w-[1600px]">
        
        <div class="mb-8">
            <nav class="flex text-sm text-on-surface-variant mb-2 gap-2 font-label items-center">
                <a asp-action="Index" class="hover:text-primary transition-colors">Movie Management</a>
                <span class="material-symbols-outlined text-[16px]">chevron_right</span>
                <span class="text-primary font-semibold">@(Model.Id != 0 ? "Update Movie" : "Add New Movie")</span>
            </nav>
            <h2 class="text-3xl font-extrabold text-on-surface font-headline">@(Model.Id != 0 ? "Update" : "Add New") Movie</h2>
            <p class="text-on-surface-variant mt-1">Configure theatrical details, media assets, and categorization.</p>
        </div>

        <form method="post" enctype="multipart/form-data" class="grid grid-cols-12 gap-8">
            
            <input asp-for="Id" hidden />
            <input asp-for="ImageUrl" hidden />

            <div class="col-span-12 lg:col-span-8 space-y-8">
                
                <section class="bg-surface-container rounded-xl p-6 shadow-sm border border-outline-variant/20">
                    <div class="flex items-center gap-3 mb-6">
                        <span class="material-symbols-outlined text-primary">info</span>
                        <h3 class="text-lg font-bold font-headline">General Information</h3>
                    </div>
                    
                    <div class="grid grid-cols-2 gap-6">
                        <div class="col-span-2">
                            <label asp-for="Title" class="block text-sm font-semibold text-on-surface-variant mb-2 font-label">Movie Title <span class="text-error">*</span></label>
                            <input asp-for="Title" class="w-full bg-white border border-outline-variant rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-primary focus:border-primary transition-all outline-none" placeholder="e.g. The Celestial Echo" />
                            <span asp-validation-for="Title" class="text-error text-xs mt-1 block"></span>
                        </div>
                        
                        <div class="col-span-2">
                            <label asp-for="Description" class="block text-sm font-semibold text-on-surface-variant mb-2 font-label">Synopsis <span class="text-error">*</span></label>
                            <textarea asp-for="Description" class="w-full bg-white border border-outline-variant rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-primary focus:border-primary transition-all outline-none" placeholder="Enter a compelling synopsis..." rows="4"></textarea>
                            <span asp-validation-for="Description" class="text-error text-xs mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="DurationInMinutes" class="block text-sm font-semibold text-on-surface-variant mb-2 font-label">Duration (Min) <span class="text-error">*</span></label>
                            <input asp-for="DurationInMinutes" class="w-full bg-white border border-outline-variant rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-primary focus:border-primary transition-all outline-none" type="number" />
                            <span asp-validation-for="DurationInMinutes" class="text-error text-xs mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="Price" class="block text-sm font-semibold text-on-surface-variant mb-2 font-label">Ticket Price ($) <span class="text-error">*</span></label>
                            <input asp-for="Price" type="number" step="0.01" class="w-full bg-white border border-outline-variant rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-primary focus:border-primary transition-all outline-none" placeholder="0.00" />
                            <span asp-validation-for="Price" class="text-error text-xs mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="StartDate" class="block text-sm font-semibold text-on-surface-variant mb-2 font-label">Release Date <span class="text-error">*</span></label>
                            <input asp-for="StartDate" type="date" asp-format="{0:yyyy-MM-dd}" class="w-full bg-white border border-outline-variant rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-primary focus:border-primary transition-all outline-none" />
                            <span asp-validation-for="StartDate" class="text-error text-xs mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="EndDate" class="block text-sm font-semibold text-on-surface-variant mb-2 font-label">End Date <span class="text-error">*</span></label>
                            <input asp-for="EndDate" type="date" asp-format="{0:yyyy-MM-dd}" class="w-full bg-white border border-outline-variant rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-primary focus:border-primary transition-all outline-none" />
                            <span asp-validation-for="EndDate" class="text-error text-xs mt-1 block"></span>
                        </div>
                    </div>
                </section>

                <section class="bg-surface-container rounded-xl p-6 shadow-sm border border-outline-variant/20">
                    <div class="flex items-center gap-3 mb-6">
                        <span class="material-symbols-outlined text-primary">category</span>
                        <h3 class="text-lg font-bold font-headline">Categorization</h3>
                    </div>
                    <div class="grid grid-cols-2 gap-6">
                        <div>
                            <label asp-for="MovieCategory" class="block text-sm font-semibold text-on-surface-variant mb-2 font-label">Genre <span class="text-error">*</span></label>
                            <select asp-for="MovieCategory" asp-items="Html.GetEnumSelectList<MovieCategory>()" class="w-full bg-white border border-outline-variant rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-primary focus:border-primary transition-all outline-none cursor-pointer">
                                <option disabled selected>-- Select Genre --</option>
                            </select>
                            <span asp-validation-for="MovieCategory" class="text-error text-xs mt-1 block"></span>
                        </div>
                        <div>
                            <label asp-for="AgeRating" class="block text-sm font-semibold text-on-surface-variant mb-2 font-label">Content Rating <span class="text-error">*</span></label>
                            <select asp-for="AgeRating" asp-items="Html.GetEnumSelectList<AgeRating>()" class="w-full bg-white border border-outline-variant rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-primary focus:border-primary transition-all outline-none cursor-pointer">
                                <option disabled selected>-- Select Rating --</option>
                            </select>
                            <span asp-validation-for="AgeRating" class="text-error text-xs mt-1 block"></span>
                        </div>
                    </div>
                </section>

            </div>

            <div class="col-span-12 lg:col-span-4 space-y-8">
                
                <section class="bg-surface-container rounded-xl p-6 shadow-sm border border-outline-variant/20">
                    <div class="flex items-center gap-3 mb-6">
                        <span class="material-symbols-outlined text-primary">image</span>
                        <h3 class="text-lg font-bold font-headline">Media Assets</h3>
                    </div>
                    
                    <div class="space-y-6">
                        <div>
                            <label class="block text-sm font-semibold text-on-surface-variant mb-2 font-label">Poster Image</label>
                            
                            <div class="relative group rounded-xl overflow-hidden aspect-[2/3] shadow-lg bg-surface-variant border border-outline-variant/50 file-upload-wrapper">
                                <input type="file" name="file" accept=".jpg,.jpeg,.png,.webp" />
                                
                                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                {
                                    <img src="@Model.ImageUrl" class="w-full h-full object-cover" alt="Movie Poster" />
                                }
                                else
                                {
                                    <div class="w-full h-full flex flex-col items-center justify-center text-outline">
                                        <span class="material-symbols-outlined text-4xl mb-2">hide_image</span>
                                        <span class="text-sm font-medium">No Poster Available</span>
                                    </div>
                                }
                                
                                <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 flex flex-col items-center justify-center transition-opacity text-white">
                                    <span class="material-symbols-outlined text-4xl mb-2">upload</span>
                                    <span class="text-sm font-bold">Click to Upload</span>
                                </div>
                            </div>
                        </div>

                        <div>
                            <label asp-for="TrailerUrl" class="block text-sm font-semibold text-on-surface-variant mb-2 font-label">Trailer Link (YouTube)</label>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline/60">link</span>
                                <input asp-for="TrailerUrl" class="w-full bg-white border border-outline-variant rounded-lg pl-10 pr-4 py-2.5 focus:ring-2 focus:ring-primary focus:border-primary transition-all outline-none" placeholder="https://youtube.com/watch?v=..." />
                            </div>
                            <span asp-validation-for="TrailerUrl" class="text-error text-xs mt-1 block"></span>
                        </div>
                    </div>
                </section>

                <section class="bg-[#8675A9] text-white rounded-xl p-6 shadow-xl relative overflow-hidden">
                    <div class="absolute inset-0 opacity-10 pointer-events-none">
                        <svg height="100%" width="100%"><pattern height="20" id="grid" patternunits="userSpaceOnUse" width="20"><path d="M 20 0 L 0 0 0 20" fill="none" stroke="currentColor" stroke-width="0.5"></path></pattern><rect fill="url(#grid)" height="100%" width="100%"></rect></svg>
                    </div>
                    
                    <h3 class="text-lg font-bold font-headline mb-4 relative z-10">Admin Quick Actions</h3>
                    
                    <div class="space-y-4 relative z-10">
                        <div class="flex items-center justify-between">
                            <span class="text-sm font-medium">Visible in Gallery (Released)</span>
                            
                            <label class="relative inline-flex items-center cursor-pointer">
                                <input type="checkbox" asp-for="IsReleased" class="sr-only peer">
                                    <div class="w-11 h-6 bg-white/30 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-white/60"></div>
                                </label>
                            </div>
                        
                            <hr class="border-white/20 my-4" />
                        
                            <p class="text-[10px] text-white/70 italic leading-relaxed">
                                Changes will be reflected immediately across the public application network.
                            </p>
                        </div>
                    </section>

                </div>

                <div class="col-span-12 mt-6 flex items-center justify-end gap-4 border-t border-outline-variant/30 pt-8 pb-4">
                    <a asp-action="Index" class="px-8 py-2.5 rounded-lg font-bold text-on-surface-variant hover:bg-surface-container-high transition-colors font-label">
                        Cancel
                    </a>
                    <button type="submit" class="px-10 py-2.5 rounded-lg bg-primary text-white font-bold shadow-lg shadow-primary/20 hover:bg-[#5a4b7b] active:scale-95 transition-all font-label flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">save</span>
                        @(Model.Id != 0 ? "Save Changes" : "Publish Movie")
                    </button>
                </div>
            </form>
        </main>

        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    </body>
</html>