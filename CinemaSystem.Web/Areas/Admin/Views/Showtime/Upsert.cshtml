@using Microsoft.Extensions.Localization
@using CinemaSystem.Utility
@model CinemaSystem.Models.ViewModels.ShowtimeCalendarVM
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["Showtime_ScheduleTitle"];
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .calendar-grid {
        display: grid;
        grid-template-columns: 80px repeat(7, minmax(0, 1fr));
        grid-template-rows: auto repeat( @(Model.DayEndHour - Model.DayStartHour), 60px);
        background-color: #ffffff;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        border: 1px solid #cbc4cf40;
    }

    .calendar-slot:hover {
        background-color: #eaddff40;
        cursor: crosshair;
    }

    .showtime-block {
        position: relative;
        transition: all 0.2s ease;
        margin-left: 4px;
        margin-right: 4px;
    }

        .showtime-block:hover {
            transform: scale(1.02);
            z-index: 30 !important;
            box-shadow: 0 10px 15px -3px rgba(102, 87, 136, 0.4);
        }

    .custom-scroll::-webkit-scrollbar {
        width: 6px;
    }

    .custom-scroll::-webkit-scrollbar-track {
        background: transparent;
    }

    .custom-scroll::-webkit-scrollbar-thumb {
        background: #cbc4cf;
        border-radius: 10px;
    }

    .modal-enter {
        animation: modalFadeIn 0.2s ease-out forwards;
    }

    @Html.Raw("@keyframes modalFadeIn { from { opacity: 0; transform: scale(0.95); } to { opacity: 1; transform: scale(1); } }")
</style>

<main class="flex-1 flex flex-col p-8 max-w-[1600px] mx-auto w-full overflow-hidden">

    <div class="flex items-end justify-between mb-6 shrink-0">
        <div>
            <nav class="flex text-xs text-on-surface-variant mb-2 gap-2 font-label items-center uppercase tracking-wider font-bold">
                <a asp-action="Index" class="hover:text-primary transition-colors">@Localizer["Showtime_BreadcrumbShowtimes"]</a>
                <span class="material-symbols-outlined text-[16px]">chevron_right</span>
                <span class="text-primary font-bold">@Localizer["Showtime_BreadcrumbWeekly"]</span>
            </nav>
            <h1 class="text-3xl font-extrabold font-headline text-on-surface tracking-tight">@Model.Hall.Name</h1>
            <p class="text-on-surface-variant text-sm mt-1">@Model.Hall.Cinema.Name • <span class="uppercase font-bold text-[10px] tracking-widest bg-surface-container px-2 py-0.5 rounded">@Model.Hall.HallType</span></p>
        </div>

        <div class="flex items-center bg-white rounded-xl shadow-sm border border-outline-variant/30 p-1">
            <a asp-action="Upsert" asp-route-hallId="@Model.Hall.Id" asp-route-weekStart="@Model.PreviousWeekStart.ToString("yyyy-MM-dd")" class="p-2 hover:bg-surface-container rounded-lg text-outline hover:text-primary transition-colors flex items-center">
                <span class="material-symbols-outlined">chevron_left</span>
            </a>
            <div class="px-6 py-2 text-sm font-bold text-on-surface flex items-center gap-2 border-x border-outline-variant/10 mx-1">
                <span class="material-symbols-outlined text-[18px] text-primary">calendar_today</span>
                @Model.CurrentWeekStart.ToString("MMM dd") - @Model.CurrentWeekStart.AddDays(6).ToString("MMM dd, yyyy")
            </div>
            <a asp-action="Upsert" asp-route-hallId="@Model.Hall.Id" asp-route-weekStart="@Model.NextWeekStart.ToString("yyyy-MM-dd")" class="p-2 hover:bg-surface-container rounded-lg text-outline hover:text-primary transition-colors flex items-center">
                <span class="material-symbols-outlined">chevron_right</span>
            </a>
        </div>
    </div>

    <div class="flex-1 overflow-y-auto pr-2 pb-10 custom-scroll">
        <div class="calendar-grid relative">

            <div class="bg-surface-container-low border-b border-r border-outline-variant/20 sticky top-0 z-40"></div>
            @for (int i = 0; i < 7; i++)
            {
                var isToday = Model.CurrentWeekStart.AddDays(i).Date == DateTime.Today;
                <div class="text-center py-3 border-b border-r border-outline-variant/20 bg-surface-container-lowest sticky top-0 z-40 flex flex-col justify-center">
                    <div class="text-[11px] font-bold uppercase tracking-widest @(isToday ? "text-primary" : "text-outline")">
                        @Model.CurrentWeekStart.AddDays(i).ToString("ddd")
                    </div>
                    <div class="text-lg font-headline font-extrabold @(isToday ? "text-primary" : "text-on-surface")">
                        @Model.CurrentWeekStart.AddDays(i).ToString("dd")
                    </div>
                    @if (isToday)
                    {
                        <div class="h-1 w-8 bg-primary rounded-full mx-auto mt-1"></div>
                    }
                </div>
            }

            @for (int hour = Model.DayStartHour; hour < Model.DayEndHour; hour++)
            {
                <div class="text-right pr-4 text-xs font-semibold text-outline-variant border-b border-r border-outline-variant/20 flex flex-col justify-start pt-2 bg-surface-container-lowest/50" style="grid-row: @(hour - Model.DayStartHour + 2)">
                    @hour:00
                </div>

                @for (int day = 0; day < 7; day++)
                {
                    <div class="calendar-slot border-b border-r border-outline-variant/10 transition-colors"
                         style="grid-column: @(day + 2); grid-row: @(hour - Model.DayStartHour + 2)"
                         onclick="openAddModal(@day, @hour)">
                    </div>
                }
            }

            @foreach (var show in Model.WeeklyShowtimes)
            {
                var dayOffset = (show.StartTime.Date - Model.CurrentWeekStart.Date).Days;
                var hourOffset = show.StartTime.Hour - Model.DayStartHour;
                var minuteOffset = show.StartTime.Minute;
                var durationMinutes = (show.EndTime - show.StartTime).TotalMinutes;

                <div class="showtime-block bg-gradient-to-br from-primary to-primary-container text-white rounded-xl shadow-md p-3 overflow-hidden flex flex-col cursor-pointer"
                     onclick="event.stopPropagation(); openEditModal(@show.Id, @show.MovieId, '@show.StartTime.ToString("yyyy-MM-ddTHH:mm")', '@(show.Language ?? "")', '@(show.Price?.ToString() ?? "")')"
                     style="grid-column: @(dayOffset + 2); grid-row-start: @(hourOffset + 2); margin-top: @(minuteOffset)px; height: @(durationMinutes)px; z-index: 20;">

                    <div class="font-extrabold font-headline text-xs truncate leading-tight drop-shadow-sm">@show.Movie.Title</div>

                    <div class="text-[10px] text-white/90 font-medium mt-1 flex items-center gap-1">
                        <span class="material-symbols-outlined text-[12px]">schedule</span>
                        @show.StartTime.ToString("HH:mm") - @show.EndTime.ToString("HH:mm")
                    </div>

                    @if (!string.IsNullOrEmpty(show.Language) || show.Price.HasValue)
                    {
                        <div class="mt-auto pt-2 flex items-center gap-2">
                            @if (!string.IsNullOrEmpty(show.Language))
                            {
                                <span class="bg-white/20 text-white text-[8px] font-bold px-1.5 py-0.5 rounded uppercase tracking-widest">@show.Language</span>
                            }
                            @if (show.Price.HasValue)
                            {
                                <span class="bg-white/20 text-white text-[8px] font-bold px-1.5 py-0.5 rounded uppercase tracking-widest">$@show.Price</span>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</main>

<div id="tailwindModal" class="fixed inset-0 z-[100] hidden items-center justify-center">
    <div class="absolute inset-0 bg-[#1a1c1c]/60 backdrop-blur-sm" onclick="closeModal()"></div>

    <div class="relative bg-surface-container-lowest rounded-3xl shadow-2xl w-full max-w-md modal-enter flex flex-col overflow-visible">
        <div class="bg-primary px-6 py-5 flex justify-between items-center text-white border-b border-white/10 rounded-t-3xl">
            <h3 class="font-headline font-bold text-lg flex items-center gap-2">
                <span class="material-symbols-outlined text-xl">movie_filter</span>
                <span id="modalTitle">@Localizer["Showtime_ModalScheduleMovie"]</span>
            </h3>
            <button onclick="closeModal()" class="text-white/70 hover:text-white hover:bg-white/10 p-1.5 rounded-full transition-colors flex items-center justify-center">
                <span class="material-symbols-outlined text-sm">close</span>
            </button>
        </div>

        <div class="p-8 space-y-6">
            <input type="hidden" id="modalShowtimeId" value="0" />

            <div class="relative" id="customMovieDropdownWrapper">
                <label class="block text-[10px] font-bold uppercase tracking-widest text-outline mb-1.5 font-label">@Localizer["Showtime_SearchSelectMovie"] <span class="text-error">*</span></label>
                <input type="hidden" id="modalMovieId" value="" />

                <button type="button" id="movieSelectTrigger" class="w-full flex items-center justify-between rounded-xl border border-outline-variant/50 bg-surface-container-low px-4 py-3 text-sm focus:ring-2 focus:ring-primary/20 outline-none font-semibold text-on-surface-variant transition-colors hover:bg-surface-container">
                    <span id="movieSelectLabel" class="truncate">@Localizer["Showtime_ClickToSearch"]</span>
                    <span class="material-symbols-outlined text-outline">expand_more</span>
                </button>

                <div id="movieSelectMenu" class="absolute left-0 right-0 top-full mt-2 bg-surface-container-lowest border border-outline-variant/30 rounded-xl shadow-xl hidden flex-col overflow-hidden z-[110]">
                    <div class="p-2 border-b border-outline-variant/20 bg-surface-container-low">
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-sm">search</span>
                            <input type="text" id="movieSearchInput" class="w-full pl-9 pr-3 py-2 text-sm rounded-lg border-none bg-white focus:ring-2 focus:ring-primary/20 outline-none placeholder:text-outline-variant" placeholder="@Localizer["Showtime_TypeMovieTitle"]" autocomplete="off" />
                        </div>
                    </div>
                    <ul id="movieSelectList" class="max-h-48 overflow-y-auto custom-scroll p-1">
                        @foreach (var item in Model.MovieList)
                        {
                            <li class="movie-option px-3 py-2.5 text-sm font-semibold rounded-lg cursor-pointer hover:bg-primary-fixed hover:text-primary text-on-surface transition-colors" data-value="@item.Value" data-text="@item.Text">
                                @item.Text
                            </li>
                        }
                    </ul>
                </div>
            </div>

            <div>
                <label class="block text-[10px] font-bold uppercase tracking-widest text-outline mb-1.5 font-label">@Localizer["Showtime_StartTime"] <span class="text-error">*</span></label>
                <input type="datetime-local" id="modalStartTime" class="w-full rounded-xl border border-outline-variant/50 bg-surface-container-low px-4 py-3 text-sm focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none font-semibold cursor-pointer" />
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-[10px] font-bold uppercase tracking-widest text-outline mb-1.5 font-label">@Localizer["Showtime_AudioSubtitles"]</label>
                    <input type="text" id="modalLanguage" class="w-full rounded-xl border border-outline-variant/50 bg-surface-container-low px-4 py-3 text-sm focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none font-semibold" placeholder="@Localizer["Showtime_AudioPlaceholder"]" />
                </div>
                <div>
                    <label class="block text-[10px] font-bold uppercase tracking-widest text-outline mb-1.5 font-label">@Localizer["Showtime_PriceOverride"]</label>
                    <input type="number" id="modalPrice" step="0.01" class="w-full rounded-xl border border-outline-variant/50 bg-surface-container-low px-4 py-3 text-sm focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none font-semibold" placeholder="@Localizer["Showtime_PriceDefault"]" />
                </div>
            </div>
        </div>

        <div class="px-8 py-5 border-t border-outline-variant/20 bg-surface-container-low flex justify-between items-center rounded-b-3xl">
            <button type="button" id="btnDelete" onclick="deleteShowtime()" class="text-error hover:bg-error/10 px-4 py-2 rounded-xl text-sm font-bold transition-colors hidden items-center gap-1">
                <span class="material-symbols-outlined text-lg">delete</span> @Localizer["Showtime_DeleteBtn"]
            </button>
            <div class="flex gap-3 ml-auto">
                <button type="button" onclick="closeModal()" class="px-6 py-2.5 rounded-xl font-bold text-on-surface-variant hover:bg-surface-container-highest transition-colors text-sm">@Localizer["Showtime_CancelBtn"]</button>
                <button type="button" onclick="saveShowtime()" class="px-8 py-2.5 rounded-xl bg-primary text-white font-bold hover:bg-[#5a4b7b] transition-colors text-sm shadow-md hover:shadow-lg hover:-translate-y-0.5">@Localizer["Showtime_SaveSessionBtn"]</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        // Setare variabile JS folosind localizarea Razor
        const textScheduleMovie = '@Localizer["Showtime_ModalScheduleMovie"]';
        const textEditShowtime = '@Localizer["Showtime_ModalEditShowtime"]';
        const textClickToSearch = '@Localizer["Showtime_ClickToSearch"]';
        const textErrorSelectMovieTime = '@Localizer["Showtime_JS_SelectMovieTime"]';
        const textErrorSaving = '@Localizer["Showtime_JS_ErrorSaving"]';
        const textConfirmDelete = '@Localizer["Showtime_JS_ConfirmDelete"]';
        const textErrorDeleting = '@Localizer["Showtime_JS_ErrorDeleting"]';

        const hallId = @Model.Hall.Id;
        const modal = document.getElementById('tailwindModal');

        const movieTrigger = document.getElementById('movieSelectTrigger');
        const movieMenu = document.getElementById('movieSelectMenu');
        const movieSearch = document.getElementById('movieSearchInput');
        const movieLabel = document.getElementById('movieSelectLabel');
        const hiddenMovieId = document.getElementById('modalMovieId');
        const movieOptions = document.querySelectorAll('.movie-option');
        const dropdownWrapper = document.getElementById('customMovieDropdownWrapper');

        movieTrigger.addEventListener('click', (e) => {
        e.stopPropagation();
        movieMenu.classList.toggle('hidden');
        movieMenu.classList.toggle('flex');
        if(!movieMenu.classList.contains('hidden')) {
        movieSearch.focus();
        }
        });

        document.addEventListener('click', (e) => {
        if (!dropdownWrapper.contains(e.target)) {
        movieMenu.classList.add('hidden');
        movieMenu.classList.remove('flex');
        }
        });

        movieSearch.addEventListener('input', (e) => {
        const term = e.target.value.toLowerCase();
        movieOptions.forEach(opt => {
        const text = opt.getAttribute('data-text').toLowerCase();
        if(text.includes(term)) {
        opt.style.display = 'block';
        } else {
        opt.style.display = 'none';
        }
        });
        });

        movieOptions.forEach(opt => {
        opt.addEventListener('click', () => {
        const val = opt.getAttribute('data-value');
        const text = opt.getAttribute('data-text');
        setMovieSelection(val, text);
        movieMenu.classList.add('hidden');
        movieMenu.classList.remove('flex');
        });
        });

        function setMovieSelection(val, text) {
        hiddenMovieId.value = val;
        movieLabel.textContent = text;
        if(val) {
        movieLabel.classList.remove('text-on-surface-variant');
        movieLabel.classList.add('text-on-surface', 'font-bold');
        } else {
        movieLabel.classList.remove('text-on-surface', 'font-bold');
        movieLabel.classList.add('text-on-surface-variant');
        }
        }

        function openModal() {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        }

        function closeModal() {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        movieMenu.classList.add('hidden');
        movieMenu.classList.remove('flex');
        }

        function openAddModal(dayOffset, hour) {
        let baseDateStr = "@Model.CurrentWeekStart.ToString("yyyy-MM-dd")";
        let startDate = new Date(baseDateStr + "T00:00:00Z");
        startDate.setUTCDate(startDate.getUTCDate() + dayOffset);

        let year = startDate.getUTCFullYear();
        let month = String(startDate.getUTCMonth() + 1).padStart(2, '0');
        let day = String(startDate.getUTCDate()).padStart(2, '0');
        let h = String(hour).padStart(2, '0');

        let exactLocalTime = `${year}-${month}-${day}T${h}:00`;

        $('#modalTitle').text(textScheduleMovie);
        $('#modalShowtimeId').val(0);

        setMovieSelection("", textClickToSearch);
        movieSearch.value = "";
        movieOptions.forEach(o => o.style.display = 'block');

        $('#modalStartTime').val(exactLocalTime);
        $('#modalLanguage').val("");
        $('#modalPrice').val("");

        $('#btnDelete').addClass('hidden').removeClass('flex');
        openModal();
        }

        function openEditModal(id, movieId, startTime, language, price) {
        $('#modalTitle').text(textEditShowtime);
        $('#modalShowtimeId').val(id);

        let foundText = textClickToSearch;
        const opt = Array.from(movieOptions).find(o => o.getAttribute('data-value') == movieId);
        if(opt) foundText = opt.getAttribute('data-text');
        setMovieSelection(movieId, foundText);

        $('#modalStartTime').val(startTime);
        $('#modalLanguage').val(language === "null" ? "" : language);
        $('#modalPrice').val(price === "null" ? "" : price);

        $('#btnDelete').removeClass('hidden').addClass('flex');
        openModal();
        }

        function saveShowtime() {
        const priceVal = $('#modalPrice').val();
        const parsedPrice = priceVal ? parseFloat(priceVal) : null;

        const data = {
        Id: parseInt($('#modalShowtimeId').val()),
        MovieId: parseInt($('#modalMovieId').val()),
        CinemaHallId: hallId,
        StartTime: $('#modalStartTime').val(),
        Language: $('#modalLanguage').val(),
        Price: parsedPrice
        };

        if (!data.MovieId || isNaN(data.MovieId) || !data.StartTime) {
        alert(textErrorSelectMovieTime);
        return;
        }

        fetch('/Admin/Showtime/UpsertAjax', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
        }).then(res => res.json()).then(result => {
        if(result.success) location.reload();
        else alert(result.message || textErrorSaving);
        });
        }

        function deleteShowtime() {
        const id = $('#modalShowtimeId').val();
        if(confirm(textConfirmDelete)) {
        fetch(`/Admin/Showtime/DeleteAjax/${id}`, { method: 'DELETE' })
        .then(res => res.json())
        .then(result => {
        if(result.success) location.reload();
        else alert(result.message || textErrorDeleting);
        });
        }
        }
    </script>
}