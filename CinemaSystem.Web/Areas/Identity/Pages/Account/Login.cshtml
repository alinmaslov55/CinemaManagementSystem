@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="flex items-center justify-center min-h-[70vh] py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8 bg-white p-8 md:p-10 rounded-[2.5rem] shadow-2xl border border-[#cbc4cf]/30">
        
        <div class="text-center">
            <div class="w-16 h-16 bg-[#eaddff] rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-inner">
                <span class="material-symbols-outlined text-4xl text-[#7f6fa2]">lock_open</span>
            </div>
            <h2 class="text-3xl font-extrabold text-[#1a1c1c] font-['Manrope'] tracking-tight">Welcome Back</h2>
            <p class="mt-2 text-sm text-[#79767b] font-['Inter']">Log in to your CinemaSystem account</p>
        </div>

        <form id="account" method="post" class="mt-8 space-y-6">
            <div asp-validation-summary="ModelOnly" class="text-[#a8364b] bg-[#f97386]/10 p-4 rounded-xl text-sm font-medium border border-[#f97386]/30 mb-4" role="alert"></div>
            
            <div class="space-y-5">
                <div>
                    <label asp-for="Input.Email" class="block text-[10px] font-bold text-[#79767b] uppercase tracking-widest mb-2 font-['Inter']">Email Address</label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-[#cbc4cf] text-sm">mail</span>
                        <input asp-for="Input.Email" class="w-full bg-[#f9f9f9] border border-[#cbc4cf]/50 rounded-xl pl-11 pr-4 py-3 focus:outline-none focus:ring-2 focus:ring-[#7f6fa2]/50 focus:border-[#7f6fa2] transition-all text-sm font-['Inter']" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    </div>
                    <span asp-validation-for="Input.Email" class="text-[#a8364b] text-xs mt-1 block font-medium"></span>
                </div>

                <div>
                    <label asp-for="Input.Password" class="block text-[10px] font-bold text-[#79767b] uppercase tracking-widest mb-2 font-['Inter']">Password</label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-[#cbc4cf] text-sm">key</span>
                        <input asp-for="Input.Password" class="w-full bg-[#f9f9f9] border border-[#cbc4cf]/50 rounded-xl pl-11 pr-4 py-3 focus:outline-none focus:ring-2 focus:ring-[#7f6fa2]/50 focus:border-[#7f6fa2] transition-all text-sm font-['Inter']" autocomplete="current-password" aria-required="true" placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="Input.Password" class="text-[#a8364b] text-xs mt-1 block font-medium"></span>
                </div>
            </div>

            <div class="flex items-center justify-between">
                <div class="flex items-center">
                    <input asp-for="Input.RememberMe" class="h-4 w-4 text-[#7f6fa2] focus:ring-[#7f6fa2] border-[#cbc4cf] rounded cursor-pointer" />
                    <label asp-for="Input.RememberMe" class="ml-2 block text-sm text-[#79767b] font-medium cursor-pointer">
                        @Html.DisplayNameFor(m => m.Input.RememberMe)
                    </label>
                </div>

                <div class="text-sm">
                    <a id="forgot-password" asp-page="./ForgotPassword" class="font-bold text-[#7f6fa2] hover:text-[#976987] transition-colors">Forgot password?</a>
                </div>
            </div>

            <div>
                <button id="login-submit" type="submit" class="w-full flex justify-center py-3.5 px-4 border border-transparent rounded-xl shadow-lg text-sm font-bold uppercase tracking-widest text-white bg-gradient-to-r from-[#7f6fa2] to-[#976987] hover:from-[#665788] hover:to-[#7d516e] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#7f6fa2] transition-all active:scale-95">
                    Log in
                </button>
            </div>
            
            <div class="text-center mt-4">
                <p class="text-sm text-[#79767b] font-medium">
                    Don't have an account?
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="font-bold text-[#7f6fa2] hover:text-[#976987] transition-colors">Register here</a>
                </p>
                <p class="mt-2">
                    <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="text-xs text-[#79767b] hover:text-[#7f6fa2] transition-colors underline decoration-[#cbc4cf]">Resend email confirmation</a>
                </p>
            </div>
        </form>

        @if ((Model.ExternalLogins?.Count ?? 0) > 0)
        {
            <div class="mt-8">
                <div class="relative">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t border-[#cbc4cf]/30"></div>
                    </div>
                    <div class="relative flex justify-center text-sm">
                        <span class="px-4 bg-white text-[#79767b] font-medium text-xs uppercase tracking-widest">Or continue with</span>
                    </div>
                </div>

                <div class="mt-6 grid grid-cols-1 gap-3">
                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="w-full">
                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            <button type="submit" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account" class="w-full flex justify-center items-center gap-3 py-3 px-4 border border-[#cbc4cf]/50 rounded-xl shadow-sm bg-white text-sm font-bold text-[#1a1c1c] hover:bg-[#f9f9f9] transition-colors">
                                <img src="https://www.svgrepo.com/show/475656/google-color.svg" class="w-5 h-5" alt="@provider.DisplayName" />
                                @provider.DisplayName
                            </button>
                        }
                    </form>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}