@page
@model IndexModel
@{
    ViewData["Title"] = "My Profile";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<div class="max-w-6xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
    
    <div class="mb-8">
        <h2 class="text-3xl font-extrabold text-[#1a1c1c] font-['Manrope'] tracking-tight">@ViewData["Title"]</h2>
        <p class="mt-2 text-sm text-[#79767b] font-['Inter']">Manage your account settings and loyalty rewards.</p>
    </div>

    <partial name="_StatusMessage" for="StatusMessage" />

    <div class="flex flex-col lg:flex-row gap-8 items-start">
        
        <div class="w-full lg:w-1/3">
            <div class="relative rounded-[2.5rem] shadow-2xl text-white overflow-hidden border border-white/20"
                 style="background: @(Model.MembershipTier == "Gold" ? "linear-gradient(135deg, #F59E0B, #D97706)" :
                                                                       Model.MembershipTier == "Silver" ? "linear-gradient(135deg, #9CA3AF, #6B7280)" :
                                                                       "linear-gradient(135deg, #B45309, #78350F)")">
                
                <div class="absolute top-0 right-0 -mt-8 -mr-8 w-32 h-32 bg-white opacity-10 rounded-full blur-2xl"></div>
                <div class="absolute bottom-0 left-0 -mb-8 -ml-8 w-24 h-24 bg-black opacity-10 rounded-full blur-xl"></div>

                <div class="relative p-8 md:p-10 text-center">
                    <div class="w-16 h-16 bg-white/20 backdrop-blur-md rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-inner border border-white/30">
                        <span class="material-symbols-outlined text-4xl text-white">workspace_premium</span>
                    </div>
                    
                    <h4 class="text-2xl font-extrabold font-['Manrope'] mb-1 tracking-tight uppercase drop-shadow-sm">
                        @Model.MembershipTier Member
                    </h4>
                    <p class="text-xs font-bold uppercase tracking-widest text-white/80 mb-8 font-['Inter']">
                        CinemaSystem Loyalty
                    </p>
                    
                    <div class="bg-black/10 backdrop-blur-sm rounded-2xl p-6 border border-white/10 shadow-inner">
                        <h2 class="text-5xl font-black font-['Manrope'] mb-1 tracking-tighter">@Model.LoyaltyPoints</h2>
                        <span class="text-[10px] uppercase font-bold tracking-widest text-white/70">Total Points</span>
                    </div>
                    
                    <p class="text-xs font-medium text-white/80 mt-6 leading-relaxed font-['Inter']">
                        Earn points with every ticket to unlock premium discounts and exclusive premieres!
                    </p>
                </div>
            </div>
        </div>

        <div class="w-full lg:w-2/3 bg-white p-8 md:p-10 rounded-[2.5rem] shadow-2xl border border-[#cbc4cf]/30">
            <div class="flex items-center gap-3 border-b border-[#cbc4cf]/30 pb-4 mb-8">
                <span class="material-symbols-outlined text-[#7f6fa2]">manage_accounts</span>
                <h3 class="text-xl font-bold text-[#1a1c1c] font-['Manrope']">Personal Details</h3>
            </div>

            <form id="profile-form" method="post" class="space-y-6">
                <div asp-validation-summary="ModelOnly" class="text-[#a8364b] bg-[#f97386]/10 p-4 rounded-xl text-sm font-medium border border-[#f97386]/30 mb-4" role="alert"></div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    
                    <div class="md:col-span-2">
                        <label asp-for="Username" class="block text-[10px] font-bold text-[#79767b] uppercase tracking-widest mb-2 font-['Inter']">Username</label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-[#cbc4cf] text-sm">account_circle</span>
                            <input asp-for="Username" class="w-full bg-[#f3f3f3] border border-[#cbc4cf]/30 rounded-xl pl-11 pr-4 py-3 text-sm font-['Inter'] text-[#79767b] cursor-not-allowed opacity-70" disabled />
                        </div>
                    </div>

                    <div class="md:col-span-2">
                        <label asp-for="Input.FullName" class="block text-[10px] font-bold text-[#79767b] uppercase tracking-widest mb-2 font-['Inter']">Full Name</label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-[#cbc4cf] text-sm">badge</span>
                            <input asp-for="Input.FullName" class="w-full bg-[#f9f9f9] border border-[#cbc4cf]/50 rounded-xl pl-11 pr-4 py-3 focus:outline-none focus:ring-2 focus:ring-[#7f6fa2]/50 focus:border-[#7f6fa2] transition-all text-sm font-['Inter']" placeholder="John Doe" />
                        </div>
                        <span asp-validation-for="Input.FullName" class="text-[#a8364b] text-xs mt-1 block font-medium"></span>
                    </div>

                    <div>
                        <label asp-for="Input.PhoneNumber" class="block text-[10px] font-bold text-[#79767b] uppercase tracking-widest mb-2 font-['Inter']">Phone Number</label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-[#cbc4cf] text-sm">phone</span>
                            <input asp-for="Input.PhoneNumber" class="w-full bg-[#f9f9f9] border border-[#cbc4cf]/50 rounded-xl pl-11 pr-4 py-3 focus:outline-none focus:ring-2 focus:ring-[#7f6fa2]/50 focus:border-[#7f6fa2] transition-all text-sm font-['Inter']" placeholder="+1 (555) 000-0000" />
                        </div>
                        <span asp-validation-for="Input.PhoneNumber" class="text-[#a8364b] text-xs mt-1 block font-medium"></span>
                    </div>

                    <div>
                        <label asp-for="Input.DateOfBirth" class="block text-[10px] font-bold text-[#79767b] uppercase tracking-widest mb-2 font-['Inter']">Date of Birth</label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-[#cbc4cf] text-sm">calendar_month</span>
                            <input asp-for="Input.DateOfBirth" class="w-full bg-[#f9f9f9] border border-[#cbc4cf]/50 rounded-xl pl-11 pr-4 py-3 focus:outline-none focus:ring-2 focus:ring-[#7f6fa2]/50 focus:border-[#7f6fa2] transition-all text-sm font-['Inter'] text-[#1a1c1c]" />
                        </div>
                        <span asp-validation-for="Input.DateOfBirth" class="text-[#a8364b] text-xs mt-1 block font-medium"></span>
                        <p class="text-[10px] text-[#79767b] mt-1.5 font-medium leading-tight">Required to access age-restricted movies.</p>
                    </div>

                    <div class="md:col-span-2">
                        <label asp-for="Input.Address" class="block text-[10px] font-bold text-[#79767b] uppercase tracking-widest mb-2 font-['Inter']">Home Address</label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-[#cbc4cf] text-sm">home_pin</span>
                            <input asp-for="Input.Address" class="w-full bg-[#f9f9f9] border border-[#cbc4cf]/50 rounded-xl pl-11 pr-4 py-3 focus:outline-none focus:ring-2 focus:ring-[#7f6fa2]/50 focus:border-[#7f6fa2] transition-all text-sm font-['Inter']" placeholder="123 Cinema Boulevard, Apt 4" />
                        </div>
                        <span asp-validation-for="Input.Address" class="text-[#a8364b] text-xs mt-1 block font-medium"></span>
                    </div>

                    <div class="md:col-span-2">
                        <label asp-for="Input.PreferredCinemaId" class="block text-[10px] font-bold text-[#79767b] uppercase tracking-widest mb-2 font-['Inter']">Preferred Cinema</label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-[#cbc4cf] text-sm z-10">theaters</span>
                            <select asp-for="Input.PreferredCinemaId" asp-items="Model.CinemaList" class="w-full bg-[#f9f9f9] border border-[#cbc4cf]/50 rounded-xl pl-11 pr-10 py-3 focus:outline-none focus:ring-2 focus:ring-[#7f6fa2]/50 focus:border-[#7f6fa2] transition-all text-sm font-['Inter'] cursor-pointer appearance-none">
                                <option value="">-- Select Your Local Theater --</option>
                            </select>
                            <span class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-[#cbc4cf] text-sm pointer-events-none">expand_more</span>
                        </div>
                        <span asp-validation-for="Input.PreferredCinemaId" class="text-[#a8364b] text-xs mt-1 block font-medium"></span>
                    </div>
                </div>

                <div class="pt-6 mt-6 border-t border-[#cbc4cf]/30">
                    <button id="update-profile-button" type="submit" class="w-full md:w-auto md:min-w-[200px] float-right flex justify-center py-3.5 px-8 border border-transparent rounded-xl shadow-lg text-sm font-bold uppercase tracking-widest text-white bg-gradient-to-r from-[#7f6fa2] to-[#976987] hover:from-[#665788] hover:to-[#7d516e] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#7f6fa2] transition-all active:scale-95">
                        Save Changes
                    </button>
                    <div class="clear-both"></div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}