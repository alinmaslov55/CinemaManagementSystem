@model CinemaSystem.Models.ViewModels.CheckoutVM
@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Localization
@using CinemaSystem.Web
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> localizer

@{
    ViewData["Title"] = localizer["PageTitle_Checkout"];
    Layout = "_Layout";
}

<style>
    .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
    .hide-scrollbar::-webkit-scrollbar { display: none; }
    .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<div class="bg-[#f9f9f9] font-['Inter'] text-[#1a1c1c] antialiased min-h-screen pt-12 pb-32">
    <main class="max-w-[1440px] mx-auto px-6 md:px-12">
        
        <div class="flex flex-col items-center mb-12">
            <div class="flex items-center gap-2 md:gap-4 mb-4 overflow-x-auto hide-scrollbar w-full justify-center">
                <div class="flex items-center gap-2 opacity-50 shrink-0">
                    <div class="w-8 h-8 rounded-full bg-[#645485]/20 text-[#645485] flex items-center justify-center text-xs font-bold">1</div>
                    <span class="text-xs font-['Manrope'] uppercase tracking-widest font-bold text-[#645485] hidden md:block">@localizer["Breadcrumb_Details"]</span>
                </div>
                <div class="w-8 md:w-12 h-[1px] bg-[#cbc4cf]/50 shrink-0"></div>
                <div class="flex items-center gap-2 opacity-50 shrink-0">
                    <div class="w-8 h-8 rounded-full bg-[#645485]/20 text-[#645485] flex items-center justify-center text-xs font-bold">2</div>
                    <span class="text-xs font-['Manrope'] uppercase tracking-widest font-bold text-[#645485] hidden md:block">@localizer["Breadcrumb_Seats"]</span>
                </div>
                <div class="w-8 md:w-12 h-[1px] bg-[#cbc4cf]/50 shrink-0"></div>
                <div class="flex items-center gap-2 opacity-50 shrink-0">
                    <div class="w-8 h-8 rounded-full bg-[#645485]/20 text-[#645485] flex items-center justify-center text-xs font-bold">3</div>
                    <span class="text-xs font-['Manrope'] uppercase tracking-widest font-bold text-[#645485] hidden md:block">@localizer["Breadcrumb_Food"]</span>
                </div>
                <div class="w-8 md:w-12 h-[1px] bg-[#cbc4cf]/50 shrink-0"></div>
                <div class="flex items-center gap-2 shrink-0">
                    <div class="w-8 h-8 rounded-full bg-[#645485] text-white flex items-center justify-center text-xs font-bold shadow-md">4</div>
                    <span class="text-xs font-['Manrope'] uppercase tracking-widest font-bold text-[#1a1c1c]">@localizer["Breadcrumb_Checkout"]</span>
                </div>
            </div>
        </div>

        <div class="mb-12">
            <h1 class="font-['Manrope'] text-4xl md:text-5xl font-extrabold tracking-tight text-[#1a1c1c] mb-2">@localizer["Heading_SecureCheckout"]</h1>
            <p class="text-[#49454e] font-medium flex items-center gap-2">
                <span class="material-symbols-outlined text-[16px] text-emerald-600">lock</span> 
                @localizer["Message_EncryptedTransaction"]
            </p>
        </div>

        <div class="mb-8 flex items-center justify-center bg-[#ffd8e6] text-[#613b4c] py-3 rounded-xl border border-[#ecb8cc] max-w-md mx-auto shadow-sm transition-colors duration-500" id="timerContainer">
            <span class="material-symbols-outlined mr-2">timer</span>
            <span class="font-bold text-sm tracking-wide">@localizer["Message_SeatsReservedFor"]: <span id="countdownTimer" class="font-mono text-base ml-1">10:00</span></span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
            
            <div class="lg:col-span-8 space-y-12">
                <form asp-action="FinalizeOrder" method="post" id="checkoutForm">
                    <input type="hidden" name="showtimeId" value="@Model.Showtime.Id" />

                    <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="bg-white p-6 rounded-3xl shadow-sm border border-[#cbc4cf]/20 flex gap-6 items-center">
                            <div class="w-20 h-28 flex-shrink-0 rounded-xl overflow-hidden shadow-sm border border-[#cbc4cf]/30">
                                <img alt="@Model.Showtime.Movie.Title" class="w-full h-full object-cover" 
                                     src="@(string.IsNullOrEmpty(Model.Showtime.Movie.ImageUrl) ? "https://via.placeholder.com/150x225" : Model.Showtime.Movie.ImageUrl)"/>
                            </div>
                            <div class="flex flex-col justify-center">
                                <span class="text-[10px] font-bold tracking-widest text-[#645485] uppercase mb-1">@localizer["Label_NowShowing"]</span>
                                <h2 class="text-xl font-['Manrope'] font-bold text-[#1a1c1c] leading-tight mb-2 line-clamp-2">@Model.Showtime.Movie.Title</h2>
                                <div class="space-y-1 mt-1">
                                    <div class="flex items-center gap-1.5 text-xs text-[#49454e] font-medium">
                                        <span class="material-symbols-outlined text-[14px]">calendar_today</span>
                                        <span>@Model.Showtime.StartTime.ToString("MMM dd • HH:mm")</span>
                                    </div>
                                    <div class="flex items-center gap-1.5 text-xs text-[#49454e] font-medium">
                                        <span class="material-symbols-outlined text-[14px]">meeting_room</span>
                                        <span>@Model.Showtime.CinemaHall.Name</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="bg-white p-6 rounded-3xl shadow-sm border border-[#cbc4cf]/20 flex flex-col justify-center h-full">
                            <div class="flex items-center gap-3 mb-4 border-b border-[#f3f3f3] pb-3">
                                <div class="w-10 h-10 rounded-full bg-[#eaddff] flex items-center justify-center text-[#645485]">
                                    <span class="material-symbols-outlined text-sm">event_seat</span>
                                </div>
                                <h3 class="font-bold text-[#1a1c1c]">@localizer["Heading_SelectedAdmissions"]</h3>
                            </div>
                            
                            <ul class="space-y-2 mb-2 max-h-[100px] overflow-y-auto hide-scrollbar">
                                @foreach (var item in Model.TicketItems)
                                {
                                    <li class="flex justify-between items-center text-sm">
                                        <span class="text-[#49454e]">@localizer["Label_Seat"] <strong class="text-[#1a1c1c]">@item.SeatName</strong></span>
                                        <span class="font-bold text-[#1a1c1c]">$@item.Price.ToString("F2")</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    </section>

                    @if (Model.AvailableFnBProducts != null && Model.AvailableFnBProducts.Any())
                    {
                        <section class="mt-12">
                            <h3 class="text-xl font-['Manrope'] font-bold mb-6 flex items-center gap-2 text-[#1a1c1c]">
                                <span class="material-symbols-outlined text-[#645485]">fastfood</span>
                                @localizer["Heading_AddTreats"]
                            </h3>
                            <div class="bg-[#f3f3f3] rounded-3xl p-6 md:p-8 border border-[#cbc4cf]/30">
                                <div class="space-y-4">
                                    @foreach (var fnBProduct in Model.AvailableFnBProducts)
                                    {
                                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 bg-white rounded-2xl border border-[#cbc4cf]/20 shadow-sm transition-all hover:shadow-md">
                                            <input type="hidden" name="concessionIds" value="@fnBProduct.Id" />
                                            <input type="hidden" name="concessionQuantities" id="input-qty-@fnBProduct.Id" value="0" class="concession-qty-input" data-price="@fnBProduct.Price.ToString(CultureInfo.InvariantCulture)" />

                                            <div class="flex items-center gap-4">
                                                <div class="w-16 h-16 rounded-xl bg-surface-container overflow-hidden border border-[#cbc4cf]/30 shrink-0">
                                                    <img class="w-full h-full object-cover" alt="@fnBProduct.Name" src="@(string.IsNullOrEmpty(fnBProduct.ImageUrl) ? "https://via.placeholder.com/100" : fnBProduct.ImageUrl)"/>
                                                </div>
                                                <div>
                                                    <p class="font-bold text-[#1a1c1c] text-sm">@fnBProduct.Name</p>
                                                    <p class="text-[10px] text-[#7a757f] uppercase tracking-widest font-bold mb-1">@fnBProduct.Description</p>
                                                    <span class="font-bold text-[#645485] text-sm">$@fnBProduct.Price.ToString("F2")</span>
                                                </div>
                                            </div>
                                            
                                            <div class="flex items-center justify-between bg-[#f3f3f3] rounded-full p-1.5 border border-[#cbc4cf]/30 w-32 sm:w-auto shrink-0 self-end sm:self-auto">
                                                <button type="button" onclick="updateQty(@fnBProduct.Id, -1)" class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-[#e2e2e2] transition-colors active:scale-90 text-[#49454e]">
                                                    <span class="material-symbols-outlined text-sm">remove</span>
                                                </button>
                                                <span class="px-4 text-sm font-bold text-[#1a1c1c] font-mono" id="display-qty-@fnBProduct.Id">0</span>
                                                <button type="button" onclick="updateQty(@fnBProduct.Id, 1)" class="w-8 h-8 flex items-center justify-center rounded-full bg-[#eaddff] text-[#645485] hover:bg-[#645485] hover:text-white transition-colors active:scale-90">
                                                    <span class="material-symbols-outlined text-sm">add</span>
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </section>
                    }

                    <section class="mt-12">
                        <h3 class="text-xl font-['Manrope'] font-bold mb-6 flex items-center gap-2 text-[#1a1c1c]">
                            <span class="material-symbols-outlined text-[#645485]">payments</span>
                            @localizer["Heading_PaymentInformation"]
                        </h3>
                        
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
                            <label class="relative cursor-pointer group">
                                <input checked class="peer sr-only" name="paymentType" type="radio"/>
                                <div class="p-5 rounded-2xl bg-white border-2 border-[#cbc4cf]/30 peer-checked:border-[#645485] peer-checked:bg-[#eaddff]/30 shadow-sm transition-all flex flex-col items-center gap-2">
                                    <span class="material-symbols-outlined text-3xl text-[#645485]">credit_card</span>
                                    <span class="font-bold text-sm text-[#1a1c1c]">@localizer["Label_CreditCard"]</span>
                                </div>
                            </label>
                            </div>
                        
                        <div class="bg-[#f3f3f3] p-6 md:p-8 rounded-3xl space-y-5 border border-[#cbc4cf]/30">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                                <div class="flex flex-col gap-1.5">
                                    <label class="text-[10px] font-bold uppercase tracking-widest text-[#7a757f]" for="cardName">@localizer["Label_CardholderName"]</label>
                                    <input id="cardName" name="cardName" class="bg-white border border-[#cbc4cf]/50 rounded-xl p-3.5 focus:ring-2 focus:ring-[#645485]/30 text-[#1a1c1c] placeholder:text-[#b5b0ba] font-medium outline-none transition-all shadow-sm uppercase" placeholder="e.g. ALEX MERCER" type="text" required pattern="[a-zA-Z\s\-]+" title="Doar litere și spații sunt permise" />
                                </div>
                                <div class="flex flex-col gap-1.5">
                                    <label class="text-[10px] font-bold uppercase tracking-widest text-[#7a757f]" for="cardNumber">@localizer["Label_CardNumber"]</label>
                                    <input id="cardNumber" name="cardNumber" class="bg-white border border-[#cbc4cf]/50 rounded-xl p-3.5 focus:ring-2 focus:ring-[#645485]/30 text-[#1a1c1c] placeholder:text-[#b5b0ba] font-medium outline-none transition-all shadow-sm" placeholder="•••• •••• •••• 4412" type="text" inputmode="numeric" maxlength="19" required oninput="this.value = this.value.replace(/[^0-9]/g, '').replace(/(\d{4})(?=\d)/g, '$1 ')" />
                                </div>
                            </div>
                            <div class="grid grid-cols-2 md:grid-cols-4 gap-5">
                                <div class="flex flex-col gap-1.5 md:col-span-1">
                                    <label class="text-[10px] font-bold uppercase tracking-widest text-[#7a757f]" for="cardExpiry">@localizer["Label_ExpiryDate"]</label>
                                    <input id="cardExpiry" name="cardExpiry" class="bg-white border border-[#cbc4cf]/50 rounded-xl p-3.5 focus:ring-2 focus:ring-[#645485]/30 text-[#1a1c1c] placeholder:text-[#b5b0ba] font-medium outline-none transition-all text-center shadow-sm" placeholder="MM/YY" type="text" inputmode="numeric" maxlength="5" required oninput="this.value = this.value.replace(/[^0-9]/g, '').replace(/^(\d{2})(\d)/g, '$1/$2')" />
                                </div>
                                <div class="flex flex-col gap-1.5 md:col-span-1">
                                    <label class="text-[10px] font-bold uppercase tracking-widest text-[#7a757f]" for="cardCvv">CVV</label>
                                    <input id="cardCvv" name="cardCvv" class="bg-white border border-[#cbc4cf]/50 rounded-xl p-3.5 focus:ring-2 focus:ring-[#645485]/30 text-[#1a1c1c] placeholder:text-[#b5b0ba] font-medium outline-none transition-all text-center shadow-sm" placeholder="•••" type="password" inputmode="numeric" maxlength="4" required oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
                                </div>
                            </div>
                        </div>
                    </section>

                    <button type="submit" id="hiddenSubmitBtn" class="hidden">Submit</button>
                </form>
            </div>

            <div class="lg:col-span-4">
                <div class="sticky top-28 bg-white p-8 rounded-[2.5rem] shadow-xl border border-[#cbc4cf]/20 flex flex-col">
                    
                    <h3 class="text-2xl font-['Manrope'] font-bold mb-8 text-[#1a1c1c] border-b border-[#f3f3f3] pb-4">@localizer["Heading_OrderSummary"]</h3>
                    
                    <div class="space-y-4 mb-6 flex-1">
                        <div class="flex justify-between items-center text-sm">
                            <span class="text-[#49454e] font-medium">@localizer["Label_Tickets"] (@Model.TicketItems.Count)</span>
                            <span class="font-bold text-[#1a1c1c]">$@Model.TotalAmount.ToString("F2")</span>
                        </div>
                        <div class="flex justify-between items-center text-sm" id="concessionsSummaryRow" style="display: none;">
                            <span class="text-[#49454e] font-medium">@localizer["Label_SnacksDrinks"]</span>
                            <span class="font-bold text-[#1a1c1c]" id="concessionsTotalText">$0.00</span>
                        </div>
                        <div class="flex justify-between items-center text-sm opacity-60">
                            <span class="text-[#49454e] font-medium">@localizer["Label_TaxesFees"]</span>
                            <span class="font-bold text-[#1a1c1c]">@localizer["Label_Included"]</span>
                        </div>
                    </div>
                    
                    <div class="pt-6 border-t border-[#cbc4cf]/30 mb-8">
                        <div class="flex justify-between items-end mb-2">
                            <p class="text-[10px] font-bold uppercase tracking-widest text-[#7a757f]">@localizer["Label_TotalPayable"]</p>
                            <div class="bg-[#eaddff] px-2 py-0.5 rounded text-[8px] font-bold text-[#4e3e6e] uppercase tracking-widest">
                                @localizer["Label_Secure"]
                            </div>
                        </div>
                        <p class="text-4xl font-['Manrope'] font-extrabold tracking-tighter text-[#645485]" id="grandTotalDisplay">
                            $@Model.TotalAmount.ToString("F2")
                        </p>
                    </div>

                    <div class="space-y-4 mt-auto">
                        <button type="button" id="btnPayNow" onclick="document.getElementById('hiddenSubmitBtn').click();" class="w-full bg-[#645485] hover:bg-[#7d6c9f] text-white py-4 rounded-2xl font-bold text-sm uppercase tracking-widest shadow-lg shadow-[#645485]/30 active:scale-95 transition-all flex items-center justify-center gap-2">
                            <span class="material-symbols-outlined text-[18px]">lock_check</span> @localizer["Button_ConfirmPay"]
                        </button>
                        <p class="text-center text-[10px] text-[#7a757f] px-4 leading-relaxed font-medium">
                            @localizer["Message_AgreementTerms"] <a class="underline hover:text-[#645485]" href="#">@localizer["Label_Terms"]</a> @localizer["Label_And"] <a class="underline hover:text-[#645485]" href="#">@localizer["Label_RefundPolicy"]</a>.
                        </p>
                    </div>
                </div>
            </div>

        </div>
    </main>
</div>

@section Scripts {
    <script>
        const baseTicketTotal = parseFloat('@Model.TotalAmount.ToString(CultureInfo.InvariantCulture)');
        
        function updateQty(id, change) {
            const inputEl = document.getElementById(`input-qty-${id}`);
            const displayEl = document.getElementById(`display-qty-${id}`);
            
            let currentQty = parseInt(inputEl.value);
            let newQty = currentQty + change;
            
            if(newQty < 0) newQty = 0;
            if(newQty > 10) newQty = 10;
            
            inputEl.value = newQty;
            displayEl.innerText = newQty;
            
            calculateGrandTotal();
        }

        function calculateGrandTotal() {
            let concessionsTotal = 0;
            const inputs = document.querySelectorAll('.concession-qty-input');
            
            inputs.forEach(input => {
                let qty = parseInt(input.value);
                let price = parseFloat(input.getAttribute('data-price'));
                concessionsTotal += (qty * price);
            });
            
            let grandTotal = baseTicketTotal + concessionsTotal;
            
            document.getElementById('grandTotalDisplay').innerText = '$' + grandTotal.toFixed(2);
            
            const summaryRow = document.getElementById('concessionsSummaryRow');
            const summaryText = document.getElementById('concessionsTotalText');
            
            if (concessionsTotal > 0) {
                summaryRow.style.display = 'flex';
                summaryText.innerText = '$' + concessionsTotal.toFixed(2);
            } else {
                summaryRow.style.display = 'none';
            }
        }

        let timeRemaining = 600;
        const timerDisplay = document.getElementById('countdownTimer');
        const timerContainer = document.getElementById('timerContainer');
        const btnPayNow = document.getElementById('btnPayNow');

        const countdown = setInterval(() => {
            timeRemaining--;

            let minutes = Math.floor(timeRemaining / 60);
            let seconds = timeRemaining % 60;
            seconds = seconds < 10 ? '0' + seconds : seconds;

            timerDisplay.innerText = `${minutes}:${seconds}`;

            if (timeRemaining <= 60 && timeRemaining > 0) {
                timerContainer.classList.replace('bg-[#ffd8e6]', 'bg-[#ba1a1a]');
                timerContainer.classList.replace('text-[#613b4c]', 'text-white');
                timerContainer.classList.replace('border-[#ecb8cc]', 'border-[#ba1a1a]');
            }

            if (timeRemaining <= 0) {
                clearInterval(countdown);
                timerDisplay.innerText = "00:00";
                
                btnPayNow.disabled = true;
                btnPayNow.innerHTML = "@localizer["Label_SessionExpired"]";
                btnPayNow.classList.replace('bg-[#645485]', 'bg-[#b5b0ba]');
                btnPayNow.classList.replace('hover:bg-[#7d6c9f]', 'hover:bg-[#b5b0ba]');
                btnPayNow.classList.remove('shadow-lg', 'active:scale-95');

                alert("@localizer["Alert_SessionExpired"]");
                window.location.href = '/Booking/SelectSeats?showtimeId=@Model.Showtime.Id';
            }
        }, 1000);

        document.getElementById('checkoutForm').addEventListener('submit', function() {
            btnPayNow.disabled = true;
            btnPayNow.innerHTML = `<span class="material-symbols-outlined animate-spin text-[18px]">progress_activity</span> @localizer["Label_Processing"]`;
            btnPayNow.classList.add('opacity-70', 'cursor-not-allowed');
        });
        
        calculateGrandTotal();
    </script>
}