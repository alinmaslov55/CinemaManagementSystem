@using CinemaSystem.Models.Entities
@model IEnumerable<Booking>

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="fw-bold text-uppercase border-bottom pb-2">My Tickets & Order History</h2>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-5 shadow-sm">
            <i class="bi bi-ticket-perforated fs-1 text-muted d-block mb-3"></i>
            <h4>You haven't booked any movies yet!</h4>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Browse Movies</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 g-4">
            @foreach (var order in Model)
            {
                <div class="col">
                    <div class="card shadow-sm border-0 border-start border-primary border-5">
                        <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-center">

                            <div class="d-flex align-items-center mb-3 mb-md-0">
                                <img src="@(string.IsNullOrEmpty(order.Showtime.Movie.ImageUrl) ? "https://via.placeholder.com/100x150" : order.Showtime.Movie.ImageUrl)"
                                     class="rounded shadow-sm me-4" style="width: 60px; height: 90px; object-fit: cover;" alt="Poster">
                                <div>
                                    <h5 class="fw-bold text-primary mb-1">@order.Showtime.Movie.Title</h5>
                                    <p class="text-muted mb-0 small"><i class="bi bi-calendar-event"></i> @order.Showtime.StartTime.ToString("dddd, MMM dd, yyyy - HH:mm")</p>
                                    <p class="text-muted mb-0 small"><i class="bi bi-receipt"></i> Order #: @order.ConfirmationCode</p>
                                </div>
                            </div>

                            <div class="text-md-end text-center w-100 w-md-auto">
                                <h5 class="fw-bold text-success mb-2">$@order.TotalAmount.ToString("F2")</h5>
                                <span class="badge bg-secondary mb-2">@order.Tickets.Count() Tickets</span>
                                <br />
                                @* We reuse the exact same PDF generation endpoint here! *@
                                <a asp-controller="Booking" asp-action="DownloadTickets" asp-route-bookingId="@order.Id" class="btn btn-sm btn-outline-primary shadow-sm w-100">
                                    <i class="bi bi-download"></i> Download PDF
                                </a>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>