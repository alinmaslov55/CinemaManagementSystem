@using CinemaSystem.Models.Entities
@using Microsoft.AspNetCore.Mvc.Localization
@using CinemaSystem.Web
@using Microsoft.AspNetCore.Identity
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> localizer
@inject UserManager<ApplicationUser> UserManager
@model IEnumerable<Booking>

@{
    ViewData["Title"] = localizer["PageTitle_History"];
    
    var now = DateTime.Now;
    var upcomingBookings = Model.Where(b => b.Showtime.StartTime > now).OrderBy(b => b.Showtime.StartTime).ToList();
    var pastBookings = Model.Where(b => b.Showtime.StartTime <= now).OrderByDescending(b => b.Showtime.StartTime).ToList();

    var currentUser = await UserManager.GetUserAsync(User);
}

<style>
    .glass-card { background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(12px); }
    .primary-gradient { background: linear-gradient(135deg, #645485 0%, #7d6c9f 100%); }
    .custom-shadow { box-shadow: 0px 20px 40px rgba(100, 84, 133, 0.06); }
</style>

<div class="max-w-[1440px] mx-auto px-6 md:px-12 py-12 font-['Inter'] text-[#1a1c1c]">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 mb-16 items-start">
        <div class="lg:col-span-8">
            <h1 class="text-5xl font-extrabold tracking-tight font-['Manrope'] text-[#645485] mb-2">@localizer["Heading_History"]</h1>
            <p class="text-lg text-[#49454e] font-medium">@Html.Raw(string.Format(localizer["Greeting_Welcome"].Value, User.Identity.Name?.Split('@')[0] ?? localizer["Label_Cinephile"].Value))</p>
        </div>
        <div class="lg:col-span-4">
            <div class="bg-white custom-shadow p-6 rounded-2xl flex items-center gap-6 border border-[#cbc4cf]/30">
                <div class="primary-gradient w-16 h-16 rounded-xl flex items-center justify-center text-white shadow-lg">
                    <span class="material-symbols-outlined text-3xl" style="font-variation-settings: 'FILL' 1;">stars</span>
                </div>
                <div>
                    <div class="flex items-center gap-2 mb-1">
                        <span class="text-[10px] font-bold uppercase tracking-widest text-[#795061]">@currentUser?.MembershipTier Member</span>
                    </div>
                    <h3 class="text-2xl font-bold font-['Manrope'] text-[#645485]">@currentUser?.LoyaltyPoints.ToString("N0") <span class="text-sm font-medium text-[#49454e]">VP</span></h3>
                </div>
            </div>
        </div>
    </div>

    <section class="mb-20">
        <div class="flex items-baseline justify-between mb-8">
            <h2 class="text-3xl font-bold font-['Manrope'] text-[#1a1c1c]">@localizer["Heading_UpcomingExperiences"]</h2>
            <div class="h-px bg-[#cbc4cf] opacity-30 flex-grow mx-8 hidden md:block"></div>
        </div>

        @if (!upcomingBookings.Any())
        {
            <div class="bg-[#f3f3f3] rounded-2xl p-16 text-center border border-[#cbc4cf]/30 custom-shadow">
                <span class="material-symbols-outlined text-6xl text-[#cbc4cf] mb-4">theaters</span>
                <h3 class="text-xl font-bold font-['Manrope'] text-[#645485] mb-2">@localizer["Heading_ScreenEmpty"]</h3>
                <p class="text-[#49454e] mb-6">@localizer["Message_NoUpcomingBookings"]</p>
                <a asp-controller="Home" asp-action="Index" class="inline-flex items-center gap-2 primary-gradient text-white px-8 py-3 rounded-lg font-bold text-sm shadow-md hover:scale-[0.98] transition-all">
                    @localizer["Button_BrowseMovies"]
                </a>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                @{
                    var firstUpcoming = upcomingBookings.First();
                    var restUpcoming = upcomingBookings.Skip(1);
                }

                <div class="md:col-span-2 relative group overflow-hidden rounded-2xl bg-white custom-shadow flex flex-col md:flex-row h-full border border-[#cbc4cf]/30">
                    <div class="w-full md:w-2/5 relative h-64 md:h-full">
                        <img alt="Movie Poster" class="absolute inset-0 w-full h-full object-cover grayscale-[20%] group-hover:grayscale-0 transition-all duration-700" 
                             src="@(string.IsNullOrEmpty(firstUpcoming.Showtime.Movie.ImageUrl) ? "https://via.placeholder.com/400x600" : firstUpcoming.Showtime.Movie.ImageUrl)" />
                        <div class="absolute inset-0 bg-gradient-to-t md:bg-gradient-to-r from-transparent to-white opacity-40"></div>
                    </div>
                    <div class="w-full md:w-3/5 p-8 flex flex-col justify-between bg-white z-10">
                        <div>
                            <div class="flex justify-between items-start mb-4">
                                <span class="bg-[#eaddff] text-[#4e3e6e] px-3 py-1 rounded-full text-[10px] font-bold tracking-tighter uppercase">@localizer["Label_PremiereNight"]</span>
                                <span class="material-symbols-outlined text-[#645485]" data-icon="qr_code_2">qr_code_2</span>
                            </div>
                            <h3 class="text-4xl font-extrabold font-['Manrope'] text-[#1a1c1c] mb-2 leading-tight">@firstUpcoming.Showtime.Movie.Title</h3>
                            <div class="space-y-3 mt-6">
                                <div class="flex items-center gap-3 text-[#49454e]">
                                    <span class="material-symbols-outlined text-xl">calendar_today</span>
                                    <span class="font-medium">@firstUpcoming.Showtime.StartTime.ToString("dddd, MMM dd • HH:mm")</span>
                                </div>
                                <div class="flex items-center gap-3 text-[#49454e]">
                                    <span class="material-symbols-outlined text-xl">chair</span>
                                    <span class="font-medium">@string.Format(localizer["Label_OrderRef"].Value, firstUpcoming.ConfirmationCode, firstUpcoming.Tickets.Count())</span>
                                </div>
                            </div>
                        </div>
                        <div class="flex flex-wrap gap-4 mt-8">
                            <a asp-controller="Booking" asp-action="DownloadTickets" asp-route-bookingId="@firstUpcoming.Id" class="primary-gradient text-white px-8 py-4 rounded-lg font-bold text-sm shadow-md hover:scale-[0.98] transition-all flex items-center gap-2">
                                <span class="material-symbols-outlined">picture_as_pdf</span>
                                @localizer["Button_DownloadPDF"]
                            </a>
                        </div>
                    </div>
                </div>

                @foreach(var booking in restUpcoming)
                {
                    <div class="bg-white rounded-2xl custom-shadow flex flex-col overflow-hidden border border-[#cbc4cf]/30">
                        <div class="h-48 relative overflow-hidden group">
                            <img alt="Movie Poster" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" 
                                 src="@(string.IsNullOrEmpty(booking.Showtime.Movie.ImageUrl) ? "https://via.placeholder.com/400x300" : booking.Showtime.Movie.ImageUrl)" />
                        </div>
                        <div class="p-6 flex-grow flex flex-col justify-between">
                            <div>
                                <h3 class="text-2xl font-bold font-['Manrope'] text-[#1a1c1c] mb-4 truncate">@booking.Showtime.Movie.Title</h3>
                                <div class="space-y-2 text-sm text-[#49454e] font-medium">
                                    <div class="flex items-center gap-2">
                                        <span class="material-symbols-outlined text-lg">event</span>
                                        <span>@booking.Showtime.StartTime.ToString("MMM dd • HH:mm")</span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <span class="material-symbols-outlined text-lg">receipt_long</span>
                                        <span>#@booking.ConfirmationCode</span>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-6 flex items-center justify-between border-t border-[#f3f3f3] pt-4">
                                <span class="text-xs font-bold text-[#795061] uppercase tracking-widest">@booking.Tickets.Count() @localizer["Label_Tickets"]</span>
                                <a asp-controller="Booking" asp-action="DownloadTickets" asp-route-bookingId="@booking.Id" class="text-[#645485] font-bold text-sm hover:underline flex items-center gap-1">
                                    @localizer["Button_GetPDF"]
                                    <span class="material-symbols-outlined text-base">download</span>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <section class="mb-20 grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 bg-[#f3f3f3] rounded-2xl flex items-center gap-4 hover:bg-[#e8e8e8] transition-colors cursor-pointer group border border-[#cbc4cf]/30">
            <div class="w-12 h-12 rounded-full bg-white flex items-center justify-center text-[#645485] group-hover:scale-110 transition-transform shadow-sm">
                <span class="material-symbols-outlined">receipt_long</span>
            </div>
            <div>
                <h4 class="font-bold text-[#1a1c1c] text-sm">@localizer["Heading_TotalSpent"]</h4>
                <p class="text-xs text-[#49454e]">@string.Format(localizer["Label_Lifetime"].Value, localizer["Symbol_Currency"].Value + Model.Sum(m => m.TotalAmount).ToString("F2"))</p>
            </div>
        </div>
        <div class="p-6 bg-[#f3f3f3] rounded-2xl flex items-center gap-4 hover:bg-[#e8e8e8] transition-colors cursor-pointer group border border-[#cbc4cf]/30">
            <div class="w-12 h-12 rounded-full bg-white flex items-center justify-center text-[#645485] group-hover:scale-110 transition-transform shadow-sm">
                <span class="material-symbols-outlined">calendar_add_on</span>
            </div>
            <div>
                <h4 class="font-bold text-[#1a1c1c] text-sm">@localizer["Heading_SyncCalendar"]</h4>
                <p class="text-xs text-[#49454e]">@localizer["Label_SyncDetails"]</p>
            </div>
        </div>
        <div class="p-6 bg-[#f3f3f3] rounded-2xl flex items-center gap-4 hover:bg-[#e8e8e8] transition-colors cursor-pointer group border border-[#cbc4cf]/30">
            <div class="w-12 h-12 rounded-full bg-white flex items-center justify-center text-[#645485] group-hover:scale-110 transition-transform shadow-sm">
                <span class="material-symbols-outlined">share</span>
            </div>
            <div>
                <h4 class="font-bold text-[#1a1c1c] text-sm">@localizer["Heading_ShareExperience"]</h4>
                <p class="text-xs text-[#49454e]">@localizer["Label_ShareDetails"]</p>
            </div>
        </div>
    </section>

    <section>
        <div class="flex items-center justify-between mb-8">
            <h2 class="text-3xl font-bold font-['Manrope'] text-[#1a1c1c] opacity-60">@localizer["Heading_PastMemories"]</h2>
        </div>

        @if (!pastBookings.Any())
        {
            <p class="text-[#49454e] italic">@localizer["Message_NoPastMemories"]</p>
        }
        else
        {
            <div class="bg-[#f3f3f3] rounded-2xl overflow-hidden p-2 border border-[#cbc4cf]/30">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-separate border-spacing-y-2 min-w-[600px]">
                        <thead>
                            <tr class="text-[10px] font-bold text-[#7a757f] uppercase tracking-widest">
                                <th class="px-6 py-4">@localizer["Table_MovieExperience"]</th>
                                <th class="px-6 py-4">@localizer["Table_VisitedOn"]</th>
                                <th class="px-6 py-4">@localizer["Table_Amount"]</th>
                                <th class="px-6 py-4 text-right">@localizer["Table_Action"]</th>
                            </tr>
                        </thead>
                        <tbody class="space-y-2">
                            @foreach (var booking in pastBookings)
                            {
                                <tr class="bg-white group hover:bg-[#fafafa] transition-colors shadow-sm">
                                    <td class="px-6 py-5 rounded-l-xl">
                                        <div class="flex items-center gap-4">
                                            <div class="w-12 h-16 rounded overflow-hidden grayscale group-hover:grayscale-0 transition-all border border-[#cbc4cf]/20">
                                                <img alt="@booking.Showtime.Movie.Title" class="w-full h-full object-cover" 
                                                     src="@(string.IsNullOrEmpty(booking.Showtime.Movie.ImageUrl) ? "https://via.placeholder.com/100x150" : booking.Showtime.Movie.ImageUrl)" />
                                            </div>
                                            <div>
                                                <span class="block font-bold text-[#1a1c1c]">@booking.Showtime.Movie.Title</span>
                                                <span class="text-xs text-[#49454e]">@localizer["Label_BookingRef"]: #@booking.ConfirmationCode</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-5">
                                        <span class="text-sm font-medium text-[#49454e]">@booking.Showtime.StartTime.ToString("MMM dd, yyyy")</span>
                                    </td>
                                    <td class="px-6 py-5">
                                        <span class="text-sm font-bold text-[#645485]">@localizer["Symbol_Currency"]@booking.TotalAmount.ToString("F2")</span>
                                    </td>
                                    <td class="px-6 py-5 text-right rounded-r-xl">
                                        <a asp-controller="Booking" asp-action="DownloadTickets" asp-route-bookingId="@booking.Id" class="text-[#645485] font-bold text-xs hover:bg-[#eaddff] px-4 py-2 rounded-lg transition-colors inline-flex items-center gap-1">
                                            <span class="material-symbols-outlined text-[16px]">receipt</span> @localizer["Button_Receipt"]
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </section>
</div>