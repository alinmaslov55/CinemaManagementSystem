@model CinemaSystem.Models.Entities.Booking

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">

            @* --- SUCCESS HEADER --- *@
            <div class="text-center mb-4">
                <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
                <h2 class="mt-3 fw-bold">Payment Successful!</h2>
                <p class="text-muted">Your seats are secured. An email confirmation has been sent.</p>
            </div>

            @* --- RECEIPT CARD --- *@
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden mb-5">
                <div class="card-header bg-primary text-white text-center py-3 border-0">
                    <h5 class="mb-0 fw-bold">Order Confirmation</h5>
                </div>

                <div class="card-body p-4 p-md-5 bg-light">

                    <div class="row mb-4 pb-4 border-bottom">
                        <div class="col-sm-6 mb-3 mb-sm-0">
                            <h6 class="text-muted text-uppercase small fw-bold">Confirmation Code</h6>
                            <h3 class="fw-bold text-dark font-monospace tracking-wide">@Model.ConfirmationCode</h3>
                        </div>
                        <div class="col-sm-6 text-sm-end">
                            <h6 class="text-muted text-uppercase small fw-bold">Order Total</h6>
                            <h3 class="fw-bold text-success">$@Model.TotalAmount.ToString("F2")</h3>
                            <span class="badge bg-success">@Model.PaymentStatus.ToString()</span>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-4 col-md-3">
                            <img src="@(string.IsNullOrEmpty(Model.Showtime.Movie.ImageUrl) ? "https://via.placeholder.com/150x225" : Model.Showtime.Movie.ImageUrl)"
                                 class="img-fluid rounded shadow-sm w-100" alt="@Model.Showtime.Movie.Title" />
                        </div>
                        <div class="col-8 col-md-9 d-flex flex-column justify-content-center">
                            <h4 class="fw-bold mb-1">@Model.Showtime.Movie.Title</h4>
                            <p class="mb-1"><i class="bi bi-geo-alt-fill text-danger"></i> <strong>@Model.Showtime.CinemaHall.Cinema.Name</strong></p>
                            <p class="mb-1"><i class="bi bi-door-open-fill text-secondary"></i> Hall: @Model.Showtime.CinemaHall.Name</p>
                            <p class="mb-0"><i class="bi bi-calendar-event text-primary"></i> @Model.Showtime.StartTime.ToString("dddd, MMM dd, yyyy - HH:mm")</p>
                        </div>
                    </div>

                    <h6 class="fw-bold text-uppercase text-muted mb-3 mt-4">Your Digital Tickets</h6>

                    @* --- DIGITAL TICKETS LOOP --- *@
                    <div class="d-flex flex-column gap-3">
                        @foreach (var ticket in Model.Tickets)
                        {
                            <div class="bg-white border rounded p-3 shadow-sm d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="text-muted small d-block text-uppercase">Seat</span>
                                    <span class="fw-bold fs-4">@ticket.Seat.Row@ticket.Seat.Column</span>
                                    <span class="badge bg-secondary ms-2">@ticket.Seat.SeatType</span>
                                </div>
                                <div class="text-end">
                                    <span class="text-muted small d-block">Ticket ID</span>
                                    <span class="font-monospace small">@ticket.Barcode.Substring(0, 8).ToUpper()</span>
                                </div>
                            </div>
                        }
                    </div>

                </div>

                <div class="card-footer bg-white text-center py-4 border-top-0">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary px-4 fw-bold">Return to Home</a>
                    @* This button will eventually link to the User Dashboard *@
                    <button class="btn btn-primary px-4 fw-bold ms-2">View My Tickets</button>
                </div>
            </div>

        </div>
    </div>
</div>