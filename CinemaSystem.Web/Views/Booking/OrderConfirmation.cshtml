@using CinemaSystem.Utility
@using Microsoft.AspNetCore.Mvc.Localization
@using CinemaSystem.Web
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> localizer
@model CinemaSystem.Models.Entities.Booking

@{
    ViewData["Title"] = localizer["PageTitle_OrderConfirmed"];
    Layout = "_Layout";

    var seatStrings = Model.Tickets.Select(t => $"{t.Seat.Row}{t.Seat.Column}");
    string seatsDisplay = string.Join(", ", seatStrings);

    byte[] qrBytes = QRCodeHelper.GenerateQRCodeBytes(Model.ConfirmationCode);
    string qrBase64 = Convert.ToBase64String(qrBytes);
}

<style>
    .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
    .signature-gradient { background: linear-gradient(135deg, #645485 0%, #7d6c9f 100%); }
    .success-glow { text-shadow: 0 0 20px rgba(100, 84, 133, 0.2); }
</style>

<div class="bg-surface text-on-surface font-body antialiased min-h-screen pt-20 pb-20">
    <main class="px-6 max-w-6xl mx-auto">
        
        <div class="text-center mb-16 space-y-4">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-primary-fixed text-primary mb-6 animate-pulse">
                <span class="material-symbols-outlined text-4xl" data-weight="fill" style="font-variation-settings: 'FILL' 1;">check_circle</span>
            </div>
            <h1 class="text-4xl md:text-5xl font-extrabold font-headline tracking-tighter text-primary success-glow">
                @localizer["Heading_JourneyConfirmed"]
            </h1>
            <p class="text-on-surface-variant font-body text-lg max-w-xl mx-auto">
                @localizer["Message_PrepareTakeoff"]
            </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
            
            <div class="lg:col-span-7 space-y-8">
                <div class="relative group">
                    <div class="bg-white rounded-3xl shadow-[0px_20px_40px_rgba(100,84,133,0.08)] overflow-hidden flex flex-col md:flex-row relative border border-outline-variant/20">
                        
                        <div class="md:w-1/3 aspect-[2/3] relative shrink-0">
                            <img class="w-full h-full object-cover" alt="@Model.Showtime.Movie.Title" 
                                 src="@(string.IsNullOrEmpty(Model.Showtime.Movie.ImageUrl) ? "https://via.placeholder.com/300x450" : Model.Showtime.Movie.ImageUrl)" />
                            <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent"></div>
                            <div class="absolute bottom-4 left-4 right-4">
                                <span class="bg-primary/90 text-white text-[10px] font-bold px-2 py-1 rounded uppercase tracking-widest mb-2 inline-block">@Model.Showtime.CinemaHall.HallType</span>
                                <h3 class="text-white font-headline font-bold text-lg leading-tight line-clamp-2">@Model.Showtime.Movie.Title</h3>
                            </div>
                        </div>
                        
                        <div class="md:w-2/3 p-8 flex flex-col justify-between bg-white relative z-10">
                            <div class="space-y-6">
                                <div class="flex justify-between items-start gap-4">
                                    <div>
                                        <p class="text-[10px] uppercase tracking-widest text-outline font-bold mb-1">@localizer["Label_DateTime"]</p>
                                        <p class="text-on-surface font-semibold font-headline text-sm">@Model.Showtime.StartTime.ToString("dddd, MMM dd • HH:mm")</p>
                                    </div>
                                    <div class="text-right shrink-0">
                                        <p class="text-[10px] uppercase tracking-widest text-outline font-bold mb-1">@localizer["Label_Screen"]</p>
                                        <p class="text-on-surface font-semibold font-headline text-sm">@Model.Showtime.CinemaHall.Name</p>
                                    </div>
                                </div>
                                
                                <div class="grid grid-cols-2 gap-4 py-6 border-y border-outline-variant/20">
                                    <div>
                                        <p class="text-[10px] uppercase tracking-widest text-outline font-bold mb-1">@localizer["Label_SelectedSeats"]</p>
                                        <p class="text-on-surface font-semibold font-headline text-sm">@seatsDisplay</p>
                                    </div>
                                    <div class="text-right">
                                        <p class="text-[10px] uppercase tracking-widest text-outline font-bold mb-1">@localizer["Label_BookingRef"]</p>
                                        <p class="text-primary font-bold font-headline text-sm">@Model.ConfirmationCode</p>
                                    </div>
                                </div>
                                
                                <div class="flex items-center justify-between gap-6 pt-4">
                                    <div class="flex-1 space-y-2">
                                        <div class="h-2 w-full bg-surface-container rounded-full overflow-hidden">
                                            <div class="h-full w-2/3 signature-gradient"></div>
                                        </div>
                                        <p class="text-[10px] text-outline italic font-medium">@localizer["Message_ScanEntrance"]</p>
                                    </div>
                                    <div class="w-24 h-24 bg-surface-container-low p-2 rounded-xl border border-outline-variant/30">
                                        <img class="w-full h-full object-contain mix-blend-multiply opacity-90" alt="Order QR Code" src="data:image/png;base64,@qrBase64" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="hidden md:block absolute left-1/3 top-0 -translate-x-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-surface border-b border-outline-variant/20"></div>
                    <div class="hidden md:block absolute left-1/3 bottom-0 -translate-x-1/2 translate-y-1/2 w-8 h-8 rounded-full bg-surface border-t border-outline-variant/20"></div>
                </div>

                <div class="mt-8">
                    <a asp-controller="Booking" asp-action="DownloadTickets" asp-route-bookingId="@Model.Id" class="w-full signature-gradient text-white py-4 px-6 rounded-xl font-headline font-bold flex items-center justify-center gap-2 shadow-lg shadow-primary/20 hover:shadow-xl transition-all active:scale-95 text-sm">
                        <span class="material-symbols-outlined text-lg">download</span>
                        @localizer["Button_DownloadDigitalTicket"]
                    </a>
                </div>
            </div>

            <div class="lg:col-span-5 space-y-8">
                
                @if (Model.BookingFnBs != null && Model.BookingFnBs.Any())
                {
                    <div class="bg-white p-8 rounded-3xl space-y-6 shadow-sm border border-outline-variant/20">
                        <h2 class="font-headline font-bold text-xl text-primary flex items-center gap-2">
                            <span class="material-symbols-outlined">restaurant</span>
                            @localizer["Heading_PreorderedTreats"]
                        </h2>
                        
                        <div class="space-y-4">
                            @foreach (var item in Model.BookingFnBs)
                            {
                                <div class="flex items-center gap-4 p-4 bg-surface-container-lowest rounded-2xl border border-outline-variant/20 shadow-sm">
                                    <div class="w-16 h-16 rounded-xl bg-surface-container flex items-center justify-center overflow-hidden shrink-0">
                                        @if (!string.IsNullOrEmpty(item.FnBProduct.ImageUrl))
                                        {
                                            <img src="@item.FnBProduct.ImageUrl" class="w-full h-full object-cover" alt="@item.FnBProduct.Name" />
                                        }
                                        else
                                        {
                                            <span class="material-symbols-outlined text-3xl text-outline-variant">fastfood</span>
                                        }
                                    </div>
                                    <div class="flex-1">
                                        <p class="font-bold text-on-surface text-sm">@item.FnBProduct.Name</p>
                                        <p class="text-xs text-on-surface-variant mt-0.5">@localizer["Label_Qty"]: @item.Quantity</p>
                                    </div>
                                    <span class="font-headline font-bold text-primary">@localizer["Symbol_Currency"]@((item.Quantity * item.PriceAtPurchase).ToString("F2"))</span>
                                </div>
                            }
                        </div>
                        
                        <div class="pt-4 border-t border-outline-variant/20 flex justify-between items-center">
                            <span class="text-on-surface-variant font-medium text-sm">@localizer["Label_TotalPaid"]</span>
                            <span class="text-2xl font-headline font-extrabold text-primary">@localizer["Symbol_Currency"]@Model.TotalAmount.ToString("F2")</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="bg-white p-8 rounded-3xl space-y-4 shadow-sm border border-outline-variant/20">
                        <h2 class="font-headline font-bold text-xl text-primary flex items-center gap-2 mb-4">
                            <span class="material-symbols-outlined">receipt_long</span>
                            @localizer["Heading_PaymentSummary"]
                        </h2>
                        <div class="flex justify-between items-center">
                            <span class="text-on-surface-variant font-medium text-sm">@localizer["Label_Status"]</span>
                            <span class="text-emerald-600 font-bold text-sm bg-emerald-50 px-2 py-1 rounded border border-emerald-100 uppercase tracking-widest text-[10px]">@Model.PaymentStatus.ToString()</span>
                        </div>
                        <div class="pt-4 border-t border-outline-variant/20 flex justify-between items-center">
                            <span class="text-on-surface-variant font-medium text-sm">@localizer["Label_TotalPaid"]</span>
                            <span class="text-2xl font-headline font-extrabold text-primary">@localizer["Symbol_Currency"]@Model.TotalAmount.ToString("F2")</span>
                        </div>
                    </div>
                }

                <div class="bg-primary-fixed/40 p-6 rounded-3xl border border-primary/20">
                    <div class="flex gap-4">
                        <span class="material-symbols-outlined text-primary shrink-0">info</span>
                        <div>
                            <p class="font-bold font-headline text-primary mb-1 text-sm">@localizer["Heading_CinemaProtocol"]</p>
                            <p class="text-xs text-on-surface-variant leading-relaxed">
                                @(Model.BookingFnBs != null && Model.BookingFnBs.Any() ? localizer["Message_ProtocolSnacks"].Value : localizer["Message_ProtocolNoSnacks"].Value)
                            </p>
                        </div>
                    </div>
                </div>

                <a asp-controller="Home" asp-action="Index" class="flex items-center justify-center gap-2 text-outline hover:text-primary transition-colors font-bold group text-sm">
                    <span class="material-symbols-outlined group-hover:-translate-x-1 transition-transform text-[18px]">arrow_back</span>
                    @localizer["Button_BackToHome"]
                </a>
            </div>
            
        </div>
    </main>
</div>