@using Microsoft.AspNetCore.Mvc.Localization
@using CinemaSystem.Web
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> localizer

@{
    ViewData["Title"] = localizer["PageTitle_PreorderFood"];
    Layout = "_Layout";
    var showtimeId = Context.Request.Query["showtimeId"].ToString();
}

<style>
    .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
    .hide-scrollbar::-webkit-scrollbar { display: none; }
    .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<div class="bg-[#f9f9f9] font-['Inter'] text-[#1a1c1c] antialiased min-h-screen pt-12 pb-32">
    <main class="max-w-[1440px] mx-auto px-6 md:px-12">
        
        <div class="flex flex-col items-center mb-12">
            <div class="flex items-center gap-2 md:gap-4 mb-4 overflow-x-auto hide-scrollbar w-full justify-center">
                <!-- Breadcrumbs... -->
                <div class="flex items-center gap-2 opacity-50 shrink-0">
                    <div class="w-8 h-8 rounded-full bg-[#645485]/20 text-[#645485] flex items-center justify-center text-xs font-bold">1</div>
                    <span class="text-xs font-['Manrope'] uppercase tracking-widest font-bold text-[#645485] hidden md:block">@localizer["Breadcrumb_Details"]</span>
                </div>
                <div class="w-8 md:w-12 h-[1px] bg-[#cbc4cf]/50 shrink-0"></div>
                <div class="flex items-center gap-2 opacity-50 shrink-0">
                    <div class="w-8 h-8 rounded-full bg-[#645485]/20 text-[#645485] flex items-center justify-center text-xs font-bold">2</div>
                    <span class="text-xs font-['Manrope'] uppercase tracking-widest font-bold text-[#645485] hidden md:block">@localizer["Breadcrumb_Seats"]</span>
                </div>
                <div class="w-8 md:w-12 h-[1px] bg-[#cbc4cf]/50 shrink-0"></div>
                <div class="flex items-center gap-2 shrink-0">
                    <div class="w-8 h-8 rounded-full bg-[#645485] text-white flex items-center justify-center text-xs font-bold shadow-md">3</div>
                    <span class="text-xs font-['Manrope'] uppercase tracking-widest font-bold text-[#1a1c1c]">@localizer["Breadcrumb_Food"]</span>
                </div>
                <div class="w-8 md:w-12 h-[1px] bg-[#cbc4cf]/50 shrink-0"></div>
                <div class="flex items-center gap-2 opacity-50 shrink-0">
                    <div class="w-8 h-8 rounded-full bg-[#e2e2e2] text-[#7a757f] flex items-center justify-center text-xs font-bold">4</div>
                    <span class="text-xs font-['Manrope'] uppercase tracking-widest font-bold text-[#7a757f] hidden md:block">@localizer["Breadcrumb_Checkout"]</span>
                </div>
            </div>
        </div>

        <div class="mb-10 text-center md:text-left">
            <h1 class="font-['Manrope'] text-4xl font-extrabold tracking-tight text-[#645485] mb-2">@localizer["Heading_EnhanceExperience"]</h1>
            <p class="text-[#49454e] font-medium">@localizer["Subheading_SkipQueue"]</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-6 mb-16">
            
            <div class="md:col-span-8 relative overflow-hidden rounded-[2rem] h-[350px] min-h-[300px] group bg-[#7d6c9f] shadow-lg">
                <img class="absolute inset-0 w-full h-full object-cover mix-blend-overlay opacity-60 transition-transform duration-700 group-hover:scale-105" 
                     alt="Gourmet cinema popcorn" 
                     src="https://lh3.googleusercontent.com/aida-public/AB6AXuBOtC5kWiIrU0mRCzUzbYq6TixGn75ifW45h2_S6BrSuZ2mt43x2d-Dd0WTeL9kpk_t8QEfQD5RiHmX-IaldJxiwOWfcqhTWCHTAAz2V3Fdh48RbngJB19WYW6gYiHzKbcYfJEwi2jWMYU_i0_F7kWn-mt47chaxikbVlqepzgnbwU6xtSsaDc2fmAgQWaeW67Kl5S93LTuQrM-uzSK9I_ctoJSCjTFtDbeHX51k1fvgg8RJtyvpjLHzgn7sCfVxnCEq00IPLUoTkA"/>
                <div class="absolute inset-0 bg-gradient-to-t from-[#645485]/90 via-[#645485]/40 to-transparent"></div>
                <div class="absolute bottom-0 left-0 p-8 w-full flex flex-col md:flex-row justify-between items-start md:items-end gap-4">
                    <div>
                        <span class="bg-[#ffd8e6] text-[#301120] text-[10px] font-bold tracking-widest uppercase px-3 py-1 rounded-full mb-4 inline-block shadow-sm">@localizer["Label_BestSeller"]</span>
                        <h2 class="text-white font-['Manrope'] text-3xl font-bold mb-2">@localizer["Heading_UltimateCombo"]</h2>
                        <p class="text-[#d1bdf6] max-w-md mb-2">@localizer["Desc_UltimateCombo"]</p>
                    </div>
                    <button onclick="addComboToCart()" class="bg-white text-[#645485] px-6 py-3.5 rounded-xl font-bold text-sm transition-transform active:scale-95 shadow-xl hover:-translate-y-1 whitespace-nowrap">
                        @string.Format(localizer["Button_AddToOrder"].Value, localizer["Symbol_Currency"].Value + "24.00")
                    </button>
                </div>
            </div>

            <div class="md:col-span-4 flex flex-col gap-4">
                <div class="bg-[#f3f3f3] p-6 rounded-[2rem] flex flex-col justify-center flex-1 border border-[#cbc4cf]/30 shadow-sm">
                    <h3 class="font-['Manrope'] font-bold text-lg text-[#645485] mb-4">@localizer["Heading_JumpTo"]</h3>
                    <div class="grid grid-cols-2 gap-3">
                        <a href="#popcorn" class="flex flex-col items-center justify-center gap-2 p-4 bg-white rounded-2xl hover:bg-[#eaddff] transition-colors border border-[#cbc4cf]/20 shadow-sm group">
                            <span class="material-symbols-outlined text-[#645485] group-hover:scale-110 transition-transform">fastfood</span>
                            <span class="text-[10px] font-bold uppercase tracking-widest text-[#1a1c1c]">@localizer["Label_Popcorn"]</span>
                        </a>
                        <a href="#beverages" class="flex flex-col items-center justify-center gap-2 p-4 bg-white rounded-2xl hover:bg-[#eaddff] transition-colors border border-[#cbc4cf]/20 shadow-sm group">
                            <span class="material-symbols-outlined text-[#645485] group-hover:scale-110 transition-transform">local_bar</span>
                            <span class="text-[10px] font-bold uppercase tracking-widest text-[#1a1c1c]">@localizer["Label_Beverages"]</span>
                        </a>
                        <a href="#" class="flex flex-col items-center justify-center gap-2 p-4 bg-white rounded-2xl hover:bg-[#eaddff] transition-colors border border-[#cbc4cf]/20 shadow-sm group opacity-60">
                            <span class="material-symbols-outlined text-[#645485] group-hover:scale-110 transition-transform">icecream</span>
                            <span class="text-[10px] font-bold uppercase tracking-widest text-[#1a1c1c]">@localizer["Label_Sweets"]</span>
                        </a>
                        <a href="#" class="flex flex-col items-center justify-center gap-2 p-4 bg-white rounded-2xl hover:bg-[#eaddff] transition-colors border border-[#cbc4cf]/20 shadow-sm group opacity-60">
                            <span class="material-symbols-outlined text-[#645485] group-hover:scale-110 transition-transform">restaurant</span>
                            <span class="text-[10px] font-bold uppercase tracking-widest text-[#1a1c1c]">@localizer["Label_HotFood"]</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <section id="popcorn" class="mb-16 pt-4">
            <div class="flex items-center justify-between mb-8">
                <h2 class="font-['Manrope'] text-2xl font-extrabold text-[#645485]">@localizer["Heading_FreshlyPopped"]</h2>
                <div class="h-px flex-1 bg-[#cbc4cf]/30 mx-6"></div>
            </div>
            <!-- Grid-ul tău de produse rămâne aici, înlocuiește $ cu @localizer["Symbol_Currency"] -->
        </section>

        <section id="beverages" class="mb-12 pt-4">
            <div class="flex items-center justify-between mb-8">
                <h2 class="font-['Manrope'] text-2xl font-extrabold text-[#645485]">@localizer["Heading_IcedBeverages"]</h2>
                <div class="h-px flex-1 bg-[#cbc4cf]/30 mx-6"></div>
            </div>
            <!-- Grid-ul tău de băuturi rămâne aici, înlocuiește $ cu @localizer["Symbol_Currency"] -->
        </section>

    </main>

    <div id="floatingCartBar" class="fixed bottom-0 left-0 w-full z-40 bg-white/90 backdrop-blur-lg shadow-[0_-10px_30px_rgba(100,84,133,0.06)] px-6 md:px-12 py-5 flex flex-col md:flex-row items-center justify-between gap-4 border-t border-[#cbc4cf]/20 transition-transform duration-500 translate-y-full">
        
        <div class="flex items-center gap-6 w-full md:w-auto justify-between md:justify-start">
            <div class="hidden md:flex items-center justify-center w-12 h-12 rounded-full bg-[#eaddff] text-[#645485] shadow-inner">
                <span class="material-symbols-outlined">shopping_bag</span>
            </div>
            <div>
                <p class="text-[10px] font-bold text-[#7a757f] uppercase tracking-widest mb-0.5">@localizer["Label_YourFoodBeverages"]</p>
                <p class="font-['Manrope'] font-extrabold text-2xl text-[#645485]" id="cartTotalText">0 Items — @localizer["Symbol_Currency"]0.00</p>
            </div>
        </div>

        <div class="flex items-center gap-3 w-full md:w-auto">
            <a href="/Booking/Checkout?showtimeId=@showtimeId" class="flex-1 md:flex-none px-6 py-3.5 text-[#645485] bg-[#f3f3f3] hover:bg-[#e2e2e2] font-bold transition-colors rounded-xl active:scale-95 text-sm text-center">
                @localizer["Button_SkipFood"]
            </a>
            <button id="btnContinue" onclick="submitFoodOrder()" class="flex-1 md:flex-none px-8 py-3.5 bg-[#645485] hover:bg-[#7d6c9f] text-white font-bold rounded-xl shadow-lg shadow-[#645485]/30 hover:shadow-xl transition-all active:scale-95 text-sm flex justify-center items-center gap-2">
                @localizer["Button_ContinueToCheckout"] <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
            </button>
        </div>
    </div>
    
    <form id="foodOrderForm" method="post" action="/Booking/SaveFood" class="hidden">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ShowtimeId" value="@showtimeId" />
        <input type="hidden" name="CartJson" id="cartJsonInput" />
    </form>
</div>

@section Scripts {
    <script>
        const cart = new Map();
        const floatingBar = document.getElementById('floatingCartBar');
        const cartTotalText = document.getElementById('cartTotalText');
        const currencySymbol = '@localizer["Symbol_Currency"].Value';
        const itemsLabel = 'Items'; // Ideal ar fi un replace din dicționar, ex: '@localizer["Label_Items"]'

        document.querySelectorAll('.food-item').forEach(item => {
            const id = item.getAttribute('data-id');
            const name = item.getAttribute('data-name');
            const price = parseFloat(item.getAttribute('data-price'));
            
            const btnMinus = item.querySelector('.btn-minus');
            const btnPlus = item.querySelector('.btn-plus');
            const display = item.querySelector('.qty-display');

            btnPlus.addEventListener('click', () => updateQty(id, name, price, 1, display));
            btnMinus.addEventListener('click', () => updateQty(id, name, price, -1, display));
        });

        function addComboToCart() {
            const comboId = "99"; 
            const comboName = "The Ultimate Combo";
            const comboPrice = 24.00;
            
            let current = cart.get(comboId) || { name: comboName, price: comboPrice, qty: 0 };
            current.qty += 1;
            cart.set(comboId, current);
            
            updateCartUI();
            
            // Textul din alert() a fost localizat!
            alert("@localizer["Alert_ComboAdded"]");
        }

        function updateQty(id, name, price, delta, displayElem) {
            let current = cart.get(id) || { name, price, qty: 0 };
            current.qty += delta;

            if (current.qty <= 0) {
                cart.delete(id);
                displayElem.innerText = "0";
                displayElem.classList.add("text-[#b5b0ba]");
                displayElem.classList.remove("text-[#1a1c1c]");
            } else {
                cart.set(id, current);
                displayElem.innerText = current.qty;
                displayElem.classList.remove("text-[#b5b0ba]");
                displayElem.classList.add("text-[#1a1c1c]");
            }
            
            updateCartUI();
        }

        function updateCartUI() {
            let totalItems = 0;
            let totalPrice = 0.0;

            cart.forEach((item) => {
                totalItems += item.qty;
                totalPrice += (item.qty * item.price);
            });

            if (totalItems > 0) {
                // Utilizarea simbolului valutar dinamic
                cartTotalText.innerText = `${totalItems} ${itemsLabel} — ${currencySymbol}${totalPrice.toFixed(2)}`;
                floatingBar.classList.remove('translate-y-full');
            } else {
                floatingBar.classList.add('translate-y-full');
            }
        }

        function submitFoodOrder() {
            const cartArray = [];
            cart.forEach((value, key) => {
                cartArray.push({
                    ItemId: parseInt(key),
                    Quantity: value.qty
                });
            });
            document.getElementById('cartJsonInput').value = JSON.stringify(cartArray);
            document.getElementById('foodOrderForm').submit();
        }
        
        updateCartUI();
    </script>
}