@model CinemaSystem.Models.ViewModels.HomeVM
@using CinemaSystem.Models.Data.Enums

@{
    ViewData["Title"] = "Home Page";
}

<div class="container-fluid p-0">

    @* ==========================================
       ZONE 1: THE HERO CAROUSEL       
       ========================================== *@
    @if (Model.HeroMovies != null && Model.HeroMovies.Any())
    {
        <div id="heroCarousel" class="carousel slide mb-5 shadow-lg" data-bs-ride="carousel">
            <div class="carousel-inner">
                @{
                    var first = true;
                }
                @foreach (var hero in Model.HeroMovies)
                {
                    <div class="carousel-item @(first ? "active" : "")">
                        <div class="carousel-overlay position-absolute w-100 h-100" style="background: rgba(0,0,0,0.6); z-index: 1;"></div>
                        <img src="@(string.IsNullOrEmpty(hero.Movie.ImageUrl) ? "https://via.placeholder.com/1200x500" : hero.Movie.ImageUrl)"
                             class="d-block w-100" style="height: 500px; object-fit: cover; object-position: center top;" alt="@hero.Movie.Title">

                        <div class="carousel-caption d-none d-md-block text-start" style="z-index: 2; bottom: 20%;">
                            <span class="badge bg-warning text-dark mb-2 fs-6">Top Rated: @hero.AverageRating.ToString("0.0") / 5.0</span>
                            <h1 class="display-3 fw-bold text-white shadow-sm">@hero.Movie.Title</h1>
                            <p class="lead text-light w-75 text-truncate">@hero.Movie.Description</p>
                            <a asp-action="Details" asp-route-id="@hero.Movie.Id" class="btn btn-primary btn-lg fw-bold px-5 rounded-pill shadow">Get Tickets</a>
                        </div>
                    </div>
                    first = false;
                }
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev" style="z-index: 3;">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next" style="z-index: 3;">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>
    }

    <div class="container">

        @* ==========================================
           ZONE 2: THE UTILITY BAR (SEARCH & FILTER)
           ========================================== *@
        <form method="get" asp-action="Index" class="row bg-white p-4 rounded-4 shadow-sm mb-5 border" style="margin-top: -80px; position: relative; z-index: 10;">
            <div class="col-md-4 mb-3 mb-md-0">
                <label class="form-label fw-bold text-muted small text-uppercase">Search Title</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-primary"></i></span>
                    <input type="text" name="searchString" class="form-control border-start-0 ps-0" placeholder="e.g. Inception..." value="@Model.CurrentSearch" />
                </div>
            </div>

            <div class="col-md-3 mb-3 mb-md-0">
                <label class="form-label fw-bold text-muted small text-uppercase">Genre</label>
                <select name="category" asp-items="Html.GetEnumSelectList<MovieCategory>()" class="form-select">
                    <option value="">All Genres</option>
                </select>
            </div>

            <div class="col-md-3 mb-3 mb-md-0">
                <label class="form-label fw-bold text-muted small text-uppercase">Date</label>
                <input type="date" name="selectedDate" class="form-control" value="@Model.SelectedDate?.ToString("yyyy-MM-dd")" />
            </div>

            <div class="col-md-2 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary w-100 fw-bold">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-clockwise"></i></a>
            </div>
        </form>

        @* ==========================================
           ZONE 3: PRIMARY FEED (NOW PLAYING)
           ========================================== *@
        <div class="mb-5">
            <h3 class="fw-bold border-bottom pb-2 mb-4 text-uppercase">Now Playing <i class="bi bi-film text-primary"></i></h3>

            @if (!Model.NowPlaying.Any())
            {
                <div class="alert alert-info text-center py-4">No movies found matching your current filters.</div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
                    @foreach (var item in Model.NowPlaying)
                    {
                        <div class="col">
                            <div class="card h-100 border-0 shadow-sm movie-card">
                                <div class="position-relative">
                                    <img src="@(string.IsNullOrEmpty(item.Movie.ImageUrl) ? "https://via.placeholder.com/300x450" : item.Movie.ImageUrl)" class="card-img-top" alt="@item.Movie.Title" style="height: 400px; object-fit: cover;">
                                    <span class="position-absolute top-0 end-0 badge bg-danger m-2 p-2 shadow">@item.Movie.AgeRating</span>
                                </div>
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title fw-bold text-truncate mb-1">@item.Movie.Title</h5>
                                    <div class="d-flex justify-content-between align-items-center mb-3 small">
                                        <span class="text-muted"><i class="bi bi-clock"></i> @item.Movie.DurationInMinutes mins</span>
                                        <span class="text-warning fw-bold"><i class="bi bi-star-fill"></i> @item.AverageRating.ToString("0.0")</span>
                                    </div>
                                    <span class="badge bg-light text-dark border mb-3 w-50">@item.Movie.MovieCategory</span>

                                    <a asp-action="Details" asp-route-id="@item.Movie.Id" class="btn btn-primary mt-auto w-100 rounded-pill fw-bold">Get Tickets</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* ==========================================
           ZONE 4: SECONDARY FEED (COMING SOON)
           ========================================== *@
        @if (Model.ComingSoon != null && Model.ComingSoon.Any() && !Model.SelectedDate.HasValue)
        {
            <div class="mb-5 mt-5 pt-4">
                <h3 class="fw-bold border-bottom pb-2 mb-4 text-uppercase text-muted">Coming Soon <i class="bi bi-calendar-star text-warning"></i></h3>
                <div class="row row-cols-1 row-cols-md-4 g-4 opacity-75">
                    @foreach (var item in Model.ComingSoon)
                    {
                        <div class="col">
                            <div class="card h-100 border-0 shadow-sm bg-light">
                                <img src="@(string.IsNullOrEmpty(item.Movie.ImageUrl) ? "https://via.placeholder.com/300x450" : item.Movie.ImageUrl)" class="card-img-top" alt="@item.Movie.Title" style="height: 300px; object-fit: cover; filter: grayscale(40%);">
                                <div class="card-body text-center">
                                    <h6 class="fw-bold text-truncate">@item.Movie.Title</h6>
                                    <p class="text-muted small mb-0 fw-bold text-primary">Releases: @item.Movie.StartDate.ToString("MMM dd, yyyy")</p>
                                    <a asp-action="Details" asp-route-id="@item.Movie.Id" class="btn btn-sm btn-outline-secondary mt-2 w-100">View Details</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@* ==========================================
   OBJECTIVE FIX: AI CHAT WIDGET
   ========================================== *@
<button id="aiChatToggle" class="btn btn-primary rounded-circle shadow-lg d-flex justify-content-center align-items-center" style="position: fixed; bottom: 30px; right: 30px; width: 65px; height: 65px; z-index: 1050;">
    <i class="bi bi-robot fs-3"></i>
</button>

<div id="aiChatWindow" class="card shadow-lg border-0" style="position: fixed; bottom: 110px; right: 30px; width: 350px; display: none; z-index: 1050; border-radius: 15px; overflow: hidden;">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center p-3 border-0">
        <h6 class="mb-0 fw-bold"><i class="bi bi-robot me-2"></i> Cinema AI Assistant</h6>
        <button type="button" class="btn-close btn-close-white" id="aiChatClose" aria-label="Close"></button>
    </div>
    
    <div class="card-body bg-light p-3" id="aiChatBody" style="height: 350px; overflow-y: auto;">
        <div class="d-flex mb-3">
            <div class="bg-primary text-white p-2 rounded-3" style="max-width: 85%; font-size: 0.9rem;">
                Hi! I'm your AI assistant. Tell me what kind of movie you're looking for, and I'll give you a recommendation!
            </div>
        </div>
        </div>
    
    <div class="card-footer bg-white p-2 border-top">
        <div class="input-group">
            <input type="text" id="aiChatInput" class="form-control border-0 bg-light" placeholder="Ask for a movie..." autocomplete="off" />
            <button class="btn btn-primary rounded-circle ms-2" id="aiChatSend" style="width: 40px; height: 40px; display: flex; justify-content: center; align-items: center;">
                <i class="bi bi-send-fill"></i>
            </button>
        </div>
    </div>
</div>

<style>
    /* Smooth hover effect for the movie cards */
    .movie-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s;
    }
    .movie-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 1rem 3rem rgba(0,0,0,.175) !important;
    }
    
    /* AI Chat Scrollbar styling */
    #aiChatBody::-webkit-scrollbar {
        width: 6px;
    }
    #aiChatBody::-webkit-scrollbar-track {
        background: #f1f1f1; 
    }
    #aiChatBody::-webkit-scrollbar-thumb {
        background: #c1c1c1; 
        border-radius: 10px;
    }
    
    /* Animation for the chat opening */
    #aiChatWindow {
        animation: slideUp 0.3s ease-out;
    }
    
    @@keyframes slideUp {
        from { transform: translateY(20px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }
</style>

@section Scripts {
    <script>
        // 1. Existing form auto-submit logic
        document.querySelector('select[name="category"]').addEventListener('change', function() {
            this.form.submit();
        });

        // 2. AI Chat Logic
        const chatToggleBtn = document.getElementById('aiChatToggle');
        const chatWindow = document.getElementById('aiChatWindow');
        const chatCloseBtn = document.getElementById('aiChatClose');
        const chatBody = document.getElementById('aiChatBody');
        const chatInput = document.getElementById('aiChatInput');
        const chatSendBtn = document.getElementById('aiChatSend');

        // Toggle visibility
        chatToggleBtn.addEventListener('click', () => {
            chatWindow.style.display = chatWindow.style.display === 'none' || chatWindow.style.display === '' ? 'block' : 'none';
            if(chatWindow.style.display === 'block') chatInput.focus();
        });

        chatCloseBtn.addEventListener('click', () => {
            chatWindow.style.display = 'none';
        });

        // Send message on Enter key or Button click
        chatInput.addEventListener('keypress', function (e) {
            if (e.key === 'Enter') {
                sendMessage();
            }
        });
        chatSendBtn.addEventListener('click', sendMessage);

        function sendMessage() {
            const text = chatInput.value.trim();
            if (!text) return;

            // Append User Message to UI
            appendMessage(text, 'user');
            chatInput.value = '';

            // Show 'typing' indicator
            const typingId = 'typing-' + Date.now();
            appendTypingIndicator(typingId);

            // AJAX call to Backend (Ollama)
            // Notă: Folosim JSON.stringify(text) pentru a trimite un string brut acceptat de [FromBody] string în C#
            fetch('/Home/AskAI', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(text)
            })
            .then(response => {
                if(!response.ok) throw new Error("Network response was not ok");
                return response.json();
            })
            .then(data => {
                removeElement(typingId);
                appendMessage(data.response, 'ai');
            })
            .catch(error => {
                removeElement(typingId);
                appendMessage("I'm having trouble connecting to my AI core right now.", 'ai');
                console.error('Error:', error);
            });
        }

        // Helper funcție: Adaugă mesajele vizual pe ecran
        function appendMessage(text, sender) {
            const msgDiv = document.createElement('div');
            msgDiv.classList.add('d-flex', 'mb-3');
            
            if (sender === 'user') {
                msgDiv.classList.add('justify-content-end');
                msgDiv.innerHTML = `
                    <div class="bg-dark text-white p-2 rounded-3 shadow-sm" style="max-width: 85%; font-size: 0.9rem;">
                        ${escapeHTML(text)}
                    </div>
                `;
            } else {
                msgDiv.innerHTML = `
                    <div class="bg-primary text-white p-2 rounded-3 shadow-sm" style="max-width: 85%; font-size: 0.9rem;">
                        ${escapeHTML(text)}
                    </div>
                `;
            }
            
            chatBody.appendChild(msgDiv);
            chatBody.scrollTop = chatBody.scrollHeight; // Auto-scroll la final
        }

        // Helper funcție: Indicator de tastare
        function appendTypingIndicator(id) {
            const msgDiv = document.createElement('div');
            msgDiv.classList.add('d-flex', 'mb-3');
            msgDiv.id = id;
            msgDiv.innerHTML = `
                <div class="bg-primary text-white p-2 rounded-3 opacity-75" style="font-size: 0.9rem;">
                    <span class="spinner-grow spinner-grow-sm" role="status" aria-hidden="true"></span> Thinking...
                </div>
            `;
            chatBody.appendChild(msgDiv);
            chatBody.scrollTop = chatBody.scrollHeight;
        }

        function removeElement(id) {
            const el = document.getElementById(id);
            if(el) el.remove();
        }

        // Evită XSS (Cross-Site Scripting)
        function escapeHTML(str) {
            return str.replace(/[&<>'"]/g, 
                tag => ({
                    '&': '&amp;',
                    '<': '&lt;',
                    '>': '&gt;',
                    "'": '&#39;',
                    '"': '&quot;'
                }[tag])
            );
        }
    </script>
}