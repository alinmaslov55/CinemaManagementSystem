@model CinemaSystem.Models.ViewModels.HomeVM
@using CinemaSystem.Models.Data.Enums

@{
    ViewData["Title"] = "Home Page";
    Layout = "_Layout"; 
}

<style>
    /* Gradient personalizat folosind culorile din paleta Ethereal */
    .cta-gradient { background: linear-gradient(135deg, #7f6fa2 0%, #976987 100%); }
    .hero-gradient { background: linear-gradient(180deg, rgba(249,249,249,0) 0%, rgba(249,249,249,1) 95%); }
    .glass-panel {
        background: rgba(255, 255, 255, 0.75);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
    }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<div class="bg-[#f9f9f9] font-['Inter'] text-[#1a1c1c] antialiased w-full">

    @* ==========================================
       ZONE 1: THE HERO SECTION
       ========================================== *@
    @if (Model.HeroMovies != null && Model.HeroMovies.Any())
    {
        var hero = Model.HeroMovies.First(); 
        <section class="relative w-full h-[85vh] lg:h-[920px] overflow-hidden">
            
            @if (!string.IsNullOrEmpty(hero.Movie.ImageUrl))
            {
                <img alt="@hero.Movie.Title" class="w-full h-full object-cover" src="@hero.Movie.ImageUrl" />
            }
            else
            {
                <div class="w-full h-full bg-[#645485]/10 flex items-center justify-center">
                    <span class="material-symbols-outlined text-[120px] text-[#645485]/30">movie</span>
                </div>
            }
            
            <div class="absolute inset-0 bg-black/40"></div>
            <div class="absolute inset-0 hero-gradient"></div>
            
            <div class="absolute bottom-24 md:bottom-32 left-6 md:left-24 max-w-2xl z-10">
                <span class="inline-block bg-[#ffd8e6] text-[#613b4c] px-3 py-1 rounded-full text-[10px] font-bold tracking-widest uppercase mb-4 shadow-sm">
                    Featured Premiere • Rating: @hero.AverageRating.ToString("0.0")
                </span>
                <h1 class="text-5xl md:text-8xl font-['Manrope'] font-extrabold text-white tracking-tighter mb-6 leading-none uppercase">
                    @hero.Movie.Title
                </h1>
                <p class="text-white/80 font-['Inter'] text-base md:text-lg mb-8 max-w-lg leading-relaxed line-clamp-3">
                    @hero.Movie.Description
                </p>
                <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
                    <a asp-controller="Movie" asp-action="Details" asp-route-id="@hero.Movie.Id" class="w-full sm:w-auto justify-center cta-gradient text-white px-10 py-4 rounded-xl font-['Manrope'] uppercase tracking-widest text-xs font-black shadow-2xl shadow-[#7f6fa2]/40 flex items-center gap-3 active:scale-95 transition-transform">
                        <span class="material-symbols-outlined" data-icon="confirmation_number">confirmation_number</span>
                        Secure Tickets
                    </a>
                    <a href="@hero.Movie.TrailerUrl" target="_blank" class="w-full sm:w-auto justify-center glass-panel text-[#1a1c1c] px-8 py-4 rounded-xl font-['Manrope'] uppercase tracking-widest text-xs font-black flex items-center gap-3 border border-white/30 hover:bg-white/90 transition-colors active:scale-95">
                        <span class="material-symbols-outlined" data-icon="play_circle">play_circle</span>
                        Trailer
                    </a>
                </div>
            </div>
        </section>
    }

    <main class="max-w-[1440px] mx-auto">

        @* ==========================================
           ZONE 2: THE UTILITY BAR (SEARCH & FILTER)
           ========================================== *@
        @{ 
            // Fix Arhitectural: Margine negativă doar dacă Hero există, altfel adăugăm padding normal.
            var searchMarginClass = (Model.HeroMovies != null && Model.HeroMovies.Any()) ? "-mt-20" : "pt-8 md:pt-12"; 
        }
        
        <div class="px-6 md:px-24 relative z-20 @searchMarginClass">
            <form method="get" asp-action="Index" class="glass-panel p-6 rounded-3xl shadow-lg border border-[#7a757f]/20 bg-white/80">
                <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-6">
                    <div class="md:col-span-4">
                        <label class="block text-[10px] font-bold text-[#79767b] uppercase tracking-widest mb-2">Search Title</label>
                        <div class="flex items-center bg-white/60 border border-[#cbc4cf]/50 rounded-xl px-4 py-2.5 focus-within:ring-2 ring-[#7f6fa2] transition-all">
                            <span class="material-symbols-outlined text-[#7f6fa2] text-sm mr-2" data-icon="search">search</span>
                            <input type="text" name="searchString" class="bg-transparent border-none w-full focus:outline-none text-sm font-['Inter']" placeholder="e.g. Inception..." value="@Model.CurrentSearch" />
                        </div>
                    </div>

                    <div class="md:col-span-3">
                        <label class="block text-[10px] font-bold text-[#79767b] uppercase tracking-widest mb-2">Genre</label>
                        <select name="category" asp-items="Html.GetEnumSelectList<MovieCategory>()" class="w-full bg-white/60 border border-[#cbc4cf]/50 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 ring-[#7f6fa2] text-sm font-['Inter'] cursor-pointer">
                            <option value="">All Genres</option>
                        </select>
                    </div>

                    <div class="md:col-span-3">
                        <label class="block text-[10px] font-bold text-[#79767b] uppercase tracking-widest mb-2">Date</label>
                        <input type="date" name="selectedDate" class="w-full bg-white/60 border border-[#cbc4cf]/50 rounded-xl px-4 py-2.5 focus:outline-none focus:ring-2 ring-[#7f6fa2] text-sm font-['Inter'] text-[#1a1c1c]" value="@Model.SelectedDate?.ToString("yyyy-MM-dd")" />
                    </div>

                    <div class="md:col-span-2 flex items-end gap-2 mt-2 md:mt-0">
                        <button type="submit" class="w-full bg-[#7f6fa2] hover:bg-[#976987] text-white py-3 rounded-xl text-xs font-bold uppercase tracking-widest transition-colors shadow-md">Filter</button>
                        <a asp-action="Index" class="bg-[#f3f3f3] hover:bg-[#e2e2e2] text-[#79767b] py-3 px-4 rounded-xl transition-colors flex items-center justify-center shadow-sm">
                            <span class="material-symbols-outlined text-[18px]">refresh</span>
                        </a>
                    </div>
                </div>
            </form>
        </div>

        @* ==========================================
           ZONE 3: PRIMARY FEED (NOW SHOWING BENTO GRID)
           ========================================== *@
        <section class="py-16 md:py-24 px-6 md:px-24">
            <div class="flex justify-between items-end mb-8 md:mb-12">
                <div>
                    <h2 class="text-3xl md:text-4xl font-['Manrope'] font-extrabold tracking-tight text-[#7f6fa2]">Now Showing</h2>
                    <p class="text-[#79767b] mt-2 font-['Inter']">Curated selection of global cinema</p>
                </div>
            </div>

            @if (!Model.NowPlaying.Any())
            {
                <div class="bg-white rounded-3xl p-16 text-center text-[#79767b] font-['Inter'] border border-[#cbc4cf]/30 shadow-sm flex flex-col items-center">
                    <span class="material-symbols-outlined text-6xl opacity-30 mb-4">movie_off</span>
                    <p class="font-bold text-lg">No screenings found</p>
                    <p class="text-sm mt-1">Try adjusting your search or date filters.</p>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 md:grid-cols-4 gap-6 md:gap-8">
                    @{
                        // Fix Arhitectural: Limităm rezultatele pentru a menține estetica și performanța UI-ului
                        var displayMovies = Model.NowPlaying.Take(9).ToList();
                        var firstMovie = displayMovies.First();
                        var restMovies = displayMovies.Skip(1);
                    }

                    <div class="md:col-span-2 relative group overflow-hidden rounded-[2rem] bg-[#f3f3f3] shadow-sm">
                        <div class="aspect-[16/9] w-full overflow-hidden flex items-center justify-center bg-[#eaddff]/30">
                            @if (!string.IsNullOrEmpty(firstMovie.Movie.ImageUrl))
                            {
                                <img alt="@firstMovie.Movie.Title" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" src="@firstMovie.Movie.ImageUrl" />
                            }
                            else
                            {
                                <span class="material-symbols-outlined text-6xl text-[#645485]/30">movie</span>
                            }
                        </div>
                        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent opacity-90"></div>
                        <div class="absolute bottom-0 left-0 p-6 md:p-8 w-full flex justify-between items-end">
                            <div>
                                <div class="flex gap-2 mb-2">
                                    <span class="text-[10px] bg-[#7f6fa2] text-white px-2 py-0.5 rounded uppercase font-bold tracking-widest shadow-sm">@firstMovie.Movie.AgeRating</span>
                                    <span class="text-[10px] bg-white/20 text-white backdrop-blur px-2 py-0.5 rounded uppercase font-bold tracking-widest shadow-sm">@firstMovie.Movie.MovieCategory</span>
                                </div>
                                <h3 class="text-2xl md:text-3xl font-['Manrope'] font-bold text-white tracking-tight">@firstMovie.Movie.Title</h3>
                                <p class="text-white/70 text-sm font-['Inter'] mt-1 flex items-center gap-1">
                                    <span class="material-symbols-outlined text-[14px]">schedule</span> @firstMovie.Movie.DurationInMinutes min
                                </p>
                            </div>
                            <a asp-controller="Movie" asp-action="Details" asp-route-id="@firstMovie.Movie.Id" class="bg-white text-[#1a1c1c] p-4 rounded-full shadow-xl active:scale-90 transition-transform hover:bg-[#f3f3f3]">
                                <span class="material-symbols-outlined" data-icon="confirmation_number">confirmation_number</span>
                            </a>
                        </div>
                    </div>

                    @foreach (var item in restMovies)
                    {
                        <div class="group flex flex-col">
                            <div class="aspect-[2/3] rounded-2xl overflow-hidden mb-4 relative shadow-sm border border-[#cbc4cf]/30 bg-[#eaddff]/20 flex justify-center items-center">
                                @if (!string.IsNullOrEmpty(item.Movie.ImageUrl))
                                {
                                    <img alt="@item.Movie.Title" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="@item.Movie.ImageUrl" />
                                }
                                else
                                {
                                    <span class="material-symbols-outlined text-4xl text-[#645485]/30">theaters</span>
                                }
                                
                                <div class="absolute top-4 right-4 bg-[#ffd8e6] text-[#613b4c] font-bold text-[10px] px-2 py-1 rounded shadow-sm">
                                    @item.AverageRating.ToString("0.0")
                                </div>
                                <div class="absolute top-4 left-4 bg-black/50 backdrop-blur-md text-white font-bold text-[10px] px-2 py-1 rounded shadow-sm">
                                    @item.Movie.AgeRating
                                </div>
                            </div>
                            <h4 class="font-['Manrope'] font-bold text-lg text-[#1a1c1c] truncate">@item.Movie.Title</h4>
                            <p class="text-[#79767b] text-[10px] md:text-xs uppercase tracking-widest font-bold mt-1">@item.Movie.MovieCategory • @item.Movie.DurationInMinutes min</p>
                            <a asp-controller="Movie" asp-action="Details" asp-route-id="@item.Movie.Id" class="mt-4 w-full border border-[#7f6fa2]/30 hover:bg-[#7f6fa2] hover:text-white text-[#7f6fa2] text-center py-2.5 rounded-xl text-xs font-bold uppercase tracking-widest transition-colors">
                                Quick Book
                            </a>
                        </div>
                    }
                </div>
            }
        </section>

        @* ==========================================
           ZONE 4: OFFERS / VIP SECTION (Context-Aware)
           ========================================== *@
        <section class="py-12 md:py-16 bg-[#f3f3f3] px-6 md:px-24 rounded-[3rem] mx-4 md:mx-12 mb-16 md:mb-24 shadow-sm border border-[#cbc4cf]/20">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-12">
                
                <div class="relative rounded-3xl overflow-hidden h-[300px] md:h-[400px] flex items-center p-8 md:p-12 group">
                    <img alt="VIP Cinema" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-1000" 
                         src="https://images.unsplash.com/photo-1517604931442-7e0c8ed2963c?q=80&w=2070&auto=format&fit=crop" />
                    <div class="absolute inset-0 bg-[#7f6fa2]/50 backdrop-blur-[2px]"></div>
                    <div class="relative z-10 max-w-sm">
                        <h3 class="text-3xl md:text-4xl font-['Manrope'] font-extrabold text-white mb-4 tracking-tight">The Velvet Experience</h3>
                        <p class="text-white/90 mb-8 font-['Inter'] text-sm md:text-base">Elevate your cinema journey with dine-in service and premium leather loungers.</p>
                        
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <a href="#now-showing" class="inline-block bg-white text-[#7f6fa2] px-8 py-3 rounded-xl font-['Manrope'] text-xs font-bold uppercase tracking-widest shadow-xl hover:-translate-y-1 transition-transform">Book VIP Now</a>
                        }
                        else
                        {
                            <a href="/Identity/Account/Login" class="inline-block bg-white text-[#7f6fa2] px-8 py-3 rounded-xl font-['Manrope'] text-xs font-bold uppercase tracking-widest shadow-xl hover:-translate-y-1 transition-transform">Explore VIP</a>
                        }
                    </div>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="bg-white p-6 md:p-8 rounded-3xl shadow-sm flex flex-col justify-between border border-[#cbc4cf]/30 hover:shadow-md transition-shadow">
                        <div>
                            <span class="material-symbols-outlined text-[#976987] text-4xl mb-4" data-icon="redeem">redeem</span>
                            <h4 class="text-xl font-['Manrope'] font-bold text-[#1a1c1c] mb-2">Member Rewards</h4>
                            <p class="text-sm text-[#79767b] leading-relaxed">Earn points for every ticket and treat yourself to complimentary perks.</p>
                        </div>
                        
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <a class="text-[#7f6fa2] font-['Manrope'] text-xs font-bold uppercase tracking-widest mt-6 inline-flex items-center gap-2 hover:opacity-70 transition-opacity" href="/Customer/Dashboard">
                                View My Dashboard <span class="material-symbols-outlined text-sm">arrow_forward</span>
                            </a>
                        }
                        else
                        {
                            <a class="text-[#7f6fa2] font-['Manrope'] text-xs font-bold uppercase tracking-widest mt-6 inline-flex items-center gap-2 hover:opacity-70 transition-opacity" href="/Identity/Account/Register">
                                Join Now <span class="material-symbols-outlined text-sm">person_add</span>
                            </a>
                        }
                    </div>
                    
                    <div class="bg-white p-6 md:p-8 rounded-3xl shadow-sm flex flex-col justify-between border border-[#cbc4cf]/30 hover:shadow-md transition-shadow">
                        <div>
                            <span class="material-symbols-outlined text-[#976987] text-4xl mb-4" data-icon="local_activity">local_activity</span>
                            <h4 class="text-xl font-['Manrope'] font-bold text-[#1a1c1c] mb-2">Student Passes</h4>
                            <p class="text-sm text-[#79767b] leading-relaxed">Weekly discounts for valid student ID holders. Cinema for everyone.</p>
                        </div>
                        <a class="text-[#7f6fa2] font-['Manrope'] text-xs font-bold uppercase tracking-widest mt-6 inline-flex items-center gap-2 hover:opacity-70 transition-opacity" href="#">
                            Learn More <span class="material-symbols-outlined text-sm">info</span>
                        </a>
                    </div>
                </div>
            </div>
        </section>

        @* ==========================================
           ZONE 5: COMING SOON
           ========================================== *@
        @if (Model.ComingSoon != null && Model.ComingSoon.Any() && !Model.SelectedDate.HasValue)
        {
            <section class="py-8 md:py-12 px-6 md:px-24 mb-24">
                <h2 class="text-2xl md:text-3xl font-['Manrope'] font-extrabold tracking-tight text-[#7f6fa2] mb-8 md:mb-12">Coming Soon</h2>
                <div class="flex overflow-x-auto gap-6 md:gap-8 pb-8 no-scrollbar">
                    @foreach (var item in Model.ComingSoon)
                    {
                        <div class="min-w-[160px] md:min-w-[200px] flex-shrink-0 group cursor-pointer" onclick="window.location.href='/Movie/Details/@item.Movie.Id'">
                            <div class="aspect-[2/3] rounded-2xl overflow-hidden mb-4 relative shadow-sm border border-[#cbc4cf]/30 bg-[#eaddff]/20 flex items-center justify-center">
                                @if (!string.IsNullOrEmpty(item.Movie.ImageUrl))
                                {
                                    <img alt="@item.Movie.Title" class="absolute inset-0 w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500" src="@item.Movie.ImageUrl" />
                                }
                                else
                                {
                                    <span class="material-symbols-outlined text-4xl text-[#645485]/30">upcoming</span>
                                }
                                <div class="absolute inset-0 bg-black/20 group-hover:bg-transparent transition-colors"></div>
                                <div class="absolute bottom-4 left-4 bg-white/95 backdrop-blur px-3 py-1 rounded text-[10px] font-bold text-[#7f6fa2] uppercase shadow-sm">
                                    @item.Movie.StartDate.ToString("MMM dd")
                                </div>
                            </div>
                            <h4 class="font-['Manrope'] font-bold text-sm text-[#1a1c1c] truncate group-hover:text-[#7f6fa2] transition-colors">@item.Movie.Title</h4>
                            <p class="text-[#79767b] text-[10px] uppercase tracking-widest font-bold mt-1">@item.Movie.MovieCategory</p>
                        </div>
                    }
                </div>
            </section>
        }
    </main>
</div>

@* ==========================================
   ZONE 6: THE AI ASSISTANT WIDGET
   ========================================== *@

<button id="aiChatToggle" class="fixed bottom-24 md:bottom-8 right-6 w-14 h-14 md:w-16 md:h-16 bg-[#7f6fa2] hover:bg-[#976987] text-white rounded-full shadow-2xl flex justify-center items-center transition-colors z-[1050]">
    <span class="material-symbols-outlined text-2xl md:text-3xl" data-icon="smart_toy">smart_toy</span>
</button>

<div id="aiChatWindow" class="fixed bottom-40 md:bottom-28 right-4 md:right-6 w-[calc(100vw-2rem)] md:w-[360px] hidden flex-col bg-[#f9f9f9] shadow-2xl border border-[#cbc4cf]/50 rounded-2xl z-[1050] overflow-hidden">
    
    <div class="cta-gradient text-white flex justify-between items-center p-4 border-b border-white/10">
        <h6 class="mb-0 font-['Manrope'] font-bold text-sm flex items-center gap-2">
            <span class="material-symbols-outlined text-lg" data-icon="auto_awesome">auto_awesome</span> 
            Ethereal Concierge
        </h6>
        <button type="button" id="aiChatClose" class="text-white/70 hover:text-white transition-colors">
            <span class="material-symbols-outlined text-xl" data-icon="close">close</span>
        </button>
    </div>
    
    <div class="p-4" id="aiChatBody" style="height: 380px; overflow-y: auto;">
        <div class="flex mb-4">
            <div class="bg-[#e8e8e8] text-[#1a1c1c] px-4 py-3 rounded-2xl rounded-tl-sm shadow-sm" style="max-width: 85%; font-size: 0.85rem; font-family: 'Inter', sans-serif;">
                Greetings! I am the Ethereal Concierge. How may I guide your cinematic journey today?
            </div>
        </div>
    </div>
    
    <div class="bg-white p-3 border-t border-[#cbc4cf]/30">
        <div class="flex gap-2">
            <input type="text" id="aiChatInput" class="w-full bg-[#f3f3f3] border-none rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-[#7f6fa2]/50 text-sm font-['Inter'] outline-none" placeholder="Ask for recommendations..." autocomplete="off" />
            <button id="aiChatSend" class="bg-[#7f6fa2] hover:bg-[#976987] text-white rounded-xl w-12 h-11 flex items-center justify-center transition-colors shadow-sm shrink-0">
                <span class="material-symbols-outlined text-sm" data-icon="send">send</span>
            </button>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        const chatToggleBtn = document.getElementById('aiChatToggle');
        const chatWindow = document.getElementById('aiChatWindow');
        const chatCloseBtn = document.getElementById('aiChatClose');
        const chatBody = document.getElementById('aiChatBody');
        const chatInput = document.getElementById('aiChatInput');
        const chatSendBtn = document.getElementById('aiChatSend');

        // Fetch the anti-forgery token for safe POST requests
        const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');
        const token = tokenElement ? tokenElement.value : '';

        chatToggleBtn.addEventListener('click', () => {
            if(chatWindow.classList.contains('hidden')){
                chatWindow.classList.remove('hidden');
                chatWindow.classList.add('flex');
                chatInput.focus();
            } else {
                chatWindow.classList.add('hidden');
                chatWindow.classList.remove('flex');
            }
        });

        chatCloseBtn.addEventListener('click', () => { 
            chatWindow.classList.add('hidden');
            chatWindow.classList.remove('flex');
        });

        chatInput.addEventListener('keypress', function (e) {
            if (e.key === 'Enter') sendMessage();
        });
        chatSendBtn.addEventListener('click', sendMessage);

        function sendMessage() {
            const text = chatInput.value.trim();
            if (!text) return;

            appendMessage(text, 'user');
            chatInput.value = '';

            const typingId = 'typing-' + Date.now();
            appendTypingIndicator(typingId);

            fetch('/Home/AskAI', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(text)
            })
            .then(response => {
                if(!response.ok) throw new Error("Network error");
                return response.json();
            })
            .then(data => {
                removeElement(typingId);
                appendMessage(data.response, 'ai');
            })
            .catch(error => {
                removeElement(typingId);
                appendMessage("I'm currently disconnected from the core. Please try again later.", 'ai');
                console.error('Error:', error);
            });
        }

        function appendMessage(text, sender) {
            const msgDiv = document.createElement('div');
            msgDiv.classList.add('flex', 'mb-4');
            
            if (sender === 'user') {
                msgDiv.classList.add('justify-end');
                msgDiv.innerHTML = `
                    <div class="bg-[#7f6fa2] text-white px-4 py-3 rounded-2xl rounded-tr-sm shadow-md" style="max-width: 85%; font-size: 0.85rem; font-family: 'Inter', sans-serif;">
                        ${escapeHTML(text)}
                    </div>
                `;
            } else {
                msgDiv.innerHTML = `
                    <div class="bg-[#e8e8e8] text-[#1a1c1c] px-4 py-3 rounded-2xl rounded-tl-sm shadow-sm" style="max-width: 85%; font-size: 0.85rem; font-family: 'Inter', sans-serif;">
                        ${escapeHTML(text)}
                    </div>
                `;
            }
            
            chatBody.appendChild(msgDiv);
            chatBody.scrollTop = chatBody.scrollHeight;
        }

        function appendTypingIndicator(id) {
            const msgDiv = document.createElement('div');
            msgDiv.classList.add('flex', 'mb-4');
            msgDiv.id = id;
            msgDiv.innerHTML = `
                <div class="bg-[#e8e8e8] text-[#79767b] px-4 py-3 rounded-2xl rounded-tl-sm flex items-center gap-2" style="font-size: 0.85rem;">
                    <span class="flex gap-1">
                        <span class="w-1.5 h-1.5 bg-[#7c738a] rounded-full animate-bounce"></span>
                        <span class="w-1.5 h-1.5 bg-[#7c738a] rounded-full animate-bounce" style="animation-delay: 0.2s"></span>
                        <span class="w-1.5 h-1.5 bg-[#7c738a] rounded-full animate-bounce" style="animation-delay: 0.4s"></span>
                    </span>
                </div>
            `;
            chatBody.appendChild(msgDiv);
            chatBody.scrollTop = chatBody.scrollHeight;
        }

        function removeElement(id) {
            const el = document.getElementById(id);
            if(el) el.remove();
        }

        function escapeHTML(str) {
            return str.replace(/[&<>'"]/g, tag => ({
                '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;'
            }[tag]));
        }
    </script>
}