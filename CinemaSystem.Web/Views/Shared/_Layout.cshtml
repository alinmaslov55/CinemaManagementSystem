@using Microsoft.Extensions.Localization
@using CinemaSystem.Utility
@inject IStringLocalizer<SharedResource> Localizer
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    var isHeroPage = (controller == "Home" && action == "Index") ||
                         (controller == "Home" && action == "Details");
}

<!DOCTYPE html>
<html lang="@System.Threading.Thread.CurrentThread.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CinemaSystem</title>

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200;300;400;500;600;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <script>
        tailwind.config = {
        theme: {
        extend: {
        colors: {
        "primary": "#7f6fa2",
        "secondary": "#7c738a",
        "tertiary": "#976987",
        "neutral": "#79767b",
        "surface": "#f9f9f9",
        "surface-container-low": "#f3f3f3",
        "surface-container-high": "#e8e8e8",
        "on-background": "#1a1c1c",
        "outline": "#7a757f"
        },
        fontFamily: {
        "headline": ["Manrope", "sans-serif"],
        "body": ["Inter", "sans-serif"]
        }
        }
        }
        }
    </script>

    <style>
        .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        .cta-gradient {
        background: linear-gradient(135deg, #7f6fa2 0%, #976987 100%);
        }
    </style>
</head>
<body class="bg-surface font-body text-on-background antialiased flex flex-col min-h-screen">

    <nav class="fixed top-0 w-full z-50 @(isHeroPage ? "bg-white/80" : "bg-white") backdrop-blur-xl border-b border-outline/10">
        <div class="max-w-[1440px] mx-auto px-6 py-4 flex justify-between items-center">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="text-2xl font-light tracking-[0.3em] text-primary font-headline hover:opacity-80 transition-opacity">
                CinemaSystem
            </a>

            @if (User.IsInRole(SD.Role_Admin))
            {
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="text-xs font-bold uppercase tracking-widest text-tertiary hover:text-primary transition-colors">@Localizer["Layout_ManagementPortal"]</a>
            }

            <div class="hidden md:flex items-center gap-6">
                <form id="selectLanguageDesktop" asp-area="" asp-controller="Language" asp-action="SetLanguage" method="post" class="m-0 flex items-center h-full border-r border-outline/20 pr-6 py-2">
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                    <div class="flex items-center group cursor-pointer">
                        <span class="material-symbols-outlined text-neutral text-[18px] group-hover:text-primary transition-colors">language</span>
                        <select name="culture" onchange="this.form.submit();" class="bg-transparent text-xs font-bold uppercase tracking-widest text-neutral group-hover:text-primary transition-colors border-none focus:ring-0 cursor-pointer py-0 pl-1 pr-6 m-0 shadow-none outline-none appearance-none bg-no-repeat" style="background-image: url('data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 20 20\' fill=\'%2379767b\'><path fill-rule=\'evenodd\' d=\'M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z\' clip-rule=\'evenodd\'/></svg>'); background-position: right 0.2rem center; background-size: 1.2em 1.2em;">
                            <!option value="en-US" @(System.Threading.Thread.CurrentThread.CurrentUICulture.Name == "en-US" ? "selected" : "")>EN</!option>
                            <!option value="ro-RO" @(System.Threading.Thread.CurrentThread.CurrentUICulture.Name == "ro-RO" ? "selected" : "")>RO</!option>
                        </select>
                    </div>
                </form>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-area="" asp-controller="Booking" asp-action="History" class="text-xs font-bold uppercase tracking-widest text-neutral hover:text-primary transition-colors flex items-center gap-1">
                        <span class="material-symbols-outlined text-sm">receipt_long</span> @Localizer["Layout_Tickets"]
                    </a>

                    <a asp-area="Identity" asp-page="/Account/Manage/Index" class="text-xs font-bold uppercase tracking-widest text-neutral hover:text-primary transition-colors flex items-center gap-1">
                        <span class="material-symbols-outlined text-sm">account_circle</span> @Localizer["Layout_Profile"]
                    </a>

                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post" class="m-0 p-0 ml-2">
                        <button type="submit" class="text-xs font-bold uppercase tracking-widest text-neutral hover:text-[#a8364b] transition-colors flex items-center gap-1">
                            <span class="material-symbols-outlined text-sm">logout</span> @Localizer["Layout_Logout"]
                        </button>
                    </form>
                }
                else
                {
                    <a asp-area="Identity" asp-page="/Account/Register" class="text-xs font-bold uppercase tracking-widest text-neutral hover:text-primary transition-colors">@Localizer["Layout_Register"]</a>
                    <a asp-area="Identity" asp-page="/Account/Login" class="cta-gradient text-white px-6 py-2.5 rounded-xl text-xs font-bold uppercase tracking-widest shadow-md hover:scale-105 transition-transform">@Localizer["Layout_Login"]</a>
                }
            </div>

            <button id="mobileMenuToggle" class="md:hidden text-primary focus:outline-none flex items-center justify-center p-2">
                <span class="material-symbols-outlined text-3xl">menu</span>
            </button>

        </div>

        <div id="mobileMenu" class="absolute top-20 left-0 w-full bg-white border-b border-outline/10 shadow-xl hidden flex-col px-6 py-6 space-y-6 md:hidden">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="text-sm font-bold uppercase tracking-widest text-on-background hover:text-primary block">@Localizer["Layout_Movies"]</a>

            @if (User.IsInRole(SD.Role_Admin))
            {
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="text-sm font-bold uppercase tracking-widest text-tertiary hover:text-primary block">@Localizer["Layout_ManagementPortal"]</a>
            }

            <form id="selectLanguageMobile" asp-area="" asp-controller="Language" asp-action="SetLanguage" method="post" class="m-0 p-0 flex items-center justify-between w-full">
                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                <span class="text-sm font-bold uppercase tracking-widest text-neutral flex items-center gap-2">
                    <span class="material-symbols-outlined text-[18px]">language</span> @Localizer["Layout_Language"]
                </span>
                <select name="culture" onchange="this.form.submit();" class="bg-surface-container-low text-xs font-bold uppercase tracking-widest text-on-background rounded-lg border-none focus:ring-2 focus:ring-primary cursor-pointer py-2 px-3">
                    <!option value="en-US" @(System.Threading.Thread.CurrentThread.CurrentUICulture.Name == "en-US" ? "selected" : "")>English (EN)</!option>
                    <!option value="ro-RO" @(System.Threading.Thread.CurrentThread.CurrentUICulture.Name == "ro-RO" ? "selected" : "")>Română (RO)</!option>
                </select>
            </form>
            <hr class="border-outline/10" />

            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-area="" asp-controller="Booking" asp-action="History" class="text-sm font-bold uppercase tracking-widest text-on-background hover:text-primary flex items-center gap-2">
                    <span class="material-symbols-outlined">receipt_long</span> @Localizer["Layout_MyTickets"]
                </a>

                <a asp-area="Identity" asp-page="/Account/Manage/Index" class="text-sm font-bold uppercase tracking-widest text-on-background hover:text-primary flex items-center gap-2">
                    <span class="material-symbols-outlined">account_circle</span> @Localizer["Layout_ManageProfile"]
                </a>

                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post" class="m-0 p-0 mt-4">
                    <button type="submit" class="text-sm font-bold uppercase tracking-widest text-white bg-[#a8364b] w-full py-3 rounded-xl flex items-center justify-center gap-2 hover:opacity-80 transition-opacity">
                        <span class="material-symbols-outlined">logout</span> @Localizer["Layout_Logout"]
                    </button>
                </form>
            }
            else
            {
                <a asp-area="Identity" asp-page="/Account/Register" class="text-sm font-bold uppercase tracking-widest text-on-background hover:text-primary block">@Localizer["Layout_Register"]</a>
                <a asp-area="Identity" asp-page="/Account/Login" class="cta-gradient text-white text-center px-6 py-4 rounded-xl text-sm font-bold uppercase tracking-widest shadow-md block">@Localizer["Layout_Login"]</a>
            }
        </div>
    </nav>

    <main class="flex-grow @(isHeroPage ? "" : "pt-32 px-6 max-w-[1440px] mx-auto w-full")">
        <partial name="_Notification" />
        @RenderBody()
    </main>

    <footer class="bg-surface-container-high border-t border-outline/10 py-12 mt-auto">
        <div class="max-w-[1440px] mx-auto px-6 flex flex-col md:flex-row justify-between items-center text-[10px] text-outline font-bold uppercase tracking-widest">
            <p>&copy; @DateTime.Now.Year CinemaSystem. @Localizer["Layout_AllRightsReserved"]</p>
            <div class="flex gap-8 mt-6 md:mt-0">
                <a href="https://github.com/alinmaslov55" target="_blank" class="hover:text-primary transition-colors">GitHub</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>

    <script>
        const btn = document.getElementById('mobileMenuToggle');
        const menu = document.getElementById('mobileMenu');
        const icon = btn.querySelector('span');

        btn.addEventListener('click', () => {
        menu.classList.toggle('hidden');
        menu.classList.toggle('flex');
        icon.innerText = menu.classList.contains('hidden') ? 'menu' : 'close';
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>